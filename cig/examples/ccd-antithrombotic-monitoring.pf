goal.verb=order
guideline_status=not_specified_as_a_guideline_monitoring_task
instrument=clinician examination
knowledge_origin=Mor Peleg\'s know-how of 4 Nov 2026 (a suspected ADE whose sources name no test alerts the clinician to examine further), applied to the label passages of Monitor_Antiplatelet_Hypersensitivity
literature_basis=the clopidogrel and prasugrel labels report hypersensitivity including rash, angioedema or hematologic reaction, and the labels name no laboratory or imaging test to confirm it
monitored_target=suspected antiplatelet hypersensitivity reaction recorded by Monitor_Antiplatelet_Hypersensitivity (hypersensitivity reactions to Prescribe_Aspirin, Prescribe_Clopidogrel, Prescribe_Prasugrel and Prescribe_Ticagrelor)
monitoring_frequency_basis=event-driven, each time Monitor_Antiplatelet_Hypersensitivity records a suspicion
monitoring_stance=symptom_triggered_only
provenance_type=assistant_completed_from_guidelines
quote.1=\\u00A75.5\\: "Hypersensitivity including rash, angioedema or hematologic reaction has been reported in patients receiving Plavix"
quote.2=\\u00A75.5\\: "Hypersensitivity including angioedema has been reported in patients receiving Effient, including patients with a history of hypersensitivity reaction to other thienopyridines"
role=ade_alert
source.1=PLAVIX (clopidogrel) US Prescribing Information 2025, \\u00A75.5
source.2=EFFIENT (prasugrel) US Prescribing Information 2022, \\u00A75.5
source_kind=package_insert
trigger=suspected_antiplatelet_hypersensitivity recorded as yes by Monitor_Antiplatelet_Hypersensitivity
' ;
     precondition ::(result_of(Antithrombotic_Regimen_Decision) = Aspirin_Monotherapy or result_of(Antithrombotic_Regimen_Decision) = Clopidogrel_Monotherapy or result_of(Antithrombotic_Regimen_Decision) = DAPT or result_of(Antithrombotic_Regimen_Decision) = Short_DAPT_then_P2Y12_Monotherapy or result_of(Antithrombotic_Regimen_Decision) = Extended_DAPT or result_of(Antithrombotic_Regimen_Decision) = Aspirin_plus_Vorapaxar or result_of(Antithrombotic_Regimen_Decision) = Aspirin_plus_Low_Dose_Rivaroxaban or result_of(Antithrombotic_Regimen_Decision) = DOAC_plus_Antiplatelet) and suspected_antiplatelet_hypersensitivity = "yes";
     procedure :: 'Further clinical examination for suspected antiplatelet hypersensitivity reaction, event-triggered, at the monitoring visit when an antiplatelet hypersensitivity reaction is suspected. Patient: attend the examination and report any hives, swelling of the face, lips or throat, wheezing or a widespread rash. Clinician: examine the patient for an antiplatelet hypersensitivity reaction and decide on further work-up, stopping the culprit drug and choosing an alternative antiplatelet if it is confirmed (the sources name no specific test, so none is ordered).' ;
end action.

enquiry  :: 'Monitor_Ticagrelor_Dyspnea' ;
     caption :: 'Monitor for dyspnea on ticagrelor' ;
     description :: 'Monitors dyspnea as a labeled adverse effect of Prescribe_Ticagrelor. The label says ticagrelor-related dyspnea needs no specific treatment and that intolerable dyspnea warrants switching antiplatelet agent. Order: dyspnea review on ticagrelor, symptom-triggered, with a breathlessness question at each follow-up visit. Patient: contact your clinician if you have unexpected shortness of breath, especially if it is severe. Clinician: if dyspnea is new, prolonged or worse, exclude other causes such as heart failure, continue ticagrelor without specific treatment when it is drug-related and tolerable, and switch to another antiplatelet agent if it is intolerable.' ;
     metaprops :: 'ServiceRequest.code=dyspnea review on ticagrelor
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=symptom-triggered, with a breathlessness question at each follow-up visit
ServiceRequest.patientInstruction=contact your clinician if you have unexpected shortness of breath, especially if it is severe
ServiceRequest.performerInstruction=if dyspnea is new, prolonged or worse, exclude other causes such as heart failure, continue ticagrelor without specific treatment when it is drug-related and tolerable, and switch to another antiplatelet agent if it is intolerable
applies_when=all_patients_on_therapy
assistant_invention=checking other causes such as heart failure
category=undesired_ade
cq=CQ3, CQ9
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= dyspnea review on ticagrelor; ServiceRequest.occurrenceTiming \\= symptom-triggered, with a breathlessness question at each follow-up visit; ServiceRequest.patientInstruction \\= contact your clinician if you have unexpected shortness of breath, especially if it is severe; ServiceRequest.performerInstruction \\= if dyspnea is new, prolonged or worse, exclude other causes such as heart failure, continue ticagrelor without specific treatment when it is drug-related and tolerable, and switch to another antiplatelet agent if it is intolerable
goal.verb=order
guideline_status=not_specified_as_a_guideline_monitoring_task
instrument=patient symptom report
knowledge_origin=ticagrelor \\u00A75.3
literature_basis=the label says ticagrelor-related dyspnea needs no specific treatment and that intolerable dyspnea warrants switching antiplatelet agent
monitored_target=dyspnea as a labeled adverse effect of Prescribe_Ticagrelor
monitoring_frequency_basis=symptom-triggered, as the label describes
monitoring_stance=symptom_triggered_only
provenance_type=package_insert_specified
quote.1=\\u00A75.3\\: "If a patient develops new, prolonged, or worsened dyspnea that is determined to be related to BRILINTA, no specific treatment is required"
quote.2=\\u00A75.3\\: "In the case of intolerable dyspnea requiring discontinuation of BRILINTA, consider prescribing another antiplatelet agent."
