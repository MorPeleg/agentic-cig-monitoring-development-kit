end enquiry.

action  :: 'Order_Serum_Digoxin' ;
     caption :: 'Order serum digoxin level' ;
     description :: 'Orders a serum digoxin level for Monitor_Drug_Interactions: the ticagrelor label asks to monitor digoxin levels when ticagrelor is started or changed in a patient on digoxin.' ;
     metaprops :: 'goal.noun_phrase=serum digoxin level
goal.verb=order
ordered_for=Monitor_Drug_Interactions
quote.1=\\u00A77.5\\: "monitor digoxin levels with initiation of or change in BRILINTA therapy"
role=test_order
source.1=BRILINTA (ticagrelor) US Prescribing Information 2026, \\u00A77.5 Digoxin
' ;
     precondition ::on_digoxin = "yes" and result_of(P2Y12_Agent_Decision) = Ticagrelor;
     procedure :: 'Order serum digoxin level when the patient takes digoxin and ticagrelor is the chosen P2Y12 inhibitor (at initiation of or change in ticagrelor therapy).' ;
end action.

enquiry  :: 'Monitor_Spinal_Epidural_Hematoma' ;
     caption :: 'Monitor for spinal or epidural hematoma around neuraxial procedures' ;
     description :: 'Monitors spinal or epidural hematoma as a boxed-warning adverse effect of Prescribe_DOAC and Prescribe_Low_Dose_Rivaroxaban. Every DOAC label carries a Boxed Warning that epidural or spinal hematoma can follow neuraxial anesthesia or spinal puncture and instructs frequent neurological monitoring with urgent treatment, with drug-specific catheter timing. Order: neurological checks for spinal or epidural hematoma around neuraxial anesthesia or spinal puncture, event-triggered, frequent neurological checks whenever neuraxial anesthesia or spinal puncture is performed during anticoagulant therapy. Patient: tell the anesthetist that you take an anticoagulant, and report back pain, tingling, numbness or weakness of the legs, or bowel or bladder problems immediately after an epidural or spinal procedure. Clinician: time epidural catheter removal and the next anticoagulant dose per the drug label (for apixaban remove the catheter no earlier than 24 hours after the last dose and give the next dose no earlier than 5 hours after removal), monitor frequently for neurological impairment and treat urgently if it is found.' ;
     metaprops :: 'ServiceRequest.code=neurological checks for spinal or epidural hematoma around neuraxial anesthesia or spinal puncture
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=event-triggered, frequent neurological checks whenever neuraxial anesthesia or spinal puncture is performed during anticoagulant therapy
ServiceRequest.patientInstruction=tell the anesthetist that you take an anticoagulant, and report back pain, tingling, numbness or weakness of the legs, or bowel or bladder problems immediately after an epidural or spinal procedure
ServiceRequest.performerInstruction=time epidural catheter removal and the next anticoagulant dose per the drug label (for apixaban remove the catheter no earlier than 24 hours after the last dose and give the next dose no earlier than 5 hours after removal), monitor frequently for neurological impairment and treat urgently if it is found
applies_when=all_patients_on_therapy
assistant_invention=none
category=undesired_ade
cq=CQ3, CQ5, CQ9
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= neurological checks for spinal or epidural hematoma around neuraxial anesthesia or spinal puncture; ServiceRequest.occurrenceTiming \\= event-triggered, frequent neurological checks whenever neuraxial anesthesia or spinal puncture is performed during anticoagulant therapy; ServiceRequest.patientInstruction \\= tell the anesthetist that you take an anticoagulant, and report back pain, tingling, numbness or weakness of the legs, or bowel or bladder problems immediately after an epidural or spinal procedure; ServiceRequest.performerInstruction \\= time epidural catheter removal and the next anticoagulant dose per the drug label (for apixaban remove the catheter no earlier than 24 hours after the last dose and give the next dose no earlier than 5 hours after removal), monitor frequently for neurological impairment and treat urgently if it is found
goal.verb=order
guideline_status=not_specified_as_a_guideline_monitoring_task
instrument=clinician neurological examination
knowledge_origin=DOAC label Boxed Warnings
literature_basis=every DOAC label carries a Boxed Warning that epidural or spinal hematoma can follow neuraxial anesthesia or spinal puncture and instructs frequent neurological monitoring with urgent treatment, with drug-specific catheter timing
monitored_target=spinal or epidural hematoma as a boxed-warning adverse effect of Prescribe_DOAC and Prescribe_Low_Dose_Rivaroxaban
monitoring_frequency_basis=label-specified, frequent checks around each neuraxial procedure
monitoring_stance=recommended
provenance_type=package_insert_specified
quote.1=Boxed Warning (B)\\: "Monitor patients frequently for signs and symptoms of neurological impairment. If neurological compromise is noted, urgent treatment is necessary"
quote.2=\\u00A75.3\\: "Indwelling epidural or intrathecal catheters should not be removed earlier than 24 hours after the last administration of ELIQUIS."
quote.3=\\u00A75.4\\: "Monitor patients frequently for signs and symptoms of neurological impairment (e.g., numbness or weakness of the legs, bowel, or bladder dysfunction)."
source.1=XARELTO (rivaroxaban) US Prescribing Information 2026, Boxed Warning (B)
source.2=ELIQUIS (apixaban) US Prescribing Information 2026, \\u00A75.3
source.3=SAVAYSA (edoxaban) US Prescribing Information 2025, \\u00A75.4
source_kind=package_insert
trigger=back pain, leg numbness or weakness, or bowel or bladder dysfunction after a neuraxial procedure
' ;
     precondition ::result_of(Antithrombotic_Regimen_Decision) = Aspirin_plus_Low_Dose_Rivaroxaban or result_of(Antithrombotic_Regimen_Decision) = DOAC_plus_Antiplatelet or result_of(Antithrombotic_Regimen_Decision) = DOAC_Monotherapy;
     source :: 'back_pain' ;
          data_definition :: 'back_pain' ;
          mandatory :: no ;
     source :: 'bowel_or_bladder_dysfunction' ;
          data_definition :: 'bowel_or_bladder_dysfunction' ;
          mandatory :: no ;
     source :: 'leg_numbness_or_tingling' ;
          data_definition :: 'leg_numbness_or_tingling' ;
          mandatory :: no ;
     source :: 'leg_weakness' ;
          data_definition :: 'leg_weakness' ;
          mandatory :: no ;
     source :: 'neuraxial_procedure_performed' ;
          data_definition :: 'neuraxial_procedure_performed' ;
          mandatory :: no ;
     source :: 'suspected_spinal_epidural_hematoma' ;
          data_definition :: 'suspected_spinal_epidural_hematoma' ;
          mandatory :: no ;
end enquiry.

action  :: 'Alert_Further_Examination_Spinal_Epidural_Hematoma' ;
     caption :: 'Alert: further examination of spinal or epidural hematoma' ;
     description :: 'Monitors suspected spinal or epidural hematoma recorded by Monitor_Spinal_Epidural_Hematoma (spinal or epidural hematoma as a boxed-warning adverse effect of Prescribe_DOAC and Prescribe_Low_Dose_Rivaroxaban). The DOAC Boxed Warning and labels ask for frequent monitoring for signs and symptoms of neurological impairment and urgent treatment when neurological compromise is noted, and name no laboratory or imaging test. The sources name no test, so, following Mor Peleg\'s know-how of 4 Nov 2026, this step alerts the clinician to examine the patient further and decide on work-up instead of ordering a test.' ;
     metaprops :: 'ServiceRequest.code=further clinical examination for suspected spinal or epidural hematoma
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=event-triggered, at the monitoring visit when spinal or epidural hematoma is suspected
ServiceRequest.patientInstruction=attend the examination at once and report any new back pain, numbness, tingling or weakness of the legs, or bowel or bladder problems
ServiceRequest.performerInstruction=examine the patient for spinal or epidural hematoma and decide on further work-up, treating urgently if neurological compromise is found (the sources name no specific test, so none is ordered)
applies_when=all_patients_on_therapy
assistant_invention=the alert step, its suspected_spinal_epidural_hematoma gate and the further-examination order, proposed from Mor Peleg\'s know-how of 4 Nov 2026 because the sources of Monitor_Spinal_Epidural_Hematoma name no laboratory or imaging test for spinal or epidural hematoma
category=undesired_ade
cq=CQ3, CQ5, CQ11
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= further clinical examination for suspected spinal or epidural hematoma; ServiceRequest.occurrenceTiming \\= event-triggered, at the monitoring visit when spinal or epidural hematoma is suspected; ServiceRequest.patientInstruction \\= attend the examination at once and report any new back pain, numbness, tingling or weakness of the legs, or bowel or bladder problems; ServiceRequest.performerInstruction \\= examine the patient for spinal or epidural hematoma and decide on further work-up, treating urgently if neurological compromise is found (the sources name no specific test, so none is ordered)
goal.verb=order
guideline_status=not_specified_as_a_guideline_monitoring_task
instrument=clinician examination
knowledge_origin=Mor Peleg\'s know-how of 4 Nov 2026 (a suspected ADE whose sources name no test alerts the clinician to examine further), applied to the label passages of Monitor_Spinal_Epidural_Hematoma
literature_basis=the DOAC Boxed Warning and labels ask for frequent monitoring for signs and symptoms of neurological impairment and urgent treatment when neurological compromise is noted, and name no laboratory or imaging test
monitored_target=suspected spinal or epidural hematoma recorded by Monitor_Spinal_Epidural_Hematoma (spinal or epidural hematoma as a boxed-warning adverse effect of Prescribe_DOAC and Prescribe_Low_Dose_Rivaroxaban)
monitoring_frequency_basis=event-driven, each time Monitor_Spinal_Epidural_Hematoma records a suspicion
monitoring_stance=symptom_triggered_only
provenance_type=assistant_completed_from_guidelines
quote.1=Boxed Warning (B)\\: "Monitor patients frequently for signs and symptoms of neurological impairment. If neurological compromise is noted, urgent treatment is necessary"
quote.2=\\u00A75.4\\: "Monitor patients frequently for signs and symptoms of neurological impairment (e.g., numbness or weakness of the legs, bowel, or bladder dysfunction)."
role=ade_alert
source.1=XARELTO (rivaroxaban) US Prescribing Information 2026, Boxed Warning (B)
source.2=SAVAYSA (edoxaban) US Prescribing Information 2025, \\u00A75.4
source_kind=package_insert
trigger=suspected_spinal_epidural_hematoma recorded as yes by Monitor_Spinal_Epidural_Hematoma
' ;
     precondition ::(result_of(Antithrombotic_Regimen_Decision) = Aspirin_plus_Low_Dose_Rivaroxaban or result_of(Antithrombotic_Regimen_Decision) = DOAC_plus_Antiplatelet or result_of(Antithrombotic_Regimen_Decision) = DOAC_Monotherapy) and suspected_spinal_epidural_hematoma = "yes";
     procedure :: 'Further clinical examination for suspected spinal or epidural hematoma, event-triggered, at the monitoring visit when spinal or epidural hematoma is suspected. Patient: attend the examination at once and report any new back pain, numbness, tingling or weakness of the legs, or bowel or bladder problems. Clinician: examine the patient for spinal or epidural hematoma and decide on further work-up, treating urgently if neurological compromise is found (the sources name no specific test, so none is ordered).' ;
end action.

enquiry  :: 'Monitor_Perioperative_Interruption' ;
     caption :: 'Plan antithrombotic interruption before surgery or invasive procedures' ;
     description :: 'Monitors surgical bleeding and thrombotic events around procedures for Prescribe_Clopidogrel, Prescribe_Ticagrelor, Prescribe_Prasugrel, Prescribe_Vorapaxar, Prescribe_Low_Dose_Rivaroxaban and Prescribe_DOAC. Each P2Y12 and DOAC label states how long before surgery to interrupt and to resume once hemostasis is achieved, and the prasugrel and ticagrelor labels warn against starting the drug when urgent CABG is likely. Order: perioperative antithrombotic plan before surgery or invasive procedures, event-triggered, whenever surgery, CABG or an invasive or dental procedure is planned. Patient: tell your surgeon and dentist that you take an antiplatelet or anticoagulant before any procedure, and do not stop it unless the prescribing clinician tells you how and when. Clinician: when the procedure\'s bleeding risk requires interruption, hold clopidogrel and ticagrelor 5 days and prasugrel at least 7 days before surgery, do not start prasugrel or ticagrelor if urgent CABG is likely, hold rivaroxaban and edoxaban at least 24 hours and apixaban 24 to 48 hours by procedural bleeding risk, hold dabigatran per its renal-function table, have the surgeon talk to the prescriber before stopping vorapaxar, and resume as soon as hemostasis is achieved.' ;
     metaprops :: 'ServiceRequest.code=perioperative antithrombotic plan before surgery or invasive procedures
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=event-triggered, whenever surgery, CABG or an invasive or dental procedure is planned
ServiceRequest.patientInstruction=tell your surgeon and dentist that you take an antiplatelet or anticoagulant before any procedure, and do not stop it unless the prescribing clinician tells you how and when
ServiceRequest.performerInstruction=when the procedure\'s bleeding risk requires interruption, hold clopidogrel and ticagrelor 5 days and prasugrel at least 7 days before surgery, do not start prasugrel or ticagrelor if urgent CABG is likely, hold rivaroxaban and edoxaban at least 24 hours and apixaban 24 to 48 hours by procedural bleeding risk, hold dabigatran per its renal-function table, have the surgeon talk to the prescriber before stopping vorapaxar, and resume as soon as hemostasis is achieved
applies_when=all_patients_on_therapy
assistant_invention=none
category=undesired_ade
cq=CQ3, CQ5
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= perioperative antithrombotic plan before surgery or invasive procedures; ServiceRequest.occurrenceTiming \\= event-triggered, whenever surgery, CABG or an invasive or dental procedure is planned; ServiceRequest.patientInstruction \\= tell your surgeon and dentist that you take an antiplatelet or anticoagulant before any procedure, and do not stop it unless the prescribing clinician tells you how and when; ServiceRequest.performerInstruction \\= when the procedure\'s bleeding risk requires interruption, hold clopidogrel and ticagrelor 5 days and prasugrel at least 7 days before surgery, do not start prasugrel or ticagrelor if urgent CABG is likely, hold rivaroxaban and edoxaban at least 24 hours and apixaban 24 to 48 hours by procedural bleeding risk, hold dabigatran per its renal-function table, have the surgeon talk to the prescriber before stopping vorapaxar, and resume as soon as hemostasis is achieved
goal.verb=order
guideline_status=not_specified_as_a_guideline_monitoring_task
instrument=clinician review of planned procedures
knowledge_origin=label discontinuation and CABG-bleeding sections
literature_basis=each P2Y12 and DOAC label states how long before surgery to interrupt and to resume once hemostasis is achieved, and the prasugrel and ticagrelor labels warn against starting the drug when urgent CABG is likely
monitored_target=surgical bleeding and thrombotic events around procedures for Prescribe_Clopidogrel, Prescribe_Ticagrelor, Prescribe_Prasugrel, Prescribe_Vorapaxar, Prescribe_Low_Dose_Rivaroxaban and Prescribe_DOAC
monitoring_frequency_basis=event-driven at each planned procedure, as the labels describe
monitoring_stance=recommended
provenance_type=package_insert_specified
quote.1=\\u00A75.3\\: "When possible, interrupt therapy with Plavix for five days prior to such surgery. Resume Plavix as soon as hemostasis is achieved."
quote.2=\\u00A75.2\\: "If possible, Effient should be discontinued at least 7 days prior to CABG."
quote.3=\\u00A75.2\\: "When possible, interrupt therapy with BRILINTA for five days prior to surgery that has a major risk of bleeding."
quote.4=\\u00A72.4\\: "XARELTO should be stopped at least 24 hours before the procedure to reduce the risk of bleeding"
quote.5=\\u00A72.4\\: "ELIQUIS should be discontinued at least 48 hours prior to elective surgery or invasive procedures with a moderate or high risk of unacceptable or clinically significant bleeding"
quote.6=\\u00A717\\: "Tell the doctor performing any surgery or dental procedure to talk to the prescribing physician before stopping ZONTIVITY."
source.1=PLAVIX (clopidogrel) US Prescribing Information 2025, \\u00A75.3
source.2=EFFIENT (prasugrel) US Prescribing Information 2022, \\u00A75.2
source.3=BRILINTA (ticagrelor) US Prescribing Information 2026, \\u00A75.2
source.4=XARELTO (rivaroxaban) US Prescribing Information 2026, \\u00A72.4
source.5=ELIQUIS (apixaban) US Prescribing Information 2026, \\u00A72.4
source.6=ZONTIVITY (vorapaxar) US Prescribing Information 2022, \\u00A717
source_kind=package_insert
trigger=a planned surgery, CABG or invasive procedure
' ;
     precondition ::result_of(Antithrombotic_Regimen_Decision) = Clopidogrel_Monotherapy or result_of(Antithrombotic_Regimen_Decision) = DAPT or result_of(Antithrombotic_Regimen_Decision) = Short_DAPT_then_P2Y12_Monotherapy or result_of(Antithrombotic_Regimen_Decision) = Extended_DAPT or result_of(Antithrombotic_Regimen_Decision) = Aspirin_plus_Vorapaxar or result_of(Antithrombotic_Regimen_Decision) = Aspirin_plus_Low_Dose_Rivaroxaban or result_of(Antithrombotic_Regimen_Decision) = DOAC_plus_Antiplatelet or result_of(Antithrombotic_Regimen_Decision) = DOAC_Monotherapy;
     source :: 'planned_surgery_or_invasive_procedure' ;
          data_definition :: 'planned_surgery_or_invasive_procedure' ;
          mandatory :: no ;
     source :: 'suspected_perioperative_interruption' ;
          data_definition :: 'suspected_perioperative_interruption' ;
          mandatory :: no ;
     source :: 'urgent_cabg_likely' ;
          data_definition :: 'urgent_cabg_likely' ;
          mandatory :: no ;
end enquiry.

action  :: 'Alert_Further_Examination_Perioperative_Interruption' ;
     caption :: 'Alert: further examination of perioperative bleeding or thrombosis' ;
     description :: 'Monitors suspected perioperative bleeding or thrombosis recorded by Monitor_Perioperative_Interruption (surgical bleeding and thrombotic events around procedures for Prescribe_Clopidogrel, Prescribe_Ticagrelor, Prescribe_Prasugrel, Prescribe_Vorapaxar, Prescribe_Low_Dose_Rivaroxaban and Prescribe_DOAC). The labels ask to interrupt the antiplatelet or anticoagulant before surgery and to resume it as soon as hemostasis is achieved, and name no laboratory or imaging test for perioperative bleeding or thrombosis. The sources name no test, so, following Mor Peleg\'s know-how of 4 Nov 2026, this step alerts the clinician to examine the patient further and decide on work-up instead of ordering a test.' ;
     metaprops :: 'ServiceRequest.code=further clinical examination for suspected perioperative bleeding or thrombosis
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=event-triggered, at the monitoring visit when perioperative bleeding or thrombosis is suspected
ServiceRequest.patientInstruction=attend the examination and report at once any bleeding, new chest pain, shortness of breath or stroke symptoms around the procedure
ServiceRequest.performerInstruction=examine the patient for perioperative bleeding or thrombosis and decide on further work-up and on holding or resuming the antithrombotic per its label (the sources name no specific test, so none is ordered)
applies_when=all_patients_on_therapy
assistant_invention=the alert step, its suspected_perioperative_interruption gate and the further-examination order, proposed from Mor Peleg\'s know-how of 4 Nov 2026 because the sources of Monitor_Perioperative_Interruption name no laboratory or imaging test for perioperative bleeding or thrombosis
category=undesired_ade
cq=CQ3, CQ5, CQ11
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= further clinical examination for suspected perioperative bleeding or thrombosis; ServiceRequest.occurrenceTiming \\= event-triggered, at the monitoring visit when perioperative bleeding or thrombosis is suspected; ServiceRequest.patientInstruction \\= attend the examination and report at once any bleeding, new chest pain, shortness of breath or stroke symptoms around the procedure; ServiceRequest.performerInstruction \\= examine the patient for perioperative bleeding or thrombosis and decide on further work-up and on holding or resuming the antithrombotic per its label (the sources name no specific test, so none is ordered)
goal.verb=order
guideline_status=not_specified_as_a_guideline_monitoring_task
instrument=clinician examination
knowledge_origin=Mor Peleg\'s know-how of 4 Nov 2026 (a suspected ADE whose sources name no test alerts the clinician to examine further), applied to the label passages of Monitor_Perioperative_Interruption
literature_basis=the labels ask to interrupt the antiplatelet or anticoagulant before surgery and to resume it as soon as hemostasis is achieved, and name no laboratory or imaging test for perioperative bleeding or thrombosis
monitored_target=suspected perioperative bleeding or thrombosis recorded by Monitor_Perioperative_Interruption (surgical bleeding and thrombotic events around procedures for Prescribe_Clopidogrel, Prescribe_Ticagrelor, Prescribe_Prasugrel, Prescribe_Vorapaxar, Prescribe_Low_Dose_Rivaroxaban and Prescribe_DOAC)
monitoring_frequency_basis=event-driven, each time Monitor_Perioperative_Interruption records a suspicion
monitoring_stance=symptom_triggered_only
provenance_type=assistant_completed_from_guidelines
quote.1=\\u00A75.3\\: "When possible, interrupt therapy with Plavix for five days prior to such surgery. Resume Plavix as soon as hemostasis is achieved."
quote.2=\\u00A75.2\\: "When possible, interrupt therapy with BRILINTA for five days prior to surgery that has a major risk of bleeding."
role=ade_alert
source.1=PLAVIX (clopidogrel) US Prescribing Information 2025, \\u00A75.3
source.2=BRILINTA (ticagrelor) US Prescribing Information 2026, \\u00A75.2
source_kind=package_insert
trigger=suspected_perioperative_interruption recorded as yes by Monitor_Perioperative_Interruption
' ;
     precondition ::(result_of(Antithrombotic_Regimen_Decision) = Clopidogrel_Monotherapy or result_of(Antithrombotic_Regimen_Decision) = DAPT or result_of(Antithrombotic_Regimen_Decision) = Short_DAPT_then_P2Y12_Monotherapy or result_of(Antithrombotic_Regimen_Decision) = Extended_DAPT or result_of(Antithrombotic_Regimen_Decision) = Aspirin_plus_Vorapaxar or result_of(Antithrombotic_Regimen_Decision) = Aspirin_plus_Low_Dose_Rivaroxaban or result_of(Antithrombotic_Regimen_Decision) = DOAC_plus_Antiplatelet or result_of(Antithrombotic_Regimen_Decision) = DOAC_Monotherapy) and suspected_perioperative_interruption = "yes";
     procedure :: 'Further clinical examination for suspected perioperative bleeding or thrombosis, event-triggered, at the monitoring visit when perioperative bleeding or thrombosis is suspected. Patient: attend the examination and report at once any bleeding, new chest pain, shortness of breath or stroke symptoms around the procedure. Clinician: examine the patient for perioperative bleeding or thrombosis and decide on further work-up and on holding or resuming the antithrombotic per its label (the sources name no specific test, so none is ordered).' ;
end action.

enquiry  :: 'Monitor_Renal_Function' ;
     caption :: 'Monitor renal function (creatinine, Cockcroft-Gault CrCl) for anticoagulant dosing' ;
     description :: 'Monitors renal function that sets anticoagulant dosing and eligibility for Prescribe_DOAC and Prescribe_Low_Dose_Rivaroxaban. The dabigatran and rivaroxaban labels instruct baseline and periodic renal assessment with dose adjustment, edoxaban must not be used above a CrCl of 95 mL/min, and every DOAC dose depends on renal function. Order: serum creatinine with Cockcroft-Gault creatinine clearance for anticoagulant dose and eligibility, baseline before starting, then at least every 12 months and sooner when renal function may decline (acute illness, dehydration, new nephrotoxic drugs). Patient: attend the kidney blood test and tell your clinician about vomiting, diarrhea, dehydration or a new medicine that can affect the kidneys. Clinician: adjust or stop the anticoagulant by creatinine clearance per its label, rivaroxaban 15 mg daily for AF if CrCl is 50 or below, dabigatran 75 mg twice daily if CrCl is 15 to 30, apixaban 2.5 mg twice daily with two of age 80 or more, weight 60 kg or less and creatinine 1.5 mg/dL or more, edoxaban 30 mg if CrCl is 15 to 50 and not at all if CrCl is above 95, and avoid rivaroxaban if CrCl is below 15.' ;
     metaprops :: 'ServiceRequest.code=serum creatinine with Cockcroft-Gault creatinine clearance for anticoagulant dose and eligibility
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=baseline before starting, then at least every 12 months and sooner when renal function may decline (acute illness, dehydration, new nephrotoxic drugs)
ServiceRequest.patientInstruction=attend the kidney blood test and tell your clinician about vomiting, diarrhea, dehydration or a new medicine that can affect the kidneys
ServiceRequest.performerInstruction=adjust or stop the anticoagulant by creatinine clearance per its label, rivaroxaban 15 mg daily for AF if CrCl is 50 or below, dabigatran 75 mg twice daily if CrCl is 15 to 30, apixaban 2.5 mg twice daily with two of age 80 or more, weight 60 kg or less and creatinine 1.5 mg/dL or more, edoxaban 30 mg if CrCl is 15 to 50 and not at all if CrCl is above 95, and avoid rivaroxaban if CrCl is below 15
applies_when=all_patients_on_therapy
assistant_invention=the at-least-yearly cadence (the labels say periodically, as clinically indicated)
category=undesired_ade
cq=CQ3, CQ4, CQ9
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= serum creatinine with Cockcroft-Gault creatinine clearance for anticoagulant dose and eligibility; ServiceRequest.occurrenceTiming \\= baseline before starting, then at least every 12 months and sooner when renal function may decline (acute illness, dehydration, new nephrotoxic drugs); ServiceRequest.patientInstruction \\= attend the kidney blood test and tell your clinician about vomiting, diarrhea, dehydration or a new medicine that can affect the kidneys; ServiceRequest.performerInstruction \\= adjust or stop the anticoagulant by creatinine clearance per its label, rivaroxaban 15 mg daily for AF if CrCl is 50 or below, dabigatran 75 mg twice daily if CrCl is 15 to 30, apixaban 2.5 mg twice daily with two of age 80 or more, weight 60 kg or less and creatinine 1.5 mg/dL or more, edoxaban 30 mg if CrCl is 15 to 50 and not at all if CrCl is above 95, and avoid rivaroxaban if CrCl is below 15
goal.verb=order
guideline_status=not_specified_as_a_guideline_monitoring_task
instrument=serum creatinine with Cockcroft-Gault creatinine clearance (actual body weight)
knowledge_origin=DOAC label dosing and renal sections
literature_basis=the dabigatran and rivaroxaban labels instruct baseline and periodic renal assessment with dose adjustment, edoxaban must not be used above a CrCl of 95 mL/min, and every DOAC dose depends on renal function
monitored_target=renal function that sets anticoagulant dosing and eligibility for Prescribe_DOAC and Prescribe_Low_Dose_Rivaroxaban
monitoring_frequency_basis=label-specified baseline and periodic assessment, with a proposed minimum of every 12 months
monitoring_stance=recommended
provenance_type=package_insert_specified
quote.1=\\u00A72.4\\: "Assess renal function prior to initiation of treatment with PRADAXA Capsules. Periodically assess renal function as clinically indicated"
quote.2=\\u00A75.4\\: "Periodically assess renal function as clinically indicated (i.e., more frequently in situations in which renal function may decline) and adjust therapy accordingly"
quote.3=Boxed Warning (A)\\: "SAVAYSA should not be used in patients with CrCL > 95 mL/min."
source.1=PRADAXA (dabigatran) Capsules US Prescribing Information 2025, \\u00A72.4
source.2=XARELTO (rivaroxaban) US Prescribing Information 2026, \\u00A75.4
source.3=SAVAYSA (edoxaban) US Prescribing Information 2025, Boxed Warning (A)
source_kind=package_insert
trigger=acute illness, dehydration or acute kidney injury
' ;
     precondition ::result_of(Antithrombotic_Regimen_Decision) = Aspirin_plus_Low_Dose_Rivaroxaban or result_of(Antithrombotic_Regimen_Decision) = DOAC_plus_Antiplatelet or result_of(Antithrombotic_Regimen_Decision) = DOAC_Monotherapy;
     source :: 'acute_illness' ;
          data_definition :: 'acute_illness' ;
          mandatory :: no ;
     source :: 'dehydration' ;
          data_definition :: 'dehydration' ;
          mandatory :: no ;
     source :: 'new_nephrotoxic_medication' ;
          data_definition :: 'new_nephrotoxic_medication' ;
          mandatory :: no ;
     source :: 'vomiting_or_diarrhea' ;
          data_definition :: 'vomiting_or_diarrhea' ;
          mandatory :: no ;
end enquiry.

action  :: 'Order_Serum_Creatinine' ;
     caption :: 'Order serum creatinine for Cockcroft-Gault creatinine clearance' ;
     description :: 'Orders serum creatinine, from which the Cockcroft-Gault creatinine clearance is calculated, for Monitor_Renal_Function: anticoagulant dose and eligibility depend on it, and the labels ask for baseline and periodic renal assessment, more often when renal function may decline.' ;
     metaprops :: 'goal.noun_phrase=serum creatinine for Cockcroft-Gault creatinine clearance
goal.verb=order
ordered_for=Monitor_Renal_Function
quote.1=\\u00A72.4\\: "Assess renal function prior to initiation of treatment with PRADAXA Capsules. Periodically assess renal function as clinically indicated"
role=test_order
source.1=PRADAXA (dabigatran) Capsules US Prescribing Information 2025, \\u00A72.4
' ;
     precondition ::vomiting_or_diarrhea = "yes" or dehydration = "yes" or new_nephrotoxic_medication = "yes" or acute_illness = "yes";
     procedure :: 'Order serum creatinine for Cockcroft-Gault creatinine clearance when there is vomiting or diarrhea, dehydration, a new nephrotoxic medicine or an acute illness. The scheduled check (baseline before starting, then at least every 12 months) is part of the ServiceRequest.occurrenceTiming of Monitor_Renal_Function, not a data item.' ;
end action.

enquiry  :: 'Monitor_TTP' ;
     caption :: 'Monitor for thrombotic thrombocytopenic purpura on a thienopyridine' ;
     description :: 'Monitors thrombotic thrombocytopenic purpura as a labeled adverse effect of Prescribe_Clopidogrel and Prescribe_Prasugrel. Both thienopyridine labels warn that TTP, sometimes fatal, can follow even brief exposure and needs urgent treatment including plasmapheresis, without a routine laboratory schedule. Order: thrombotic thrombocytopenic purpura symptom review with triggered platelet count, blood smear for schistocytes, LDH and serum creatinine, symptom-triggered, with a symptom question at each follow-up visit and particular attention in the first weeks after starting. Patient: get prompt medical attention for unexplained purple skin spots, extreme tiredness, yellow skin or eyes, fever, confusion or passing little urine. Clinician: if TTP is suspected, check platelet count, a blood smear for schistocytes, LDH and serum creatinine, stop the thienopyridine and arrange urgent treatment including plasmapheresis.' ;
     metaprops :: 'ServiceRequest.code=thrombotic thrombocytopenic purpura symptom review with triggered platelet count, blood smear for schistocytes, LDH and serum creatinine
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=symptom-triggered, with a symptom question at each follow-up visit and particular attention in the first weeks after starting
ServiceRequest.patientInstruction=get prompt medical attention for unexplained purple skin spots, extreme tiredness, yellow skin or eyes, fever, confusion or passing little urine
ServiceRequest.performerInstruction=if TTP is suspected, check platelet count, a blood smear for schistocytes, LDH and serum creatinine, stop the thienopyridine and arrange urgent treatment including plasmapheresis
applies_when=all_patients_on_therapy
assistant_invention=the symptom wording and LDH and creatinine in the triggered panel
category=undesired_ade
cq=CQ3, CQ5, CQ9
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= thrombotic thrombocytopenic purpura symptom review with triggered platelet count, blood smear for schistocytes, LDH and serum creatinine; ServiceRequest.occurrenceTiming \\= symptom-triggered, with a symptom question at each follow-up visit and particular attention in the first weeks after starting; ServiceRequest.patientInstruction \\= get prompt medical attention for unexplained purple skin spots, extreme tiredness, yellow skin or eyes, fever, confusion or passing little urine; ServiceRequest.performerInstruction \\= if TTP is suspected, check platelet count, a blood smear for schistocytes, LDH and serum creatinine, stop the thienopyridine and arrange urgent treatment including plasmapheresis
goal.verb=order
guideline_status=not_specified_as_a_guideline_monitoring_task
instrument=patient symptom report with triggered platelet count, smear, LDH and creatinine
knowledge_origin=thienopyridine label warnings
literature_basis=both thienopyridine labels warn that TTP, sometimes fatal, can follow even brief exposure and needs urgent treatment including plasmapheresis, without a routine laboratory schedule
monitored_target=thrombotic thrombocytopenic purpura as a labeled adverse effect of Prescribe_Clopidogrel and Prescribe_Prasugrel
monitoring_frequency_basis=symptom-triggered because TTP is rare and acute, with attention to the first weeks of exposure
monitoring_stance=symptom_triggered_only
provenance_type=package_insert_specified
quote.1=\\u00A75.4\\: "TTP, sometimes fatal, has been reported following use of Plavix, sometimes after a short exposure (<2 weeks)."
quote.2=\\u00A75.4\\: "TTP has been reported with the use of Effient. TTP can occur after a brief exposure (<2 weeks)."
quote.3=\\u00A75.4\\: "TTP is a serious condition that requires urgent treatment including plasmapheresis (plasma exchange)."
source.1=PLAVIX (clopidogrel) US Prescribing Information 2025, \\u00A75.4
source.2=EFFIENT (prasugrel) US Prescribing Information 2022, \\u00A75.4
source.3=PLAVIX (clopidogrel) US Prescribing Information 2025, \\u00A75.4
source_kind=package_insert
trigger=purpura, jaundice, confusion or reduced urine output
' ;
     precondition ::result_of(Antithrombotic_Regimen_Decision) = Clopidogrel_Monotherapy or result_of(P2Y12_Agent_Decision) = Clopidogrel or result_of(P2Y12_Agent_Decision) = Prasugrel;
     source :: 'confusion' ;
          data_definition :: 'confusion' ;
          mandatory :: no ;
     source :: 'extreme_fatigue' ;
          data_definition :: 'extreme_fatigue' ;
          mandatory :: no ;
     source :: 'fever' ;
          data_definition :: 'fever' ;
          mandatory :: no ;
     source :: 'jaundice' ;
          data_definition :: 'jaundice' ;
          mandatory :: no ;
     source :: 'reduced_urine_output' ;
          data_definition :: 'reduced_urine_output' ;
          mandatory :: no ;
     source :: 'unexplained_purpura' ;
          data_definition :: 'unexplained_purpura' ;
          mandatory :: no ;
end enquiry.

decision  :: 'Tests_Ordering_Recommendations_TTP' ;
     caption :: 'Which tests to order for suspected thrombotic thrombocytopenic purpura?' ;
     description :: 'When a symptom of thrombotic thrombocytopenic purpura is found by Monitor_TTP, which tests to order to confirm it. The monitor\'s performer instruction is to check platelet count, a blood smear for schistocytes, LDH and serum creatinine.' ;
     metaprops :: 'ordered_for=Monitor_TTP
quote.1=\\u00A75.4\\: "It is characterized by thrombocytopenia, microangiopathic hemolytic anemia (schistocytes [fragmented RBCs] seen on peripheral smear), neurological findings, renal dysfunction, and fever"
role=test_ordering
source.1=PLAVIX (clopidogrel) US Prescribing Information 2025, \\u00A75.4
' ;
     precondition ::unexplained_purpura = "yes" or extreme_fatigue = "yes" or jaundice = "yes" or fever = "yes" or confusion = "yes" or reduced_urine_output = "yes";
     choice_mode :: multiple ;
     candidate :: 'Platelet_Count' ;
          caption :: 'Platelet count' ;
          metaprops :: 'ontology.coding=LNC\\:777-3 [Platelets [\\#/volume] in Blood by Automated count]
' ;
          argument :: for,true() attributes
               argument_name :: 'Arg_Order_Platelet_Count' ;
               caption :: 'Platelet count to look for the thrombocytopenia of TTP when its symptoms are found' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'Blood_Smear_Schistocytes' ;
          caption :: 'Blood smear for schistocytes' ;
          metaprops :: 'ontology.coding=LNC\\:800-3 [Schistocytes [Presence] in Blood by Light microscopy]
' ;
          argument :: for,true() attributes
               argument_name :: 'Arg_Order_Blood_Smear_Schistocytes' ;
               caption :: 'Blood smear for schistocytes to look for the microangiopathic hemolysis of TTP when its symptoms are found' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'LDH' ;
          caption :: 'LDH' ;
          metaprops :: 'ontology.coding=LNC\\:2532-0 [Lactate dehydrogenase [Enzymatic activity/volume] in Serum or Plasma]
' ;
          argument :: for,true() attributes
               argument_name :: 'Arg_Order_LDH' ;
               caption :: 'LDH to look for the hemolysis of TTP when its symptoms are found' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'Serum_Creatinine' ;
          caption :: 'Serum creatinine' ;
          metaprops :: 'ontology.coding=LNC\\:2160-0 [Creatinine [Mass/volume] in Serum or Plasma]
' ;
          argument :: for,true() attributes
               argument_name :: 'Arg_Order_Serum_Creatinine' ;
               caption :: 'Serum creatinine to look for the renal dysfunction of TTP when its symptoms are found' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
end decision.

enquiry  :: 'Monitor_CYP2C19_Poor_Metabolizer' ;
     caption :: 'Review CYP2C19 poor-metabolizer status on clopidogrel' ;
     description :: 'Monitors diminished antiplatelet effect in CYP2C19 poor metabolizers as a boxed-warning risk of Prescribe_Clopidogrel. The clopidogrel Boxed Warning says effectiveness depends on CYP2C19 activation, that tests exist, and that another P2Y12 inhibitor should be considered in identified poor metabolizers, without mandating routine genotyping. Order: CYP2C19 poor-metabolizer status review for clopidogrel response, event-triggered, at initiation when a CYP2C19 genotype result is available and after any ischemic event on clopidogrel. Patient: tell your clinician if you have had a CYP2C19 gene test and report any new chest pain or stroke symptoms. Clinician: if the patient is a known CYP2C19 poor metabolizer, consider another P2Y12 inhibitor, and consider CYP2C19 testing after an ischemic event on clopidogrel.' ;
     metaprops :: 'ServiceRequest.code=CYP2C19 poor-metabolizer status review for clopidogrel response
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=event-triggered, at initiation when a CYP2C19 genotype result is available and after any ischemic event on clopidogrel
ServiceRequest.patientInstruction=tell your clinician if you have had a CYP2C19 gene test and report any new chest pain or stroke symptoms
ServiceRequest.performerInstruction=if the patient is a known CYP2C19 poor metabolizer, consider another P2Y12 inhibitor, and consider CYP2C19 testing after an ischemic event on clopidogrel
applies_when=all_patients_on_therapy
assistant_invention=testing after an ischemic event on clopidogrel as the event trigger
category=undesired_ade
cq=CQ3, CQ9
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= CYP2C19 poor-metabolizer status review for clopidogrel response; ServiceRequest.occurrenceTiming \\= event-triggered, at initiation when a CYP2C19 genotype result is available and after any ischemic event on clopidogrel; ServiceRequest.patientInstruction \\= tell your clinician if you have had a CYP2C19 gene test and report any new chest pain or stroke symptoms; ServiceRequest.performerInstruction \\= if the patient is a known CYP2C19 poor metabolizer, consider another P2Y12 inhibitor, and consider CYP2C19 testing after an ischemic event on clopidogrel
goal.verb=order
guideline_status=not_specified_as_a_guideline_monitoring_task
instrument=CYP2C19 genotype result (when available or ordered)
knowledge_origin=clopidogrel Boxed Warning
literature_basis=the clopidogrel Boxed Warning says effectiveness depends on CYP2C19 activation, that tests exist, and that another P2Y12 inhibitor should be considered in identified poor metabolizers, without mandating routine genotyping
monitored_target=diminished antiplatelet effect in CYP2C19 poor metabolizers as a boxed-warning risk of Prescribe_Clopidogrel
monitoring_frequency_basis=event-driven, because the label does not mandate routine genotyping
monitoring_stance=symptom_triggered_only
provenance_type=package_insert_specified
quote.1=Boxed Warning\\: "Tests are available to identify patients who are CYP2C19 poor metabolizers."
quote.2=Boxed Warning\\: "Consider use of another platelet P2Y 12 inhibitor in patients identified as CYP2C19 poor metabolizers."
source.1=PLAVIX (clopidogrel) US Prescribing Information 2025, Boxed Warning
source.2=PLAVIX (clopidogrel) US Prescribing Information 2025, Boxed Warning
source_kind=package_insert
trigger=a known poor-metabolizer result or an ischemic event on clopidogrel
' ;
     precondition ::result_of(Antithrombotic_Regimen_Decision) = Clopidogrel_Monotherapy or result_of(P2Y12_Agent_Decision) = Clopidogrel;
     source :: 'cyp2c19_status' ;
          data_definition :: 'cyp2c19_status' ;
          mandatory :: no ;
     source :: 'ischemic_event_on_clopidogrel' ;
          data_definition :: 'ischemic_event_on_clopidogrel' ;
          mandatory :: no ;
end enquiry.

