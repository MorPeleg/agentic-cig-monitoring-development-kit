enquiry  :: 'Monitor_Antiplatelet_Hypersensitivity' ;
     caption :: 'Monitor for antiplatelet hypersensitivity reactions' ;
     description :: 'Monitors hypersensitivity reactions to Prescribe_Aspirin, Prescribe_Clopidogrel, Prescribe_Prasugrel and Prescribe_Ticagrelor. The aspirin label warns of severe allergic reactions and says to stop use and seek help, and the clopidogrel, prasugrel and ticagrelor labels list hypersensitivity and angioedema, with cross-reactivity between thienopyridines. Order: antiplatelet hypersensitivity reaction review (hives, angioedema, bronchospasm, rash, hematologic reaction), symptom-triggered, with an allergy question at each follow-up visit after starting or switching an antiplatelet. Patient: stop the medicine and seek medical help right away for hives, swelling of the face, lips or throat, wheezing or a widespread rash. Clinician: if a hypersensitivity reaction occurs, stop the culprit drug, treat the reaction and choose an alternative antiplatelet, noting cross-reactivity between thienopyridines (clopidogrel, prasugrel, ticlopidine).' ;
     metaprops :: 'ServiceRequest.code=antiplatelet hypersensitivity reaction review (hives, angioedema, bronchospasm, rash, hematologic reaction)
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=symptom-triggered, with an allergy question at each follow-up visit after starting or switching an antiplatelet
ServiceRequest.patientInstruction=stop the medicine and seek medical help right away for hives, swelling of the face, lips or throat, wheezing or a widespread rash
ServiceRequest.performerInstruction=if a hypersensitivity reaction occurs, stop the culprit drug, treat the reaction and choose an alternative antiplatelet, noting cross-reactivity between thienopyridines (clopidogrel, prasugrel, ticlopidine)
applies_when=all_patients_on_therapy
assistant_invention=grouping the four antiplatelet hypersensitivity warnings into one symptom-triggered task
category=undesired_ade
cq=CQ3, CQ5
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= antiplatelet hypersensitivity reaction review (hives, angioedema, bronchospasm, rash, hematologic reaction); ServiceRequest.occurrenceTiming \\= symptom-triggered, with an allergy question at each follow-up visit after starting or switching an antiplatelet; ServiceRequest.patientInstruction \\= stop the medicine and seek medical help right away for hives, swelling of the face, lips or throat, wheezing or a widespread rash; ServiceRequest.performerInstruction \\= if a hypersensitivity reaction occurs, stop the culprit drug, treat the reaction and choose an alternative antiplatelet, noting cross-reactivity between thienopyridines (clopidogrel, prasugrel, ticlopidine)
goal.verb=order
guideline_status=not_specified_as_a_guideline_monitoring_task
instrument=patient symptom report with clinician examination
knowledge_origin=aspirin allergy alert and thienopyridine and ticagrelor hypersensitivity sections
literature_basis=the aspirin label warns of severe allergic reactions and says to stop use and seek help, and the clopidogrel, prasugrel and ticagrelor labels list hypersensitivity and angioedema, with cross-reactivity between thienopyridines
monitored_target=hypersensitivity reactions to Prescribe_Aspirin, Prescribe_Clopidogrel, Prescribe_Prasugrel and Prescribe_Ticagrelor
monitoring_frequency_basis=symptom-triggered because reactions are acute
monitoring_stance=symptom_triggered_only
