' ;
          argument :: for,true() attributes
               argument_name :: 'Arg_Order_Serum_Calcium' ;
               caption :: 'Serum calcium for the hypocalcemia that can accompany hypomagnesemia' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'Serum_Potassium' ;
          caption :: 'Serum potassium' ;
