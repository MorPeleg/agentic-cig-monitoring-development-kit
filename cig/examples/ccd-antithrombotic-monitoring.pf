decision  :: 'Tests_Ordering_Recommendations_TTP' ;
     caption :: 'Which tests to order for suspected thrombotic thrombocytopenic purpura?' ;
     description :: 'When a symptom of thrombotic thrombocytopenic purpura is found by Monitor_TTP, which tests to order to confirm it. The monitor\'s performer instruction is to check platelet count, a blood smear for schistocytes, LDH and serum creatinine.' ;
     metaprops :: 'ordered_for=Monitor_TTP
quote.1=\\u00A75.4\\: "It is characterized by thrombocytopenia, microangiopathic hemolytic anemia (schistocytes [fragmented RBCs] seen on peripheral smear), neurological findings, renal dysfunction, and fever"
role=test_ordering
source.1=PLAVIX (clopidogrel) US Prescribing Information 2025, \\u00A75.4
' ;
     precondition ::unexplained_purpura = true or extreme_fatigue = true or jaundice = true or fever = true or confusion = true or reduced_urine_output = true;
     choice_mode :: multiple ;
     candidate :: 'Platelet_Count' ;
          caption :: 'Platelet count' ;
          metaprops :: 'ontology.coding=LOINC\\:777-3
ontology.label=Platelets [\\#/volume] in Blood by Automated count
' ;
          argument :: for,true() attributes
               argument_name :: 'Arg_Order_Platelet_Count' ;
               caption :: 'Platelet count to look for the thrombocytopenia of TTP when its symptoms are found' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'Blood_Smear_Schistocytes' ;
          caption :: 'Blood smear for schistocytes' ;
          metaprops :: 'ontology.coding=LOINC\\:800-3
ontology.label=Schistocytes [Presence] in Blood by Light microscopy
' ;
          argument :: for,true() attributes
               argument_name :: 'Arg_Order_Blood_Smear_Schistocytes' ;
               caption :: 'Blood smear for schistocytes to look for the microangiopathic hemolysis of TTP when its symptoms are found' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'LDH' ;
          caption :: 'LDH' ;
          metaprops :: 'ontology.coding=LOINC\\:2532-0
ontology.label=Lactate dehydrogenase [Enzymatic activity/volume] in Serum or Plasma
' ;
          argument :: for,true() attributes
               argument_name :: 'Arg_Order_LDH' ;
               caption :: 'LDH to look for the hemolysis of TTP when its symptoms are found' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'Serum_Creatinine' ;
          caption :: 'Serum creatinine' ;
          metaprops :: 'ontology.coding=LOINC\\:2160-0
ontology.label=Creatinine [Mass/volume] in Serum or Plasma
' ;
          argument :: for,true() attributes
               argument_name :: 'Arg_Order_Serum_Creatinine' ;
               caption :: 'Serum creatinine to look for the renal dysfunction of TTP when its symptoms are found' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
end decision.

enquiry  :: 'Monitor_CYP2C19_Poor_Metabolizer' ;
     caption :: 'Review CYP2C19 poor-metabolizer status on clopidogrel' ;
     description :: 'Monitors diminished antiplatelet effect in CYP2C19 poor metabolizers as a boxed-warning risk of Prescribe_Clopidogrel. The clopidogrel Boxed Warning says effectiveness depends on CYP2C19 activation, that tests exist, and that another P2Y12 inhibitor should be considered in identified poor metabolizers, without mandating routine genotyping. Order: CYP2C19 poor-metabolizer status review for clopidogrel response, event-triggered, at initiation when a CYP2C19 genotype result is available and after any ischemic event on clopidogrel. Patient: tell your clinician if you have had a CYP2C19 gene test and report any new chest pain or stroke symptoms. Clinician: if the patient is a known CYP2C19 poor metabolizer, consider another P2Y12 inhibitor, and consider CYP2C19 testing after an ischemic event on clopidogrel.' ;
     metaprops :: 'ServiceRequest.code=CYP2C19 poor-metabolizer status review for clopidogrel response
