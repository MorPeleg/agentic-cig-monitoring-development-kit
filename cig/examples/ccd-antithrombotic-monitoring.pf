' ;
     precondition ::(result_of(Antithrombotic_Regimen_Decision) = DAPT or result_of(Antithrombotic_Regimen_Decision) = Short_DAPT_then_P2Y12_Monotherapy or result_of(Antithrombotic_Regimen_Decision) = Extended_DAPT or result_of(Antithrombotic_Regimen_Decision) = DOAC_plus_Antiplatelet) and suspected_ppi_severe_cutaneous_reactions = "yes";
