/** PROforma version 1.9 (plain text) **/

/** IMPORTANT: Keep all your comments below the engine_version line **/
engine_version :: '1.9' ;

metadata  :: 'ccd_antithrombotic_monitoring' ;
     title :: 'CCD Antithrombotic Therapy and Monitoring (2023 AHA/ACC CCD Guideline §4.3.1)' ;
     desc :: 'PROforma CIG for antiplatelet and oral anticoagulant therapy in adults with chronic coronary disease, from section 4.3.1 of the 2023 AHA/ACC chronic coronary disease guideline and the US prescribing information of its drugs. It collects the patient data the regimen choice depends on, recommends an antithrombotic regimen and a P2Y12 inhibitor, delivers the drugs with NSAID avoidance and gastroprotection, and monitors completion of the recommendations, the desired reduction of ischemic events and the adverse drug effects. The task set is the one fixed by the approved proposal.' ;
     version :: '1.0' ;
     author :: 'Antonio Zaitoun' ;
end metadata.

metaprops :: 'goal.noun_phrase=chronic coronary disease in adults, antiplatelet and oral anticoagulant therapy to prevent cardiovascular events with monitoring of adherence, ischemic events and adverse drug effects
goal.verb=treat
' ;

