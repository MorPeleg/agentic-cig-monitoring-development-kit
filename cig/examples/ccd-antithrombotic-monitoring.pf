action  :: 'Advise_Avoid_Chronic_NSAIDs' ;
     caption :: 'Advise avoiding chronic NSAID use' ;
     description :: 'Rec 10 [3: Harm, B-R]: in CCD, chronic NSAIDs should not be used because of increased cardiovascular and bleeding complications. Modelled as an advice step that always completes at the start of the therapy plan, so every drug action can follow it.' ;
     metaprops :: 'goal.noun_phrase=increased cardiovascular and bleeding complications from chronic NSAID use
goal.verb=avoid
quote.1=p.e50, Rec 10\\: "chronic nonsteroidal anti-inflammatory drugs should not be used because of increased cardiovascular and bleeding complications"
quote.2=p.e53, text 10\\: "HF risk was doubled by all nonsteroidal antiinflammatory drugs."
source.1=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 10 (p.e50)
source.2=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 supportive text 10 (p.e53)
' ;
     procedure :: 'Advise against chronic use of NSAIDs (ibuprofen, naproxen, diclofenac, coxibs), including over-the-counter products, and review analgesic needs at each visit.' ;
end action.

decision  :: 'P2Y12_Agent_Decision' ;
     caption :: 'Choose the P2Y12 inhibitor' ;
     description :: 'Chooses the P2Y12 inhibitor for every regimen that contains one besides clopidogrel monotherapy. Assistant-proposed rule (approved open question 2): clopidogrel after PCI or with a DOAC (Recs 2, 11), ticagrelor after MI (Rec 4 evidence, PEGASUS, 60 mg twice daily), prasugrel only after ACS treated with PCI (label indication), excluded after stroke, TIA or ICH (Rec 9) and argued against at age 75 or older. Single choice with the default recommendation netsupport() > 0.' ;
     precondition ::result_of(Antithrombotic_Regimen_Decision) = DAPT or result_of(Antithrombotic_Regimen_Decision) = Short_DAPT_then_P2Y12_Monotherapy or result_of(Antithrombotic_Regimen_Decision) = Extended_DAPT or result_of(Antithrombotic_Regimen_Decision) = DOAC_plus_Antiplatelet;
     candidate :: 'Clopidogrel' ;
          caption :: 'Clopidogrel 75 mg once daily' ;
          description :: 'The P2Y12 inhibitor §4.3.1 names for CCD after PCI (Rec 2) and with a DOAC (Rec 11).' ;
          argument :: for,acs_within_12_months = "no" or requires_oral_anticoagulation = "yes" or pci_within_12_months = "yes" attributes
               argument_name :: 'Arg_Clopidogrel_CCD' ;
               caption :: 'Assistant-proposed from Rec 2 [1, A] and Rec 11 [1, B-R]: no ACS in the past 12 months, an oral anticoagulant indication, or PCI in the past 12 months' ;
               metaprops :: 'quote.1=p.e50, Rec 2\\: "dual antiplatelet therapy (DAPT) consisting of aspirin and clopidogrel for 6 months post PCI followed by single antiplatelet therapy (SAPT) is indicated"
quote.2=p.e50, Rec 11\\: "DAPT for 1 to 4 weeks followed by clopidogrel alone for 6 months should be administered in addition to DOAC"
source.1=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 2 (p.e50)
source.2=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 11 (p.e50)
' ;
          end attributes
          ;
          argument :: for,acs_within_12_months = "yes" and pci_within_12_months = "no" and (previous_mi = "no" or prior_ich = "yes") attributes
               argument_name :: 'Arg_Clopidogrel_ACS_No_Alternative' ;
               caption :: '[assistant-proposed fallback] Figure 9 and Rec 2 [1, A]: ACS in the past 12 months without PCI, and no previous MI or a history of ICH' ;
               metaprops :: 'quote.1=p.e51, Figure 9 (figure labels)\\: "Prior ACS with or without PCI ... DAPT"
quote.2=p.e50, Rec 2\\: "dual antiplatelet therapy (DAPT) consisting of aspirin and clopidogrel"
quote.3=\\u00A71.1\\: "are to be managed medically and those who are to be managed with coronary revascularization"
source.1=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Figure 9 (p.e51)
source.2=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 2 (p.e50)
source.3=PLAVIX (clopidogrel) US Prescribing Information 2025, \\u00A71.1
' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'Ticagrelor' ;
          caption :: 'Ticagrelor 60 mg twice daily' ;
          description :: 'Ticagrelor after MI, from the evidence behind Rec 4 (PEGASUS, 60 mg twice daily); not with an oral anticoagulant (Rec 11) and contraindicated after ICH (BRILINTA §4.1).' ;
          argument :: for,previous_mi = "yes" attributes
               argument_name :: 'Arg_Ticagrelor_Post_MI' ;
               caption :: 'Assistant-proposed from Rec 4 [2b, A] (PEGASUS, ticagrelor 60 mg): previous MI' ;
               metaprops :: 'quote.1=p.e50, Rec 4\\: "extended DAPT beyond 12 months for a period of up to 3 years may be reasonable to reduce MACE"
quote.2=p.e52, text 4\\: "Treatment with ticagrelor 60 mg reduced the risk of cardiovascular death, MI, or stroke by 16% and increased the risk of major bleeding"
source.1=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 4 (p.e50)
source.2=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 supportive text 4 (p.e52)
' ;
          end attributes
          ;
          argument :: against,requires_oral_anticoagulation = "yes" attributes
               argument_name :: 'Arg_Ticagrelor_With_OAC' ;
               caption :: 'Assistant-proposed from Rec 11 [1, B-R] (clopidogrel with a DOAC): oral anticoagulant indication' ;
               metaprops :: 'quote=p.e50, Rec 11\\: "DAPT for 1 to 4 weeks followed by clopidogrel alone for 6 months should be administered in addition to DOAC"
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 11 (p.e50)
' ;
          end attributes
          ;
          argument :: excluding,prior_ich = "yes" attributes
               argument_name :: 'Arg_Ticagrelor_ICH' ;
               caption :: 'BRILINTA §4.1 contraindication [label, no COR/LOE]: history of intracranial hemorrhage' ;
               metaprops :: 'quote=\\u00A74.1\\: "BRILINTA is contraindicated in patients with a history of intracranial hemorrhage (ICH) because of a high risk of recurrent ICH in this population"
source=BRILINTA (ticagrelor) US Prescribing Information 2026, \\u00A74.1
' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'Prasugrel' ;
          caption :: 'Prasugrel 10 mg once daily' ;
          description :: 'Prasugrel only after ACS treated with PCI (its label indication); excluded after stroke, TIA or ICH (Rec 9, EFFIENT §4.2), argued against at age 75 or older (Boxed Warning) and with an oral anticoagulant (Rec 11).' ;
          argument :: for,acs_within_12_months = "yes" and pci_within_12_months = "yes" attributes
               argument_name :: 'Arg_Prasugrel_ACS_PCI' ;
               caption :: 'Assistant-proposed from the EFFIENT §1 indication [label, no COR/LOE]: ACS treated with PCI in the past 12 months' ;
               metaprops :: 'quote=\\u00A71.1\\: "indicated to reduce the rate of thrombotic CV events (including stent thrombosis) in patients with acute coronary syndrome (ACS) who are to be managed with percutaneous coronary intervention (PCI)"
source=EFFIENT (prasugrel) US Prescribing Information 2022, \\u00A71.1 Acute Coronary Syndrome
' ;
          end attributes
          ;
          argument :: against,age_years >= 75 attributes
               argument_name :: 'Arg_Prasugrel_Age' ;
               caption :: 'EFFIENT Boxed Warning [label, no COR/LOE]: age 75 years or older' ;
               metaprops :: 'quote=Boxed Warning\\: "In patients \\u226575 years of age, Effient is generally not recommended, because of the increased risk of fatal and intracranial bleeding and uncertain benefit"
source=EFFIENT (prasugrel) US Prescribing Information 2022, Boxed Warning
' ;
          end attributes
          ;
          argument :: against,requires_oral_anticoagulation = "yes" attributes
               argument_name :: 'Arg_Prasugrel_With_OAC' ;
               caption :: 'Assistant-proposed from Rec 11 [1, B-R] (clopidogrel with a DOAC): oral anticoagulant indication' ;
               metaprops :: 'quote=p.e50, Rec 11\\: "DAPT for 1 to 4 weeks followed by clopidogrel alone for 6 months should be administered in addition to DOAC"
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 11 (p.e50)
' ;
          end attributes
          ;
          argument :: excluding,prior_stroke_or_tia = "yes" or prior_ich = "yes" attributes
               argument_name :: 'Arg_Prasugrel_Harm' ;
               caption :: 'Rec 9 [3: Harm, B-R]; EFFIENT §4.2: previous stroke, TIA or ICH' ;
               metaprops :: 'quote.1=p.e50, Rec 9\\: "prasugrel should not be used because of risk of significant or fatal bleeding"
quote.2=\\u00A74.2\\: "Effient is contraindicated in patients with a history of prior transient ischemic attack (TIA) or stroke."
source.1=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 9 (p.e50)
source.2=EFFIENT (prasugrel) US Prescribing Information 2022, \\u00A74.2
' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
end decision.

action  :: 'Prescribe_Aspirin' ;
     caption :: 'Prescribe low-dose aspirin 81 mg once daily' ;
     description :: 'Rec 1 [1, A] recommends low-dose aspirin 81 mg (75-100 mg) to reduce atherosclerotic events in CCD without an oral anticoagulant indication. Aspirin is also part of every DAPT, vorapaxar and low-dose rivaroxaban regimen and of the short triple therapy with a DOAC after PCI (Recs 2-4, 11, 12, 15), so it is delivered for every regimen that contains it.' ;
     metaprops :: 'goal.noun_phrase=reduction of atherosclerotic events and MACE
goal.verb=achieve
quote.1=p.e50, Rec 1\\: "low-dose aspirin 81 mg (75-100 mg) is recommended to reduce atherosclerotic events"
quote.2=p.e50, Rec 12\\: "continuing aspirin in addition to clopidogrel for up to 1 month is reasonable if the patient has a high thrombotic risk and low bleeding risk"
rxnorm.coding=RXNORM\\:1191
rxnorm.label=aspirin
source.1=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 1 (p.e50)
source.2=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 12 (p.e50)
' ;
     precondition ::result_of(Antithrombotic_Regimen_Decision) = Aspirin_Monotherapy or result_of(Antithrombotic_Regimen_Decision) = DAPT or result_of(Antithrombotic_Regimen_Decision) = Short_DAPT_then_P2Y12_Monotherapy or result_of(Antithrombotic_Regimen_Decision) = Extended_DAPT or result_of(Antithrombotic_Regimen_Decision) = Aspirin_plus_Vorapaxar or result_of(Antithrombotic_Regimen_Decision) = Aspirin_plus_Low_Dose_Rivaroxaban or result_of(Antithrombotic_Regimen_Decision) = DOAC_plus_Antiplatelet;
     procedure :: 'Aspirin 81 mg (75 to 100 mg) once daily. Long term as single antiplatelet therapy. With clopidogrel for 6 months after PCI (Rec 2), with a P2Y12 inhibitor for 12 months after ACS and up to 3 years as extended DAPT (Rec 4), stop after 1 to 3 months when P2Y12 monotherapy follows (Rec 3), and with a DOAC after PCI stop after 1 to 4 weeks (up to 1 month at high thrombotic and low bleeding risk, Rec 11 and 12). Do not exceed 100 mg daily with ticagrelor.' ;
end action.

action  :: 'Prescribe_Clopidogrel' ;
     caption :: 'Prescribe clopidogrel 75 mg once daily' ;
     description :: 'Rec 2 [1, A] (DAPT with aspirin for 6 months after PCI, then single antiplatelet therapy), Rec 11 [1, B-R] (with a DOAC for 6 months after PCI) and supportive text 1 (alternative to aspirin when aspirin is not tolerated). Runs after both the NSAID advice and the P2Y12 decision, so it still runs on the clopidogrel-monotherapy path where that decision is discarded.' ;
     metaprops :: 'goal.noun_phrase=reduction of MACE and stent-related events after PCI, or of atherosclerotic events when aspirin is not tolerated
goal.verb=achieve
quote.1=p.e50, Rec 2\\: "dual antiplatelet therapy (DAPT) consisting of aspirin and clopidogrel for 6 months post PCI followed by single antiplatelet therapy (SAPT) is indicated"
quote.2=p.e50, Rec 11\\: "DAPT for 1 to 4 weeks followed by clopidogrel alone for 6 months should be administered in addition to DOAC"
quote.3=\\u00A72.2\\: "75 mg once daily orally without a loading dose"
quote.4=p.e51, text 1\\: "As an alternative to low-dose aspirin, clopidogrel may be used in individuals who cannot tolerate aspirin therapy"
rxnorm.coding=RXNORM\\:32968
rxnorm.label=clopidogrel
source.1=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 2 (p.e50)
source.2=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 11 (p.e50)
source.3=PLAVIX (clopidogrel) US Prescribing Information 2025, \\u00A72.2
source.4=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 supportive text 1 (p.e51)
' ;
     precondition ::result_of(Antithrombotic_Regimen_Decision) = Clopidogrel_Monotherapy or result_of(P2Y12_Agent_Decision) = Clopidogrel;
     procedure :: 'Clopidogrel 75 mg once daily. With aspirin for 6 months after PCI, then single antiplatelet therapy (Rec 2). With a DOAC after PCI for 6 months, then DOAC alone (Rec 11). Long term as monotherapy when aspirin is not tolerated. Avoid omeprazole and esomeprazole.' ;
end action.

action  :: 'Prescribe_Ticagrelor' ;
     caption :: 'Prescribe ticagrelor 90 mg twice daily in the first year after ACS or MI, then 60 mg twice daily' ;
     description :: 'Rec 4 [2b, A] allows extended DAPT beyond 12 months after MI for up to 3 years; its evidence (PEGASUS) used ticagrelor 60 mg twice daily, which reduced cardiovascular death, MI or stroke. Chosen by the assistant-proposed P2Y12 agent rule.' ;
     metaprops :: 'goal.noun_phrase=reduction of cardiovascular death, MI or stroke after MI
goal.verb=achieve
quote.1=p.e50, Rec 4\\: "extended DAPT beyond 12 months for a period of up to 3 years may be reasonable to reduce MACE"
quote.2=p.e52, text 4\\: "Treatment with ticagrelor 60 mg reduced the risk of cardiovascular death, MI, or stroke by 16% and increased the risk of major bleeding"
quote.3=\\u00A72.2\\: "Administer 90 mg of BRILINTA twice daily during the first year after an ACS event."
quote.4=\\u00A72.2\\: "After one year, administer 60 mg of BRILINTA twice daily."
rxnorm.coding=RXNORM\\:1116632
rxnorm.label=ticagrelor
source.1=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 4 (p.e50)
source.2=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 supportive text 4 (p.e52)
source.3=BRILINTA (ticagrelor) US Prescribing Information 2026, \\u00A72.2
source.4=BRILINTA (ticagrelor) US Prescribing Information 2026, \\u00A72.2
' ;
     precondition ::result_of(P2Y12_Agent_Decision) = Ticagrelor;
     procedure :: 'Ticagrelor 90 mg twice daily during the first year after an ACS or MI, then 60 mg twice daily, with aspirin 75 to 100 mg daily, as extended DAPT more than 12 months after MI for up to 3 years (Rec 4), or as P2Y12 monotherapy after 1 to 3 months of DAPT (Rec 3) per the label dose. Not with a history of intracranial hemorrhage.' ;
end action.

action  :: 'Prescribe_Prasugrel' ;
     caption :: 'Prescribe prasugrel 10 mg once daily after ACS treated with PCI' ;
     description :: 'Prasugrel is indicated after ACS managed with PCI (EFFIENT label) and can serve as the P2Y12 inhibitor of DAPT or of P2Y12 monotherapy after short DAPT (Rec 3 [2a, A]); Rec 9 [3: Harm, B-R] forbids it after stroke, TIA or ICH. Chosen by the assistant-proposed P2Y12 agent rule.' ;
     metaprops :: 'goal.noun_phrase=reduction of thrombotic cardiovascular events after ACS treated with PCI
goal.verb=achieve
quote.1=p.e50, Rec 3\\: "P2Y12 inhibitor monotherapy for at least 12 months is reasonable to reduce bleeding risk"
quote.2=\\u00A72\\: "Continue at 10 mg once daily with or without food. Consider 5 mg once daily for patients <60 kg"
rxnorm.coding=RXNORM\\:613391
rxnorm.label=prasugrel
source.1=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 3 (p.e50)
source.2=EFFIENT (prasugrel) US Prescribing Information 2022, \\u00A72
' ;
     precondition ::result_of(P2Y12_Agent_Decision) = Prasugrel;
     procedure :: 'Prasugrel 10 mg once daily with aspirin (5 mg once daily if body weight is below 60 kg), as part of DAPT or as P2Y12 monotherapy after 1 to 3 months of DAPT (Rec 3). Never after stroke, TIA or ICH (Rec 9), generally not at age 75 or older.' ;
end action.

action  :: 'Prescribe_Vorapaxar' ;
     caption :: 'Add vorapaxar 2.08 mg once daily to aspirin after MI' ;
     description :: 'Rec 5 [2b, B-R]: after a previous MI without stroke, TIA or ICH, vorapaxar may be added to aspirin to reduce MACE; Rec 8 [3: Harm, A] forbids it after stroke, TIA or ICH.' ;
     metaprops :: 'goal.noun_phrase=reduction of MACE after MI
goal.verb=achieve
quote.1=p.e50, Rec 5\\: "vorapaxar may be added to aspirin therapy to reduce MACE"
quote.2=\\u00A72.1\\: "Take one tablet of ZONTIVITY 2.08 mg orally once daily, with or without food."
rxnorm.coding=RXNORM\\:1537034
rxnorm.label=vorapaxar
source.1=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 5 (p.e50)
source.2=ZONTIVITY (vorapaxar) US Prescribing Information 2022, \\u00A72.1
' ;
     precondition ::result_of(Antithrombotic_Regimen_Decision) = Aspirin_plus_Vorapaxar;
     procedure :: 'Vorapaxar 2.08 mg (equivalent to 2.5 mg vorapaxar sulfate) once daily with aspirin, only after MI without a history of stroke, TIA or ICH, and not with an anticoagulant.' ;
end action.

action  :: 'Prescribe_Low_Dose_Rivaroxaban' ;
     caption :: 'Add rivaroxaban 2.5 mg twice daily to aspirin 81 mg' ;
     description :: 'Rec 15 [2a, B-R]: at high ischemic and low or moderate bleeding risk, adding low-dose rivaroxaban 2.5 mg twice daily to aspirin 81 mg daily is reasonable for long-term MACE reduction.' ;
     metaprops :: 'goal.noun_phrase=long-term reduction of MACE in high ischemic risk
goal.verb=achieve
quote.1=p.e50, Rec 15\\: "the addition of low-dose rivaroxaban 2.5 mg twice daily to aspirin 81 mg daily is reasonable for long-term reduction of risk for MACE"
quote.2=\\u00A72.1\\: "2.5 mg orally twice daily with or without food, in combination with aspirin"
rxnorm.coding=RXNORM\\:1114195
rxnorm.label=rivaroxaban
source.1=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 15 (p.e50)
source.2=XARELTO (rivaroxaban) US Prescribing Information 2026, \\u00A72.1
' ;
     precondition ::result_of(Antithrombotic_Regimen_Decision) = Aspirin_plus_Low_Dose_Rivaroxaban;
     procedure :: 'Rivaroxaban 2.5 mg twice daily with aspirin 81 mg once daily (Rec 15), long term. No creatinine-clearance dose adjustment for CAD, avoid if CrCl is below 15 mL/min.' ;
end action.

action  :: 'Prescribe_DOAC' ;
     caption :: 'Prescribe a DOAC at its labeled dose' ;
     description :: 'Recs 11-14: in CCD with an oral anticoagulant indication a DOAC is given with short antiplatelet therapy after PCI (Rec 11, 12), alone 1 year after PCI (Rec 13) or alone without an acute antiplatelet indication (Rec 14). One class-level action because §4.3.1 does not choose the agent; doses follow the US labels and the procedure notes the guideline\'s trial doses (approved open questions 4 and 5). The SNOMED CT concept (anticoagulant therapy) is broader than DOAC, since no DOAC concept was returned.' ;
     metaprops :: 'goal.noun_phrase=prevention of thromboembolism for the anticoagulant indication with the lowest bleeding risk alongside or after antiplatelet therapy
goal.verb=achieve
quote.1=p.e50, Rec 14\\: "DOAC monotherapy may be considered if there is no acute indication for concomitant antiplatelet therapy"
quote.2=p.e50, Rec 13\\: "discontinuation of aspirin therapy with continuation of DOAC alone may be considered 1 year after PCI to reduce bleeding risk"
quote.3=p.e54, text 11\\: "apixaban 5 mg twice daily or 2.5 mg twice daily in those with 2 of 3 criteria for high bleeding risk"
source.1=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 14 (p.e50)
source.2=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 13 (p.e50)
source.3=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 supportive text 11 (p.e54)
' ;
     precondition ::result_of(Antithrombotic_Regimen_Decision) = DOAC_plus_Antiplatelet or result_of(Antithrombotic_Regimen_Decision) = DOAC_Monotherapy;
     procedure :: 'A DOAC at its labeled dose: apixaban 5 mg twice daily (2.5 mg with 2 of: age 80 or more, weight 60 kg or less, creatinine 1.5 mg/dL or more), rivaroxaban 20 mg daily (15 mg if CrCl 50 or below, 15 mg as used with a P2Y12 inhibitor after PCI), edoxaban 60 mg daily (30 mg if CrCl 15 to 50, not if above 95) or dabigatran 150 mg twice daily (75 mg if CrCl 15 to 30). After elective PCI add aspirin and clopidogrel for 1 to 4 weeks, then clopidogrel to 6 months, then DOAC alone (Rec 11 to 13). Without PCI, DOAC alone (Rec 14).' ;
end action.

action  :: 'Prescribe_PPI' ;
     caption :: 'Prescribe pantoprazole 40 mg once daily for gastroprotection' ;
     description :: 'Rec 16 [2a, B-R]: in CCD on DAPT a PPI can reduce gastrointestinal bleeding risk. Pantoprazole is the PPI because it has no clinically important interaction with clopidogrel; it is also given during DOAC plus antiplatelet therapy, which starts as triple therapy (approved open question 7, off-label for this indication).' ;
     metaprops :: 'goal.noun_phrase=gastrointestinal bleeding during DAPT or antiplatelet plus anticoagulant therapy
goal.verb=avoid
quote.1=p.e50, Rec 16\\: "In patients with CCD on DAPT, the use of a PPI can be effective in reducing gastrointestinal bleeding risk"
quote.2=\\u00A77\\: "Concomitant administration of pantoprazole and clopidogrel in healthy subjects had no clinically important effect on exposure to the active metabolite of clopidogrel"
rxnorm.coding=RXNORM\\:40790
rxnorm.label=pantoprazole
source.1=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 16 (p.e50)
source.2=PROTONIX (pantoprazole) US Prescribing Information 2026, \\u00A77
' ;
     precondition ::result_of(Antithrombotic_Regimen_Decision) = DAPT or result_of(Antithrombotic_Regimen_Decision) = Short_DAPT_then_P2Y12_Monotherapy or result_of(Antithrombotic_Regimen_Decision) = Extended_DAPT or result_of(Antithrombotic_Regimen_Decision) = DOAC_plus_Antiplatelet;
     procedure :: 'Pantoprazole 40 mg once daily while on DAPT or an antiplatelet plus an anticoagulant (off-label for this indication, the labeled maintenance dose). Do not use omeprazole or esomeprazole with clopidogrel.' ;
end action.

plan  :: 'Antithrombotic_Therapy' ;
     caption :: 'Antithrombotic therapy (when there is no active pathological bleeding)' ;
     description :: 'Delivers the chosen antithrombotic regimen: NSAID-avoidance advice first, then the P2Y12-agent decision and the drug actions, each gated by the regimen it belongs to. The whole plan is skipped when there is active pathological bleeding, which every antithrombotic label contraindicates.' ;
     precondition ::active_pathological_bleeding = "no";
     component :: 'Advise_Avoid_Chronic_NSAIDs' ;
          caption :: 'Advise avoiding chronic NSAID use' ;
          description :: 'Rec 10 [3: Harm, B-R]: in CCD, chronic NSAIDs should not be used because of increased cardiovascular and bleeding complications. Modelled as an advice step that always completes at the start of the therapy plan, so every drug action can follow it.' ;
          metaprops :: 'ontology.coding=SCT\\:372665008 [Non-steroidal anti-inflammatory agent (substance)]
' ;
          task_definition :: 'Advise_Avoid_Chronic_NSAIDs' ;
          ltwh :: 40,40,0,0;
     component :: 'P2Y12_Agent_Decision' ;
          caption :: 'Choose the P2Y12 inhibitor' ;
          description :: 'Chooses the P2Y12 inhibitor for every regimen that contains one besides clopidogrel monotherapy. Assistant-proposed rule (approved open question 2): clopidogrel after PCI or with a DOAC (Recs 2, 11), ticagrelor after MI (Rec 4 evidence, PEGASUS, 60 mg twice daily), prasugrel only after ACS treated with PCI (label indication), excluded after stroke, TIA or ICH (Rec 9) and argued against at age 75 or older. Single choice with the default recommendation netsupport() > 0.' ;
          task_definition :: 'P2Y12_Agent_Decision' ;
          schedule_constraint :: completed('Advise_Avoid_Chronic_NSAIDs') ;
          ltwh :: 40,140,0,0;
     component :: 'Prescribe_Aspirin' ;
          caption :: 'Prescribe low-dose aspirin 81 mg once daily' ;
          description :: 'Rec 1 [1, A] recommends low-dose aspirin 81 mg (75-100 mg) to reduce atherosclerotic events in CCD without an oral anticoagulant indication. Aspirin is also part of every DAPT, vorapaxar and low-dose rivaroxaban regimen and of the short triple therapy with a DOAC after PCI (Recs 2-4, 11, 12, 15), so it is delivered for every regimen that contains it.' ;
          metaprops :: 'ontology.coding=SCT\\:387458008 [Aspirin (substance)]
' ;
          task_definition :: 'Prescribe_Aspirin' ;
          schedule_constraint :: completed('Advise_Avoid_Chronic_NSAIDs') ;
          ltwh :: 40,240,0,0;
     component :: 'Prescribe_Clopidogrel' ;
          caption :: 'Prescribe clopidogrel 75 mg once daily' ;
          description :: 'Rec 2 [1, A] (DAPT with aspirin for 6 months after PCI, then single antiplatelet therapy), Rec 11 [1, B-R] (with a DOAC for 6 months after PCI) and supportive text 1 (alternative to aspirin when aspirin is not tolerated). Runs after both the NSAID advice and the P2Y12 decision, so it still runs on the clopidogrel-monotherapy path where that decision is discarded.' ;
          metaprops :: 'ontology.coding=SCT\\:386952008 [Clopidogrel (substance)]
' ;
          task_definition :: 'Prescribe_Clopidogrel' ;
          schedule_constraint :: completed('Advise_Avoid_Chronic_NSAIDs') ;
          schedule_constraint :: completed('P2Y12_Agent_Decision') ;
          ltwh :: 40,340,0,0;
