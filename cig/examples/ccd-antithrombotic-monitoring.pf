decision  :: 'Antithrombotic_Regimen_Decision' ;
     caption :: 'Choose the antithrombotic regimen' ;
     description :: 'Chooses the antithrombotic regimen for a patient with CCD along the Figure 9 pathways and §4.3.1 Recs 1-16. Single choice with the default recommendation netsupport() > 0: several candidates can be recommended at once (for example the 2a/2b add-on options after MI) and the clinician commits one. Section 4.3.1 defers bare-metal stents to the 2016 AHA/ACC DAPT guideline, so no candidate is recommended for PCI with high bleeding risk and a bare-metal stent.' ;
     candidate :: 'Aspirin_Monotherapy' ;
          caption :: 'Aspirin 81 mg monotherapy' ;
          description :: 'Rec 1 and Figure 9: no indication for oral anticoagulation and no PCI, ACS or CABG in the past 12 months, with aspirin tolerated.' ;
          argument :: for,requires_oral_anticoagulation = "no" and pci_within_12_months = "no" and acs_within_12_months = "no" and cabg_within_12_months = "no" and aspirin_intolerance = "no" attributes
               argument_name :: 'Arg_Aspirin_SAPT' ;
               caption :: 'Rec 1 [1, A]; Figure 9: no oral anticoagulant indication, no PCI, ACS or CABG in the past 12 months, aspirin tolerated' ;
               metaprops :: 'quote.1=p.e50, Rec 1\\: "low-dose aspirin 81 mg (75-100 mg) is recommended to reduce atherosclerotic events"
quote.2=p.e51, Figure 9 (figure labels)\\: "No PCI or >12 mo from ACS ... Aspirin"
source.1=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 1 (p.e50)
source.2=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Figure 9 (p.e51)
' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'Clopidogrel_Monotherapy' ;
          caption :: 'Clopidogrel 75 mg monotherapy' ;
          description :: 'Supportive text 1: clopidogrel as the alternative single antiplatelet when aspirin is not tolerated.' ;
          argument :: for,requires_oral_anticoagulation = "no" and pci_within_12_months = "no" and acs_within_12_months = "no" and aspirin_intolerance = "yes" attributes
               argument_name :: 'Arg_Clopidogrel_SAPT' ;
               caption :: 'Supportive text 1 [no COR/LOE]: aspirin not tolerated, no oral anticoagulant indication, no PCI or ACS in the past 12 months' ;
               metaprops :: 'quote=p.e51, text 1\\: "As an alternative to low-dose aspirin, clopidogrel may be used in individuals who cannot tolerate aspirin therapy"
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 supportive text 1 (p.e51)
' ;
          end attributes
