          caption :: 'Serum magnesium' ;
          metaprops :: 'ontology.coding=LNC\\:19123-9 [Magnesium [Mass/volume] in Serum or Plasma]
' ;
          argument :: for,true() attributes
               argument_name :: 'Arg_Order_Serum_Magnesium' ;
               caption :: 'Serum magnesium when cramps, tremor, palpitations or seizures suggest hypomagnesemia **CHANGED (R5)**' ;
          end attributes
          ;
