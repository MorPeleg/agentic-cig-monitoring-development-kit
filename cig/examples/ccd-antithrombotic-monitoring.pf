plan  :: 'Monitoring_Plan' ;
     caption :: 'Monitor antithrombotic therapy' ;
     description :: 'Monitors completion of the antithrombotic recommendations, the desired outcome and the adverse drug effects, in three parallel sub-plans.' ;
     component :: 'Monitor_Actions' ;
          task_definition :: 'Monitor_Actions' ;
          ltwh :: 40,40,0,0;
     component :: 'Monitor_Desired_State' ;
          task_definition :: 'Monitor_Desired_State' ;
          ltwh :: 40,140,0,0;
     component :: 'Monitor_Undesired_State' ;
          task_definition :: 'Monitor_Undesired_State' ;
          ltwh :: 40,240,0,0;
end plan.


data  :: 'requires_oral_anticoagulation' ;
     type :: boolean ;
     caption :: 'Does the patient have an indication for long-term oral anticoagulation (e.g. atrial fibrillation)?' ;
     description :: 'Indication for long-term oral anticoagulation (e.g. atrial fibrillation). Separates the regimens without an oral anticoagulant (Recs 1-10, 15) from those with a DOAC (Recs 11-14). The SNOMED CT concept records current use of an anticoagulant, not the indication.' ;
     metaprops :: 'ontology.coding=SNOMED\\:711150003
ontology.label=Long-term current use of anticoagulant (situation)
quote=p.e50, Rec 1\\: "In patients with CCD and no indication for oral anticoagulant therapy, low-dose aspirin 81 mg (75-100 mg) is recommended"
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 1 (p.e50)
' ;
end data.

data  :: 'pci_within_12_months' ;
     type :: boolean ;
     caption :: 'PCI within the past 12 months?' ;
     description :: 'Percutaneous coronary intervention within the past 12 months; the PCI-related DAPT and DOAC-plus-antiplatelet pathways of Figure 9 apply in this window. The 12-month window is held in the data-item logic; the SNOMED CT concept records a history of PCI.' ;
     metaprops :: 'ontology.coding=SNOMED\\:405741001
ontology.label=History of percutaneous coronary intervention (situation)
quote=p.e50, Rec 2\\: "In patients with CCD treated with PCI, dual antiplatelet therapy (DAPT) consisting of aspirin and clopidogrel for 6 months post PCI"
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 2 (p.e50)
' ;
end data.

data  :: 'des_implanted' ;
     type :: boolean ;
     caption :: 'Was a drug-eluting stent implanted at that PCI?' ;
     description :: 'A drug-eluting stent was implanted at the recent PCI; required for the short-DAPT then P2Y12-monotherapy option of Rec 3.' ;
     metaprops :: 'ontology.coding=SNOMED\\:705637003
ontology.label=Drug-eluting coronary artery stent (physical object)
quote=p.e50, Rec 3\\: "In select patients with CCD treated with PCI and a drug-eluting stent (DES) who have completed a 1- to 3-month course of DAPT"
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 3 (p.e50)
' ;
end data.

data  :: 'acs_within_12_months' ;
     type :: boolean ;
     caption :: 'Acute coronary syndrome within the past 12 months?' ;
     description :: 'Acute coronary syndrome within the past 12 months; recent ACS is an indication for DAPT (Figure 9) and an acute indication for antiplatelet therapy alongside a DOAC (Rec 14).' ;
     metaprops :: 'ontology.coding=SNOMED\\:394659003
ontology.label=Acute coronary syndrome (disorder)
quote=p.e50, Rec 7\\: "In patients with CCD without recent ACS or a PCI-related indication for DAPT"
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 7 (p.e50)
' ;
end data.

data  :: 'cabg_within_12_months' ;
     type :: boolean ;
     caption :: 'CABG within the past 12 months?' ;
     description :: 'Coronary artery bypass grafting within the past 12 months. Rec 6 gives no DAPT duration after CABG; the first postoperative year is used (approved open question 1).' ;
     metaprops :: 'ontology.coding=SNOMED\\:232717009
ontology.label=Coronary artery bypass grafting (procedure)
quote=p.e50, Rec 6\\: "the use of DAPT after CABG may be useful to reduce the incidence of saphenous vein graft occlusion"
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 6 (p.e50)
' ;
end data.

data  :: 'previous_mi' ;
     type :: boolean ;
     caption :: 'History of myocardial infarction?' ;
     description :: 'History of myocardial infarction; the population of extended DAPT (Rec 4), vorapaxar (Rec 5) and ticagrelor 60 mg (PEGASUS).' ;
     metaprops :: 'ontology.coding=SNOMED\\:1755008
ontology.label=Old myocardial infarction (disorder)
quote=p.e50, Rec 4\\: "In patients with CCD who have had a previous MI and are at low bleeding risk"
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 4 (p.e50)
' ;
end data.

data  :: 'prior_stroke_or_tia' ;
     type :: boolean ;
     caption :: 'History of ischemic stroke or TIA?' ;
     description :: 'History of ischemic stroke or transient ischemic attack; excludes vorapaxar (Rec 8) and prasugrel (Rec 9). The SNOMED CT concept covers cerebrovascular accident; TIA is a separate concept (161511000) not coded here.' ;
     metaprops :: 'ontology.coding=SNOMED\\:275526006
ontology.label=History of cerebrovascular accident (situation)
quote=p.e50, Rec 9\\: "In patients with CCD and previous stroke, TIA, or ICH, prasugrel should not be used"
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 9 (p.e50)
' ;
end data.

data  :: 'prior_ich' ;
     type :: boolean ;
     caption :: 'History of intracranial hemorrhage?' ;
     description :: 'History of intracranial hemorrhage; excludes vorapaxar (Rec 8), prasugrel (Rec 9) and ticagrelor (BRILINTA §4.1).' ;
     metaprops :: 'ontology.coding=SNOMED\\:16864911000119103
ontology.label=History of intracranial hemorrhage (situation)
quote=\\u00A74.1\\: "BRILINTA is contraindicated in patients with a history of intracranial hemorrhage (ICH) because of a high risk of recurrent ICH in this population"
source=BRILINTA (ticagrelor) US Prescribing Information 2026, \\u00A74.1
' ;
end data.

data  :: 'high_bleeding_risk' ;
     type :: boolean ;
     caption :: 'High bleeding risk (validated score such as PRECISE-DAPT, DAPT or PARIS, or clinical judgment)?' ;
     description :: 'High bleeding risk, assessed with a validated score (PRECISE-DAPT, DAPT or PARIS) or clinical judgment; steers the choice and duration of antiplatelet therapy (Synopsis; Recs 3, 4, 12, 15).' ;
     metaprops :: 'ontology.coding=SNOMED\\:711536002
ontology.label=At high risk for bleeding (finding)
quote=p.e50, Synopsis\\: "The use of validated risk scores to address bleeding risk can be useful in choice and duration of antiplatelet therapy."
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Synopsis (p.e50)
' ;
end data.

data  :: 'high_thrombotic_risk' ;
     type :: boolean ;
     caption :: 'High risk of recurrent ischemic events (e.g. multivessel CAD with diabetes, recurrent MI, PAD, HF or CKD, or complex PCI)?' ;
     description :: 'High risk of recurrent ischemic events (the COMPASS definition: multivessel CAD with diabetes requiring medication, recurrent MI, PAD, HF or CKD; or complex PCI features). The SNOMED CT concept is the nearest match (increased risk for cardiovascular event).' ;
     metaprops :: 'ontology.coding=SNOMED\\:395112001
ontology.label=At increased risk for cardiovascular event (finding)
quote=p.e55, text 15\\: "multivessel CAD and at least one of the following\\: diabetes requiring medication, recurrent MI, peripheral artery disease, HF, or CKD"
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 supportive text 15 (p.e55)
' ;
end data.

data  :: 'aspirin_intolerance' ;
     type :: boolean ;
     caption :: 'Aspirin allergy or intolerance (incl. NSAID hypersensitivity or the asthma-rhinitis-nasal polyps syndrome)?' ;
     description :: 'Aspirin allergy or intolerance, including NSAID hypersensitivity and the asthma-rhinitis-nasal polyps syndrome; selects clopidogrel monotherapy instead of aspirin. The SNOMED CT concept covers aspirin allergy only, not intolerance.' ;
     metaprops :: 'ontology.coding=SNOMED\\:293586001
ontology.label=Allergy to aspirin (finding)
quote=p.e51, text 1\\: "As an alternative to low-dose aspirin, clopidogrel may be used in individuals who cannot tolerate aspirin therapy"
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 supportive text 1 (p.e51)
' ;
end data.

data  :: 'active_pathological_bleeding' ;
     type :: boolean ;
     caption :: 'Active pathological bleeding (e.g. peptic ulcer, intracranial hemorrhage)?' ;
     description :: 'Active pathological bleeding such as a peptic ulcer or intracranial hemorrhage; every antithrombotic label contraindicates it, so it gates the whole therapy plan. Shares its SNOMED CT concept with Monitor_Bleeding.' ;
     metaprops :: 'ontology.coding=SNOMED\\:131148009
ontology.label=Bleeding (finding)
quote=\\u00A74.1\\: "Plavix is contraindicated in patients with active pathological bleeding such as peptic ulcer or intracranial hemorrhage."
source=PLAVIX (clopidogrel) US Prescribing Information 2025, \\u00A74.1
' ;
end data.

data  :: 'age_years' ;
     type :: integer ;
     caption :: 'Age' ;
     description :: 'Age in years; prasugrel is generally not recommended at 75 years or older (EFFIENT Boxed Warning).' ;
     metaprops :: 'ontology.coding=SNOMED\\:424144002
ontology.label=Current chronological age (observable entity)
quote=Boxed Warning\\: "In patients \\u226575 years of age, Effient is generally not recommended, because of the increased risk of fatal and intracranial bleeding and uncertain benefit"
source=EFFIENT (prasugrel) US Prescribing Information 2022, Boxed Warning
' ;
     unit :: 'years' ;
end data.

data  :: 'on_digoxin_or_diuretic' ;
     type :: boolean ;
     caption :: 'Taking digoxin or a diuretic?' ;
     description :: 'Taking digoxin or a diuretic (drugs that may cause hypomagnesemia); widens magnesium monitoring on pantoprazole to the short-DAPT regimen (PROTONIX §5.8). A composite flag with no single SNOMED CT concept, so it is left uncoded.' ;
     metaprops :: 'quote=\\u00A75.8\\: "For patients expected to be on prolonged treatment or who take PPIs with medications such as digoxin or drugs that may cause hypomagnesemia (e.g., diuretics)"
source=PROTONIX (pantoprazole) US Prescribing Information 2026, \\u00A75.8
' ;
end data.

data  :: 'unusual_bleeding_or_bruising' ;
     type :: boolean ;
     caption :: 'Unusual, prolonged or excessive bleeding or bruising since the last visit?' ;
     description :: 'Unusual, prolonged or excessive bleeding or bruising reported by the patient. Asked by Monitor_Bleeding. The SNOMED CT concept is broader (any bleeding).' ;
     metaprops :: 'ontology.coding=SNOMED\\:131148009
ontology.label=Bleeding (finding)
' ;
end data.

data  :: 'hematuria' ;
     type :: boolean ;
     caption :: 'Blood in the urine since the last visit?' ;
     description :: 'Blood in the urine reported by the patient. Asked by Monitor_Bleeding and Monitor_PPI_Interstitial_Nephritis.' ;
     metaprops :: 'ontology.coding=SNOMED\\:34436003
ontology.label=Blood in urine (finding)
' ;
end data.

data  :: 'blood_in_stool' ;
     type :: boolean ;
     caption :: 'Red or black tarry stools since the last visit?' ;
     description :: 'Red or black tarry stools reported by the patient, a sign of gastrointestinal bleeding. Asked by Monitor_Bleeding. The SNOMED CT concept is broader (gastrointestinal hemorrhage, of which red or black stools are a sign).' ;
     metaprops :: 'ontology.coding=SNOMED\\:74474003
ontology.label=Gastrointestinal hemorrhage (disorder)
' ;
end data.

data  :: 'hematemesis' ;
     type :: boolean ;
     caption :: 'Vomiting blood or coffee-ground material since the last visit?' ;
     description :: 'Vomiting of blood or coffee-ground material reported by the patient. Asked by Monitor_Bleeding.' ;
     metaprops :: 'ontology.coding=SNOMED\\:8765009
ontology.label=Hematemesis (disorder)
' ;
end data.

data  :: 'hemoptysis' ;
     type :: boolean ;
     caption :: 'Coughing up blood since the last visit?' ;
     description :: 'Coughing up blood reported by the patient. Asked by Monitor_Bleeding.' ;
     metaprops :: 'ontology.coding=SNOMED\\:66857006
ontology.label=Hemoptysis (finding)
' ;
end data.

data  :: 'syncope' ;
     type :: boolean ;
     caption :: 'Fainting since the last visit?' ;
     description :: 'Fainting (syncope) reported by the patient. Asked by Monitor_Bleeding and Monitor_Ticagrelor_Bradyarrhythmia.' ;
     metaprops :: 'ontology.coding=SNOMED\\:271594007
ontology.label=Syncope (finding)
' ;
end data.

data  :: 'sudden_severe_headache' ;
     type :: boolean ;
     caption :: 'Sudden severe headache since the last visit?' ;
     description :: 'Sudden severe headache reported by the patient, a possible sign of intracranial bleeding. Asked by Monitor_Bleeding.' ;
     metaprops :: 'ontology.coding=SNOMED\\:95660002
ontology.label=Thunderclap headache (disorder)
' ;
end data.

data  :: 'systolic_bp' ;
     type :: real ;
     caption :: 'Systolic blood pressure at this visit (mmHg)' ;
     description :: 'Systolic blood pressure measured at the visit; a low value (below 90 mmHg) is unexplained hypotension that may signal bleeding. Asked by Monitor_Bleeding.' ;
     metaprops :: 'ontology.coding=SNOMED\\:271649006
ontology.label=Systolic blood pressure (observable entity)
' ;
     unit :: 'mmHg' ;
end data.

data  :: 'diastolic_bp' ;
     type :: real ;
     caption :: 'Diastolic blood pressure at this visit (mmHg)' ;
     description :: 'Diastolic blood pressure measured at the visit, recorded with the systolic value. Asked by Monitor_Bleeding.' ;
     metaprops :: 'ontology.coding=SNOMED\\:271650006
ontology.label=Diastolic blood pressure (observable entity)
' ;
     unit :: 'mmHg' ;
end data.

data  :: 'new_medication_started' ;
     type :: boolean ;
     caption :: 'Has a new medicine been started since the last visit?' ;
     description :: 'A new prescription, over-the-counter medicine or herbal product started since the last visit. Asked by Monitor_Drug_Interactions.' ;
     metaprops :: 'ontology.coding=SNOMED\\:266712008
ontology.label=New medication commenced (finding)
' ;
end data.

data  :: 'on_omeprazole_or_esomeprazole' ;
     type :: boolean ;
     caption :: 'Taking omeprazole or esomeprazole?' ;
     description :: 'Current use of omeprazole or esomeprazole, which reduce the antiplatelet effect of clopidogrel. Asked by Monitor_Drug_Interactions. The SNOMED CT concept is broader (any PPI therapy).' ;
     metaprops :: 'ontology.coding=SNOMED\\:870251000
ontology.label=Proton pump inhibitor therapy (procedure)
' ;
end data.

data  :: 'aspirin_dose_over_100_mg' ;
     type :: boolean ;
     caption :: 'Taking more than 100 mg of aspirin a day?' ;
     description :: 'A daily aspirin dose above 100 mg, which reduces the effect of ticagrelor. Asked by Monitor_Drug_Interactions. The SNOMED CT concept is the nearest match (aspirin therapy); there is no dose concept.' ;
     metaprops :: 'ontology.coding=SNOMED\\:717854002
ontology.label=Aspirin therapy (procedure)
' ;
end data.

data  :: 'on_strong_cyp3a_or_pgp_modulator' ;
     type :: boolean ;
     caption :: 'Taking a strong CYP3A or P-gp inhibitor or inducer?' ;
     description :: 'Current use of a strong CYP3A or P-gp inhibitor or inducer, which changes exposure to ticagrelor, vorapaxar and the DOACs. Asked by Monitor_Drug_Interactions. The SNOMED CT concept is the nearest match (cytochrome P450 inhibitor).' ;
     metaprops :: 'ontology.coding=SNOMED\\:735424007
ontology.label=Cytochrome P450 inhibitor (disposition)
' ;
end data.

data  :: 'on_ssri_or_snri' ;
     type :: boolean ;
     caption :: 'Taking an SSRI or SNRI?' ;
     description :: 'Current use of a selective serotonin or serotonin-norepinephrine re-uptake inhibitor, which adds bleeding risk. Asked by Monitor_Drug_Interactions. The SNOMED CT concept covers SSRIs only.' ;
     metaprops :: 'ontology.coding=SNOMED\\:373225007
ontology.label=Selective serotonin re-uptake inhibitor
' ;
end data.

data  :: 'on_other_anticoagulant' ;
     type :: boolean ;
     caption :: 'Taking another anticoagulant?' ;
     description :: 'Current use of another anticoagulant, which adds bleeding risk. Asked by Monitor_Drug_Interactions.' ;
     metaprops :: 'ontology.coding=SNOMED\\:711150003
ontology.label=Long-term current use of anticoagulant (situation)
' ;
end data.

data  :: 'on_digoxin' ;
     type :: boolean ;
     caption :: 'Taking digoxin?' ;
     description :: 'Current use of digoxin, whose level is monitored when ticagrelor is started or changed. Asked by Monitor_Drug_Interactions. The SNOMED CT concept is the substance.' ;
     metaprops :: 'ontology.coding=SNOMED\\:387461009
ontology.label=Digoxin (substance)
' ;
end data.

data  :: 'neuraxial_procedure_performed' ;
     type :: boolean ;
     caption :: 'Has neuraxial anesthesia or a spinal puncture been performed during anticoagulant therapy?' ;
     description :: 'Neuraxial anesthesia or spinal puncture performed during anticoagulant therapy, the event that triggers frequent neurological checks. Asked by Monitor_Spinal_Epidural_Hematoma.' ;
     metaprops :: 'ontology.coding=SNOMED\\:405650006
ontology.label=Neuraxial nerve block (procedure)
' ;
end data.

data  :: 'back_pain' ;
     type :: boolean ;
     caption :: 'Back pain after the epidural or spinal procedure?' ;
     description :: 'Back pain after a neuraxial procedure. Asked by Monitor_Spinal_Epidural_Hematoma.' ;
     metaprops :: 'ontology.coding=SNOMED\\:161891005
ontology.label=Backache (finding)
' ;
end data.

data  :: 'leg_numbness_or_tingling' ;
     type :: boolean ;
     caption :: 'Numbness or tingling of the legs after the epidural or spinal procedure?' ;
     description :: 'Numbness or tingling of the legs after a neuraxial procedure. Asked by Monitor_Spinal_Epidural_Hematoma. The SNOMED CT concept covers only numbness, not tingling.' ;
     metaprops :: 'ontology.coding=SNOMED\\:309537005
ontology.label=Numbness of lower limb (finding)
' ;
end data.

data  :: 'leg_weakness' ;
     type :: boolean ;
     caption :: 'Weakness of the legs after the epidural or spinal procedure?' ;
     description :: 'Weakness of the legs after a neuraxial procedure. Asked by Monitor_Spinal_Epidural_Hematoma.' ;
     metaprops :: 'ontology.coding=SNOMED\\:1137412000
ontology.label=Weakness of muscle of lower limb (finding)
' ;
end data.

data  :: 'bowel_or_bladder_dysfunction' ;
     type :: boolean ;
     caption :: 'Bowel or bladder problems after the epidural or spinal procedure?' ;
     description :: 'Bowel or bladder dysfunction after a neuraxial procedure. Asked by Monitor_Spinal_Epidural_Hematoma. The SNOMED CT concept covers the bowel part only.' ;
     metaprops :: 'ontology.coding=SNOMED\\:235594008
ontology.label=Bowel dysfunction (disorder)
' ;
end data.

data  :: 'planned_surgery_or_invasive_procedure' ;
     type :: boolean ;
     caption :: 'Is surgery, CABG or an invasive or dental procedure planned?' ;
     description :: 'A planned surgery, CABG or invasive or dental procedure, the event that triggers the perioperative antithrombotic plan. Asked by Monitor_Perioperative_Interruption.' ;
     metaprops :: 'ontology.coding=SNOMED\\:405613005
ontology.label=Planned procedure (situation)
' ;
end data.

data  :: 'urgent_cabg_likely' ;
     type :: boolean ;
     caption :: 'Is urgent CABG likely?' ;
     description :: 'Urgent CABG is likely, in which case prasugrel or ticagrelor should not be started. Asked by Monitor_Perioperative_Interruption. The SNOMED CT concept is the nearest match (emergency CABG).' ;
     metaprops :: 'ontology.coding=SNOMED\\:414088005
ontology.label=Emergency CABG
' ;
end data.

data  :: 'renal_function_check_due' ;
     type :: boolean ;
     caption :: 'Is a renal function check due (baseline, or 12 months since the last one)?' ;
     description :: 'The scheduled renal function test is due: at baseline before starting, then at least every 12 months. Asked by Monitor_Renal_Function. The SNOMED CT concept is the nearest match (renal function monitoring).' ;
     metaprops :: 'ontology.coding=SNOMED\\:182809008
ontology.label=Renal function monitoring (regime/therapy)
' ;
end data.

data  :: 'vomiting_or_diarrhea' ;
     type :: boolean ;
     caption :: 'Vomiting or diarrhea since the last visit?' ;
     description :: 'Vomiting or diarrhea reported by the patient, which may reduce renal function. Asked by Monitor_Renal_Function. The SNOMED CT concept covers only the combined finding of diarrhea and vomiting, not either one alone.' ;
     metaprops :: 'ontology.coding=SNOMED\\:249519007
ontology.label=Diarrhea and vomiting (finding)
' ;
end data.

data  :: 'dehydration' ;
     type :: boolean ;
     caption :: 'Is the patient dehydrated?' ;
     description :: 'Dehydration, which may reduce renal function. Asked by Monitor_Renal_Function.' ;
     metaprops :: 'ontology.coding=SNOMED\\:34095006
ontology.label=Dehydration (disorder)
' ;
end data.

data  :: 'new_nephrotoxic_medication' ;
     type :: boolean ;
     caption :: 'Has a new medicine that can affect the kidneys been started?' ;
     description :: 'A new nephrotoxic medicine started since the last visit. Asked by Monitor_Renal_Function. The SNOMED CT concept is broader (any new medication).' ;
     metaprops :: 'ontology.coding=SNOMED\\:266712008
ontology.label=New medication commenced (finding)
' ;
end data.

data  :: 'acute_illness' ;
