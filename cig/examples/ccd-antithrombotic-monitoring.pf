' ;
     precondition ::ischemic_event_on_clopidogrel = "yes" and cyp2c19_status = "unknown";
     procedure :: 'Order CYP2C19 genotype when an ischemic event occurs on clopidogrel and the CYP2C19 status is unknown.' ;
end action.

enquiry  :: 'Monitor_Antiplatelet_Hypersensitivity' ;
     caption :: 'Monitor for antiplatelet hypersensitivity reactions' ;
     description :: 'Monitors hypersensitivity reactions to Prescribe_Aspirin, Prescribe_Clopidogrel, Prescribe_Prasugrel and Prescribe_Ticagrelor. The aspirin label warns of severe allergic reactions and says to stop use and seek help, and the clopidogrel, prasugrel and ticagrelor labels list hypersensitivity and angioedema, with cross-reactivity between thienopyridines. Order: antiplatelet hypersensitivity reaction review (hives, angioedema, bronchospasm, rash, hematologic reaction), symptom-triggered, with an allergy question at each follow-up visit after starting or switching an antiplatelet. Patient: stop the medicine and seek medical help right away for hives, swelling of the face, lips or throat, wheezing or a widespread rash. Clinician: if a hypersensitivity reaction occurs, stop the culprit drug, treat the reaction and choose an alternative antiplatelet, noting cross-reactivity between thienopyridines (clopidogrel, prasugrel, ticlopidine).' ;
     metaprops :: 'ServiceRequest.code=antiplatelet hypersensitivity reaction review (hives, angioedema, bronchospasm, rash, hematologic reaction)
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=symptom-triggered, with an allergy question at each follow-up visit after starting or switching an antiplatelet
ServiceRequest.patientInstruction=stop the medicine and seek medical help right away for hives, swelling of the face, lips or throat, wheezing or a widespread rash
ServiceRequest.performerInstruction=if a hypersensitivity reaction occurs, stop the culprit drug, treat the reaction and choose an alternative antiplatelet, noting cross-reactivity between thienopyridines (clopidogrel, prasugrel, ticlopidine)
applies_when=all_patients_on_therapy
assistant_invention=grouping the four antiplatelet hypersensitivity warnings into one symptom-triggered task
category=undesired_ade
cq=CQ3, CQ5
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= antiplatelet hypersensitivity reaction review (hives, angioedema, bronchospasm, rash, hematologic reaction); ServiceRequest.occurrenceTiming \\= symptom-triggered, with an allergy question at each follow-up visit after starting or switching an antiplatelet; ServiceRequest.patientInstruction \\= stop the medicine and seek medical help right away for hives, swelling of the face, lips or throat, wheezing or a widespread rash; ServiceRequest.performerInstruction \\= if a hypersensitivity reaction occurs, stop the culprit drug, treat the reaction and choose an alternative antiplatelet, noting cross-reactivity between thienopyridines (clopidogrel, prasugrel, ticlopidine)
goal.verb=order
guideline_status=not_specified_as_a_guideline_monitoring_task
instrument=patient symptom report with clinician examination
knowledge_origin=aspirin allergy alert and thienopyridine and ticagrelor hypersensitivity sections
literature_basis=the aspirin label warns of severe allergic reactions and says to stop use and seek help, and the clopidogrel, prasugrel and ticagrelor labels list hypersensitivity and angioedema, with cross-reactivity between thienopyridines
monitored_target=hypersensitivity reactions to Prescribe_Aspirin, Prescribe_Clopidogrel, Prescribe_Prasugrel and Prescribe_Ticagrelor
monitoring_frequency_basis=symptom-triggered because reactions are acute
monitoring_stance=symptom_triggered_only
provenance_type=package_insert_specified
quote.1=Allergy alert\\: "Aspirin may cause a severe allergic reaction, which may include\\: hives facial swelling shock asthma (wheezing)"
quote.2=\\u00A75.5\\: "Hypersensitivity including rash, angioedema or hematologic reaction has been reported in patients receiving Plavix"
quote.3=\\u00A75.5\\: "Hypersensitivity including angioedema has been reported in patients receiving Effient, including patients with a history of hypersensitivity reaction to other thienopyridines"
quote.4=\\u00A74.3\\: "BRILINTA is contraindicated in patients with hypersensitivity (e.g., angioedema) to ticagrelor or any component of the product."
source.1=Low Dose Aspirin 81 mg OTC Drug Facts label 2026, Allergy alert
source.2=PLAVIX (clopidogrel) US Prescribing Information 2025, \\u00A75.5
source.3=EFFIENT (prasugrel) US Prescribing Information 2022, \\u00A75.5
source.4=BRILINTA (ticagrelor) US Prescribing Information 2026, \\u00A74.3
source_kind=package_insert
trigger=hives, facial or throat swelling, wheezing or a widespread rash
' ;
     precondition ::result_of(Antithrombotic_Regimen_Decision) = Aspirin_Monotherapy or result_of(Antithrombotic_Regimen_Decision) = Clopidogrel_Monotherapy or result_of(Antithrombotic_Regimen_Decision) = DAPT or result_of(Antithrombotic_Regimen_Decision) = Short_DAPT_then_P2Y12_Monotherapy or result_of(Antithrombotic_Regimen_Decision) = Extended_DAPT or result_of(Antithrombotic_Regimen_Decision) = Aspirin_plus_Vorapaxar or result_of(Antithrombotic_Regimen_Decision) = Aspirin_plus_Low_Dose_Rivaroxaban or result_of(Antithrombotic_Regimen_Decision) = DOAC_plus_Antiplatelet;
     source :: 'facial_or_throat_swelling' ;
          data_definition :: 'facial_or_throat_swelling' ;
          mandatory :: no ;
     source :: 'hives' ;
          data_definition :: 'hives' ;
          mandatory :: no ;
     source :: 'suspected_antiplatelet_hypersensitivity' ;
          data_definition :: 'suspected_antiplatelet_hypersensitivity' ;
          mandatory :: no ;
     source :: 'wheezing' ;
          data_definition :: 'wheezing' ;
          mandatory :: no ;
     source :: 'widespread_rash' ;
          data_definition :: 'widespread_rash' ;
          mandatory :: no ;
end enquiry.

action  :: 'Alert_Further_Examination_Antiplatelet_Hypersensitivity' ;
     caption :: 'Alert: further examination of antiplatelet hypersensitivity reaction' ;
     description :: 'Monitors suspected antiplatelet hypersensitivity reaction recorded by Monitor_Antiplatelet_Hypersensitivity (hypersensitivity reactions to Prescribe_Aspirin, Prescribe_Clopidogrel, Prescribe_Prasugrel and Prescribe_Ticagrelor). The clopidogrel and prasugrel labels report hypersensitivity including rash, angioedema or hematologic reaction, and the labels name no laboratory or imaging test to confirm it. The sources name no test, so, following Mor Peleg\'s know-how of 4 Nov 2026, this step alerts the clinician to examine the patient further and decide on work-up instead of ordering a test.' ;
     metaprops :: 'ServiceRequest.code=further clinical examination for suspected antiplatelet hypersensitivity reaction
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=event-triggered, at the monitoring visit when an antiplatelet hypersensitivity reaction is suspected
ServiceRequest.patientInstruction=attend the examination and report any hives, swelling of the face, lips or throat, wheezing or a widespread rash
ServiceRequest.performerInstruction=examine the patient for an antiplatelet hypersensitivity reaction and decide on further work-up, stopping the culprit drug and choosing an alternative antiplatelet if it is confirmed (the sources name no specific test, so none is ordered)
