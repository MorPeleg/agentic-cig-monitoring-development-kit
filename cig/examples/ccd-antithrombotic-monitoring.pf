end action.

plan  :: 'Monitor_Undesired_State' ;
     caption :: 'Monitor adverse drug effects' ;
     description :: 'State Achievement monitoring of the adverse drug effects of the antithrombotics and of pantoprazole, from the label Boxed Warnings and Warnings and Precautions.' ;
     component :: 'Display_Potential_ADEs' ;
          caption :: '# *Monitoring for ADEs:*  
1. Bleeding  
2. Drug interactions  
3. Spinal or epidural hematoma  
4. Perioperative bleeding and thrombosis  
5. Renal function (anticoagulant dosing)  
6. Thrombotic thrombocytopenic purpura  
7. Reduced clopidogrel effect (CYP2C19 poor metabolizer)  
8. Antiplatelet hypersensitivity  
9. Dyspnea (ticagrelor)  
10. Bradyarrhythmia (ticagrelor)  
11. Central sleep apnea (ticagrelor)  
12. C. difficile-associated diarrhea (PPI)  
13. Hypomagnesemia (PPI)  
14. Bone fracture (PPI)  
15. Acute interstitial nephritis (PPI)  
16. Cutaneous lupus erythematosus (PPI)  
17. Severe cutaneous reactions (PPI)  ' ;
          description :: 'Lists the adverse drug effects monitored in Monitor_Undesired_State; each is assessed by the Enquiry of the same name.' ;
          task_definition :: 'Display_Potential_ADEs' ;
          ltwh :: 40,40,0,0;
     component :: 'Monitor_Bleeding' ;
          caption :: 'Monitor for bleeding (symptom review, Hb/Hct on suspicion)' ;
          description :: 'Monitors bleeding, including gastrointestinal and intracranial bleeding, as an adverse effect of Prescribe_Aspirin, Prescribe_Clopidogrel, Prescribe_Ticagrelor, Prescribe_Prasugrel, Prescribe_Vorapaxar, Prescribe_Low_Dose_Rivaroxaban and Prescribe_DOAC (and the avoid goal of Prescribe_PPI). The guideline names GI bleeding as a common side effect of DAPT, every antithrombotic label warns of serious bleeding and tells clinicians to promptly evaluate signs of blood loss, the P2Y12 labels say to manage bleeding without stopping when possible, and the DOAC labels say their effect cannot be monitored with standard coagulation tests. Order: bleeding symptom review with hemoglobin and hematocrit on suspected blood loss, each follow-up visit, with same-day evaluation of bleeding symptoms or unexplained hypotension. Patient: report any unusual, prolonged or excessive bleeding or bruising, blood in the urine, red or black tarry stools, vomiting blood or coffee-ground material, coughing up blood, fainting or a sudden severe headache, and seek emergency care for heavy bleeding. Clinician: promptly evaluate signs of blood loss with hemoglobin and hematocrit, suspect bleeding in any hypotensive patient after angiography, PCI, CABG or surgery, stop an anticoagulant for active pathological bleeding, manage antiplatelet-related bleeding without stopping the antiplatelet when possible, and do not use PT, INR, aPTT or anti-factor Xa levels to monitor a DOAC.' ;
          metaprops :: 'ontology.coding=SCT\\:131148009 [Bleeding (finding)]
' ;
          task_definition :: 'Monitor_Bleeding' ;
          schedule_constraint :: completed('Display_Potential_ADEs') ;
          ltwh :: 40,140,0,0;
     component :: 'Tests_Ordering_Recommendations_Bleeding' ;
          caption :: 'Which tests to order for suspected bleeding?' ;
          description :: 'When a bleeding symptom or unexplained hypotension (systolic blood pressure below 90 mmHg or diastolic blood pressure below 60 mmHg) is found by Monitor_Bleeding, which blood counts to order to evaluate blood loss. The monitor\'s performer instruction is to promptly evaluate signs of blood loss with hemoglobin and hematocrit.' ;
          task_definition :: 'Tests_Ordering_Recommendations_Bleeding' ;
          schedule_constraint :: completed('Monitor_Bleeding') ;
          ltwh :: 40,240,0,0;
     component :: 'Monitor_Drug_Interactions' ;
          caption :: 'Review interacting medications at initiation, each visit and each new medicine' ;
          description :: 'Monitors loss of antithrombotic effect or excess bleeding from drug interactions with Prescribe_Aspirin, Prescribe_Clopidogrel, Prescribe_Ticagrelor, Prescribe_Vorapaxar, Prescribe_Low_Dose_Rivaroxaban and Prescribe_DOAC. The guideline repeats the FDA warning against omeprazole and esomeprazole with clopidogrel, and each label names interactions to avoid (aspirin over 100 mg with ticagrelor, strong CYP3A modulators with ticagrelor and vorapaxar, combined P-gp and CYP3A modulators with rivaroxaban and apixaban, P-gp modulators with dabigatran and edoxaban) plus digoxin level monitoring with ticagrelor. Order: interacting medication review (PPI choice with clopidogrel, aspirin dose with ticagrelor, CYP3A and P-gp inhibitors or inducers, other anticoagulants, SSRIs and SNRIs), at initiation, at each follow-up visit and whenever a new medicine is started. Patient: tell every clinician and pharmacist that you take an antiplatelet or anticoagulant and check with them before starting any prescription, over-the-counter medicine or herbal product such as St. John\'s wort. Clinician: avoid omeprazole and esomeprazole with clopidogrel, keep aspirin at 100 mg or less daily with ticagrelor, avoid strong CYP3A inhibitors or inducers with ticagrelor and vorapaxar, avoid combined P-gp and strong CYP3A inhibitors or inducers with rivaroxaban and apixaban (or reduce the apixaban dose by 50 percent per its label), avoid P-gp inducers with dabigatran and rifampin with edoxaban, monitor digoxin levels when ticagrelor is started or changed, and weigh the added bleeding risk of SSRIs, SNRIs and other anticoagulants.' ;
          metaprops :: 'ontology.coding=SCT\\:79899007 [Drug interaction (finding)]
' ;
          task_definition :: 'Monitor_Drug_Interactions' ;
          schedule_constraint :: completed('Display_Potential_ADEs') ;
          ltwh :: 40,340,0,0;
     component :: 'Order_Serum_Digoxin' ;
          caption :: 'Order serum digoxin level' ;
          description :: 'Orders a serum digoxin level for Monitor_Drug_Interactions: the ticagrelor label asks to monitor digoxin levels when ticagrelor is started or changed in a patient on digoxin.' ;
          metaprops :: 'ontology.coding=LNC\\:10535-3 [Digoxin [Mass/volume] in Serum or Plasma]
' ;
          task_definition :: 'Order_Serum_Digoxin' ;
          schedule_constraint :: completed('Monitor_Drug_Interactions') ;
          ltwh :: 40,440,0,0;
     component :: 'Monitor_Spinal_Epidural_Hematoma' ;
          caption :: 'Monitor for spinal or epidural hematoma around neuraxial procedures' ;
          description :: 'Monitors spinal or epidural hematoma as a boxed-warning adverse effect of Prescribe_DOAC and Prescribe_Low_Dose_Rivaroxaban. Every DOAC label carries a Boxed Warning that epidural or spinal hematoma can follow neuraxial anesthesia or spinal puncture and instructs frequent neurological monitoring with urgent treatment, with drug-specific catheter timing. Order: neurological checks for spinal or epidural hematoma around neuraxial anesthesia or spinal puncture, event-triggered, frequent neurological checks whenever neuraxial anesthesia or spinal puncture is performed during anticoagulant therapy. Patient: tell the anesthetist that you take an anticoagulant, and report back pain, tingling, numbness or weakness of the legs, or bowel or bladder problems immediately after an epidural or spinal procedure. Clinician: time epidural catheter removal and the next anticoagulant dose per the drug label (for apixaban remove the catheter no earlier than 24 hours after the last dose and give the next dose no earlier than 5 hours after removal), monitor frequently for neurological impairment and treat urgently if it is found.' ;
          metaprops :: 'ontology.coding=SCT\\:703861005 [Spinal epidural hematoma (disorder)]
' ;
          task_definition :: 'Monitor_Spinal_Epidural_Hematoma' ;
          schedule_constraint :: completed('Display_Potential_ADEs') ;
          ltwh :: 40,540,0,0;
     component :: 'Alert_Further_Examination_Spinal_Epidural_Hematoma' ;
          caption :: 'Alert: further examination of spinal or epidural hematoma' ;
          description :: 'Monitors suspected spinal or epidural hematoma recorded by Monitor_Spinal_Epidural_Hematoma (spinal or epidural hematoma as a boxed-warning adverse effect of Prescribe_DOAC and Prescribe_Low_Dose_Rivaroxaban). The DOAC Boxed Warning and labels ask for frequent monitoring for signs and symptoms of neurological impairment and urgent treatment when neurological compromise is noted, and name no laboratory or imaging test. The sources name no test, so, following Mor Peleg\'s know-how of 4 Nov 2026, this step alerts the clinician to examine the patient further and decide on work-up instead of ordering a test.' ;
          metaprops :: 'ontology.coding=SCT\\:703861005 [Spinal epidural hematoma (disorder)]
' ;
          task_definition :: 'Alert_Further_Examination_Spinal_Epidural_Hematoma' ;
          schedule_constraint :: completed('Monitor_Spinal_Epidural_Hematoma') ;
          ltwh :: 40,640,0,0;
     component :: 'Monitor_Perioperative_Interruption' ;
          caption :: 'Plan antithrombotic interruption before surgery or invasive procedures' ;
          description :: 'Monitors surgical bleeding and thrombotic events around procedures for Prescribe_Clopidogrel, Prescribe_Ticagrelor, Prescribe_Prasugrel, Prescribe_Vorapaxar, Prescribe_Low_Dose_Rivaroxaban and Prescribe_DOAC. Each P2Y12 and DOAC label states how long before surgery to interrupt and to resume once hemostasis is achieved, and the prasugrel and ticagrelor labels warn against starting the drug when urgent CABG is likely. Order: perioperative antithrombotic plan before surgery or invasive procedures, event-triggered, whenever surgery, CABG or an invasive or dental procedure is planned. Patient: tell your surgeon and dentist that you take an antiplatelet or anticoagulant before any procedure, and do not stop it unless the prescribing clinician tells you how and when. Clinician: when the procedure\'s bleeding risk requires interruption, hold clopidogrel and ticagrelor 5 days and prasugrel at least 7 days before surgery, do not start prasugrel or ticagrelor if urgent CABG is likely, hold rivaroxaban and edoxaban at least 24 hours and apixaban 24 to 48 hours by procedural bleeding risk, hold dabigatran per its renal-function table, have the surgeon talk to the prescriber before stopping vorapaxar, and resume as soon as hemostasis is achieved.' ;
          metaprops :: 'ontology.coding=SCT\\:110265006 [Postoperative hemorrhage (disorder)]
' ;
          task_definition :: 'Monitor_Perioperative_Interruption' ;
          schedule_constraint :: completed('Display_Potential_ADEs') ;
          ltwh :: 40,740,0,0;
     component :: 'Alert_Further_Examination_Perioperative_Interruption' ;
          caption :: 'Alert: further examination of perioperative bleeding or thrombosis' ;
          description :: 'Monitors suspected perioperative bleeding or thrombosis recorded by Monitor_Perioperative_Interruption (surgical bleeding and thrombotic events around procedures for Prescribe_Clopidogrel, Prescribe_Ticagrelor, Prescribe_Prasugrel, Prescribe_Vorapaxar, Prescribe_Low_Dose_Rivaroxaban and Prescribe_DOAC). The labels ask to interrupt the antiplatelet or anticoagulant before surgery and to resume it as soon as hemostasis is achieved, and name no laboratory or imaging test for perioperative bleeding or thrombosis. The sources name no test, so, following Mor Peleg\'s know-how of 4 Nov 2026, this step alerts the clinician to examine the patient further and decide on work-up instead of ordering a test.' ;
          metaprops :: 'ontology.coding=SCT\\:110265006 [Postoperative hemorrhage (disorder)]
' ;
          task_definition :: 'Alert_Further_Examination_Perioperative_Interruption' ;
          schedule_constraint :: completed('Monitor_Perioperative_Interruption') ;
          ltwh :: 40,840,0,0;
     component :: 'Monitor_Renal_Function' ;
          caption :: 'Monitor renal function (creatinine, Cockcroft-Gault CrCl) for anticoagulant dosing' ;
          description :: 'Monitors renal function that sets anticoagulant dosing and eligibility for Prescribe_DOAC and Prescribe_Low_Dose_Rivaroxaban. The dabigatran and rivaroxaban labels instruct baseline and periodic renal assessment with dose adjustment, edoxaban must not be used above a CrCl of 95 mL/min, and every DOAC dose depends on renal function. Order: serum creatinine with Cockcroft-Gault creatinine clearance for anticoagulant dose and eligibility, baseline before starting, then at least every 12 months and sooner when renal function may decline (acute illness, dehydration, new nephrotoxic drugs). Patient: attend the kidney blood test and tell your clinician about vomiting, diarrhea, dehydration or a new medicine that can affect the kidneys. Clinician: adjust or stop the anticoagulant by creatinine clearance per its label, rivaroxaban 15 mg daily for AF if CrCl is 50 or below, dabigatran 75 mg twice daily if CrCl is 15 to 30, apixaban 2.5 mg twice daily with two of age 80 or more, weight 60 kg or less and creatinine 1.5 mg/dL or more, edoxaban 30 mg if CrCl is 15 to 50 and not at all if CrCl is above 95, and avoid rivaroxaban if CrCl is below 15.' ;
          metaprops :: 'ontology.coding=SCT\\:442407001 [Estimation of creatinine clearance by Cockcroft-Gault formula (procedure)]
' ;
          task_definition :: 'Monitor_Renal_Function' ;
          schedule_constraint :: completed('Display_Potential_ADEs') ;
          ltwh :: 40,940,0,0;
     component :: 'Order_Serum_Creatinine' ;
          caption :: 'Order serum creatinine for Cockcroft-Gault creatinine clearance' ;
          description :: 'Orders serum creatinine, from which the Cockcroft-Gault creatinine clearance is calculated, for Monitor_Renal_Function: anticoagulant dose and eligibility depend on it, and the labels ask for baseline and periodic renal assessment, more often when renal function may decline.' ;
          metaprops :: 'ontology.coding=LNC\\:2160-0 [Creatinine [Mass/volume] in Serum or Plasma]
' ;
          task_definition :: 'Order_Serum_Creatinine' ;
          schedule_constraint :: completed('Monitor_Renal_Function') ;
          ltwh :: 40,1040,0,0;
     component :: 'Monitor_TTP' ;
          caption :: 'Monitor for thrombotic thrombocytopenic purpura on a thienopyridine' ;
          description :: 'Monitors thrombotic thrombocytopenic purpura as a labeled adverse effect of Prescribe_Clopidogrel and Prescribe_Prasugrel. Both thienopyridine labels warn that TTP, sometimes fatal, can follow even brief exposure and needs urgent treatment including plasmapheresis, without a routine laboratory schedule. Order: thrombotic thrombocytopenic purpura symptom review with triggered platelet count, blood smear for schistocytes, LDH and serum creatinine, symptom-triggered, with a symptom question at each follow-up visit and particular attention in the first weeks after starting. Patient: get prompt medical attention for unexplained purple skin spots, extreme tiredness, yellow skin or eyes, fever, confusion or passing little urine. Clinician: if TTP is suspected, check platelet count, a blood smear for schistocytes, LDH and serum creatinine, stop the thienopyridine and arrange urgent treatment including plasmapheresis.' ;
          metaprops :: 'ontology.coding=SCT\\:78129009 [Thrombotic thrombocytopenic purpura (disorder)]
' ;
          task_definition :: 'Monitor_TTP' ;
          schedule_constraint :: completed('Display_Potential_ADEs') ;
          ltwh :: 40,1140,0,0;
     component :: 'Tests_Ordering_Recommendations_TTP' ;
          caption :: 'Which tests to order for suspected thrombotic thrombocytopenic purpura?' ;
          description :: 'When a symptom of thrombotic thrombocytopenic purpura is found by Monitor_TTP, which tests to order to confirm it. The monitor\'s performer instruction is to check platelet count, a blood smear for schistocytes, LDH and serum creatinine.' ;
          task_definition :: 'Tests_Ordering_Recommendations_TTP' ;
          schedule_constraint :: completed('Monitor_TTP') ;
          ltwh :: 40,1240,0,0;
     component :: 'Monitor_CYP2C19_Poor_Metabolizer' ;
          caption :: 'Review CYP2C19 poor-metabolizer status on clopidogrel' ;
          description :: 'Monitors diminished antiplatelet effect in CYP2C19 poor metabolizers as a boxed-warning risk of Prescribe_Clopidogrel. The clopidogrel Boxed Warning says effectiveness depends on CYP2C19 activation, that tests exist, and that another P2Y12 inhibitor should be considered in identified poor metabolizers, without mandating routine genotyping. Order: CYP2C19 poor-metabolizer status review for clopidogrel response, event-triggered, at initiation when a CYP2C19 genotype result is available and after any ischemic event on clopidogrel. Patient: tell your clinician if you have had a CYP2C19 gene test and report any new chest pain or stroke symptoms. Clinician: if the patient is a known CYP2C19 poor metabolizer, consider another P2Y12 inhibitor, and consider CYP2C19 testing after an ischemic event on clopidogrel.' ;
          metaprops :: 'ontology.coding=SCT\\:738786005 [Cytochrome P450 family 2 subfamily C member 19 poor metabolizer (finding)]
' ;
          task_definition :: 'Monitor_CYP2C19_Poor_Metabolizer' ;
          schedule_constraint :: completed('Display_Potential_ADEs') ;
          ltwh :: 40,1340,0,0;
     component :: 'Order_CYP2C19_Genotype' ;
          caption :: 'Order CYP2C19 genotype' ;
          description :: 'Orders CYP2C19 genotyping for Monitor_CYP2C19_Poor_Metabolizer: after an ischemic event on clopidogrel, a poor-metabolizer result would lead to another P2Y12 inhibitor (clopidogrel Boxed Warning).' ;
          metaprops :: 'ontology.coding=LNC\\:57132-3 [CYP2C19 gene allele [Genotype] in Blood or Tissue by Molecular genetics method Nominal]
' ;
          task_definition :: 'Order_CYP2C19_Genotype' ;
          schedule_constraint :: completed('Monitor_CYP2C19_Poor_Metabolizer') ;
          ltwh :: 40,1440,0,0;
     component :: 'Monitor_Antiplatelet_Hypersensitivity' ;
          caption :: 'Monitor for antiplatelet hypersensitivity reactions' ;
          description :: 'Monitors hypersensitivity reactions to Prescribe_Aspirin, Prescribe_Clopidogrel, Prescribe_Prasugrel and Prescribe_Ticagrelor. The aspirin label warns of severe allergic reactions and says to stop use and seek help, and the clopidogrel, prasugrel and ticagrelor labels list hypersensitivity and angioedema, with cross-reactivity between thienopyridines. Order: antiplatelet hypersensitivity reaction review (hives, angioedema, bronchospasm, rash, hematologic reaction), symptom-triggered, with an allergy question at each follow-up visit after starting or switching an antiplatelet. Patient: stop the medicine and seek medical help right away for hives, swelling of the face, lips or throat, wheezing or a widespread rash. Clinician: if a hypersensitivity reaction occurs, stop the culprit drug, treat the reaction and choose an alternative antiplatelet, noting cross-reactivity between thienopyridines (clopidogrel, prasugrel, ticlopidine).' ;
          metaprops :: 'ontology.coding=SCT\\:416098002 [Allergy to drug (finding)]
' ;
          task_definition :: 'Monitor_Antiplatelet_Hypersensitivity' ;
          schedule_constraint :: completed('Display_Potential_ADEs') ;
          ltwh :: 40,1540,0,0;
     component :: 'Alert_Further_Examination_Antiplatelet_Hypersensitivity' ;
          caption :: 'Alert: further examination of antiplatelet hypersensitivity reaction' ;
          description :: 'Monitors suspected antiplatelet hypersensitivity reaction recorded by Monitor_Antiplatelet_Hypersensitivity (hypersensitivity reactions to Prescribe_Aspirin, Prescribe_Clopidogrel, Prescribe_Prasugrel and Prescribe_Ticagrelor). The clopidogrel and prasugrel labels report hypersensitivity including rash, angioedema or hematologic reaction, and the labels name no laboratory or imaging test to confirm it. The sources name no test, so, following Mor Peleg\'s know-how of 4 Nov 2026, this step alerts the clinician to examine the patient further and decide on work-up instead of ordering a test.' ;
          metaprops :: 'ontology.coding=SCT\\:416098002 [Allergy to drug (finding)]
' ;
          task_definition :: 'Alert_Further_Examination_Antiplatelet_Hypersensitivity' ;
          schedule_constraint :: completed('Monitor_Antiplatelet_Hypersensitivity') ;
          ltwh :: 40,1640,0,0;
     component :: 'Monitor_Ticagrelor_Dyspnea' ;
          caption :: 'Monitor for dyspnea on ticagrelor' ;
          description :: 'Monitors dyspnea as a labeled adverse effect of Prescribe_Ticagrelor. The label says ticagrelor-related dyspnea needs no specific treatment and that intolerable dyspnea warrants switching antiplatelet agent. Order: dyspnea review on ticagrelor, symptom-triggered, with a breathlessness question at each follow-up visit. Patient: contact your clinician if you have unexpected shortness of breath, especially if it is severe. Clinician: if dyspnea is new, prolonged or worse, exclude other causes such as heart failure, continue ticagrelor without specific treatment when it is drug-related and tolerable, and switch to another antiplatelet agent if it is intolerable.' ;
          metaprops :: 'ontology.coding=SCT\\:267036007 [Dyspnea (finding)]
' ;
          task_definition :: 'Monitor_Ticagrelor_Dyspnea' ;
          schedule_constraint :: completed('Display_Potential_ADEs') ;
          ltwh :: 40,1740,0,0;
     component :: 'Alert_Further_Examination_Ticagrelor_Dyspnea' ;
          caption :: 'Alert: further examination of ticagrelor-related dyspnea' ;
          description :: 'Monitors suspected ticagrelor-related dyspnea recorded by Monitor_Ticagrelor_Dyspnea (dyspnea as a labeled adverse effect of Prescribe_Ticagrelor). The ticagrelor label says new, prolonged or worsened dyspnea related to the drug needs no specific treatment and that another antiplatelet agent should be considered when it is intolerable, and names no laboratory or imaging test. The sources name no test, so, following Mor Peleg\'s know-how of 4 Nov 2026, this step alerts the clinician to examine the patient further and decide on work-up instead of ordering a test.' ;
          metaprops :: 'ontology.coding=SCT\\:267036007 [Dyspnea (finding)]
' ;
          task_definition :: 'Alert_Further_Examination_Ticagrelor_Dyspnea' ;
          schedule_constraint :: completed('Monitor_Ticagrelor_Dyspnea') ;
          ltwh :: 40,1840,0,0;
     component :: 'Monitor_Ticagrelor_Bradyarrhythmia' ;
          caption :: 'Check the pulse for bradyarrhythmia on ticagrelor (ECG on symptoms)' ;
          description :: 'Monitors bradyarrhythmia (ventricular pauses, AV block) as a labeled adverse effect of Prescribe_Ticagrelor. The label warns that ticagrelor can cause ventricular pauses and that patients with conduction disease without a pacemaker were not studied, but states no monitoring instruction. Order: pulse check with ECG on symptoms of bradyarrhythmia on ticagrelor, each follow-up visit, with an ECG on dizziness, syncope or a slow pulse. Patient: report fainting, dizziness, light-headedness or a very slow pulse. Clinician: if bradycardia or syncope is found, obtain an ECG for ventricular pauses or AV block and reconsider ticagrelor in patients with sick sinus syndrome, second or third degree AV block or bradycardia-related syncope without a pacemaker.' ;
          metaprops :: 'ontology.coding=SCT\\:421869004 [Bradyarrhythmia (disorder)]
' ;
          task_definition :: 'Monitor_Ticagrelor_Bradyarrhythmia' ;
          schedule_constraint :: completed('Display_Potential_ADEs') ;
          ltwh :: 40,1940,0,0;
     component :: 'Order_ECG' ;
          caption :: 'Order 12-lead ECG' ;
          description :: 'Orders a 12-lead ECG for Monitor_Ticagrelor_Bradyarrhythmia, to look for ventricular pauses or AV block when syncope, dizziness or a slow pulse is found on ticagrelor.' ;
          metaprops :: 'ontology.coding=LNC\\:34534-8 [12 lead EKG panel]
' ;
          task_definition :: 'Order_ECG' ;
          schedule_constraint :: completed('Monitor_Ticagrelor_Bradyarrhythmia') ;
          ltwh :: 40,2040,0,0;
     component :: 'Monitor_Ticagrelor_Central_Sleep_Apnea' ;
          caption :: 'Monitor for central sleep apnea on ticagrelor' ;
          description :: 'Monitors central sleep apnea as a labeled adverse effect of Prescribe_Ticagrelor. The label reports central sleep apnea including Cheyne-Stokes respiration and advises further assessment when it is suspected. Order: central sleep apnea symptom review on ticagrelor, symptom-triggered, with a sleep-breathing question at each follow-up visit. Patient: tell your clinician if you or your partner notice pauses in breathing during sleep, irregular breathing at night, frequent waking or daytime sleepiness. Clinician: if central sleep apnea is suspected, consider further clinical assessment such as a sleep study.' ;
          metaprops :: 'ontology.coding=SCT\\:27405005 [Central sleep apnea syndrome (disorder)]
' ;
          task_definition :: 'Monitor_Ticagrelor_Central_Sleep_Apnea' ;
          schedule_constraint :: completed('Display_Potential_ADEs') ;
          ltwh :: 40,2140,0,0;
     component :: 'Order_Polysomnography' ;
          caption :: 'Order polysomnography (sleep study)' ;
          description :: 'Orders a sleep study for Monitor_Ticagrelor_Central_Sleep_Apnea, as the further clinical assessment the ticagrelor label advises when central sleep apnea is suspected.' ;
          metaprops :: 'ontology.coding=LNC\\:28633-6 [Polysomnography (sleep) study]
' ;
          task_definition :: 'Order_Polysomnography' ;
          schedule_constraint :: completed('Monitor_Ticagrelor_Central_Sleep_Apnea') ;
          ltwh :: 40,2240,0,0;
     component :: 'Monitor_PPI_CDAD' ;
          caption :: 'Monitor for C. difficile-associated diarrhea on pantoprazole' ;
          description :: 'Monitors C. difficile-associated diarrhea as a labeled adverse effect of Prescribe_PPI. The label says PPI therapy may raise the risk of C. difficile-associated diarrhea and that the diagnosis should be considered for diarrhea that does not improve. Order: Clostridioides difficile-associated diarrhea symptom review with triggered stool C. difficile testing, symptom-triggered, with a bowel-habit question at each follow-up visit. Patient: call your clinician right away for diarrhea that does not improve, especially with fever or abdominal pain. Clinician: if diarrhea does not improve, test the stool for C. difficile, treat a confirmed infection and review whether the PPI is still needed.' ;
          metaprops :: 'ontology.coding=SCT\\:186431008 [Infection caused by Clostridioides difficile (disorder)]
' ;
          task_definition :: 'Monitor_PPI_CDAD' ;
          schedule_constraint :: completed('Display_Potential_ADEs') ;
          ltwh :: 40,2340,0,0;
     component :: 'Order_Stool_C_Difficile_Test' ;
          caption :: 'Order stool C. difficile toxin test' ;
          description :: 'Orders a stool C. difficile toxin test for Monitor_PPI_CDAD, because the pantoprazole label says C. difficile-associated diarrhea should be considered for diarrhea that does not improve.' ;
          metaprops :: 'ontology.coding=LNC\\:34713-8 [Clostridioides difficile toxin A+B [Presence] in Stool]
' ;
          task_definition :: 'Order_Stool_C_Difficile_Test' ;
          schedule_constraint :: completed('Monitor_PPI_CDAD') ;
          ltwh :: 40,2440,0,0;
     component :: 'Monitor_PPI_Hypomagnesemia' ;
          caption :: 'Monitor serum magnesium on pantoprazole' ;
          description :: 'Monitors hypomagnesemia as a labeled adverse effect of Prescribe_PPI. The label\'s own instruction is to consider magnesium before starting and periodically in patients on prolonged treatment or on digoxin or diuretics. Order: serum magnesium, baseline before starting pantoprazole, then every 12 months while it continues, and on symptoms. Patient: report muscle cramps, tremor, spasms, palpitations, an irregular heartbeat or seizures. Clinician: if magnesium is low, check calcium and potassium, replace magnesium and reconsider the PPI.' ;
          metaprops :: 'ontology.coding=SCT\\:190855004 [Hypomagnesemia (disorder)]
' ;
          task_definition :: 'Monitor_PPI_Hypomagnesemia' ;
          schedule_constraint :: completed('Display_Potential_ADEs') ;
          ltwh :: 40,2540,0,0;
     component :: 'Tests_Ordering_Recommendations_PPI_Hypomagnesemia' ;
          caption :: 'Which tests to order for suspected hypomagnesemia?' ;
          description :: 'When a symptom of hypomagnesemia is found by Monitor_PPI_Hypomagnesemia, which electrolytes to order. The label asks to consider magnesium before starting the PPI and periodically; that scheduled check is part of the monitor\'s ServiceRequest.occurrenceTiming (baseline before starting pantoprazole, then every 12 months while it continues), not a data item. The monitor checks calcium and potassium when magnesium is low.' ;
          task_definition :: 'Tests_Ordering_Recommendations_PPI_Hypomagnesemia' ;
          schedule_constraint :: completed('Monitor_PPI_Hypomagnesemia') ;
          ltwh :: 40,2640,0,0;
     component :: 'Monitor_PPI_Bone_Fracture' ;
          caption :: 'Review fracture and osteoporosis risk during long-term pantoprazole' ;
          description :: 'Monitors osteoporosis-related fracture as a labeled adverse effect of long-term Prescribe_PPI. The label links long-term (a year or longer) and high-dose PPI use to hip, wrist and spine fractures and advises managing at-risk patients per osteoporosis guidelines. Order: fracture history and osteoporosis risk review during long-term pantoprazole, every 12 months while pantoprazole continues for 1 year or longer, and on any fracture. Patient: report any fracture, especially of the hip, wrist or spine. Clinician: when pantoprazole continues for a year or longer, assess osteoporosis and fracture risk per current osteoporosis guidelines and use the lowest PPI dose for the shortest duration.' ;
          metaprops :: 'ontology.coding=SCT\\:443165006 [Osteoporotic fracture of bone (disorder)]
' ;
          task_definition :: 'Monitor_PPI_Bone_Fracture' ;
          schedule_constraint :: completed('Display_Potential_ADEs') ;
          ltwh :: 40,2740,0,0;
     component :: 'Alert_Further_Examination_PPI_Bone_Fracture' ;
          caption :: 'Alert: further examination of osteoporosis-related bone fracture' ;
          description :: 'Monitors suspected osteoporosis-related bone fracture recorded by Monitor_PPI_Bone_Fracture (osteoporosis-related fracture as a labeled adverse effect of long-term Prescribe_PPI). The pantoprazole label reports an increased fracture risk with high-dose and long-term PPI therapy and asks patients to report fractures, and names no laboratory or imaging test. The sources name no test, so, following Mor Peleg\'s know-how of 4 Nov 2026, this step alerts the clinician to examine the patient further and decide on work-up instead of ordering a test.' ;
          metaprops :: 'ontology.coding=SCT\\:443165006 [Osteoporotic fracture of bone (disorder)]
' ;
          task_definition :: 'Alert_Further_Examination_PPI_Bone_Fracture' ;
          schedule_constraint :: completed('Monitor_PPI_Bone_Fracture') ;
          ltwh :: 40,2840,0,0;
     component :: 'Monitor_PPI_Interstitial_Nephritis' ;
          caption :: 'Monitor for acute tubulointerstitial nephritis on pantoprazole' ;
          description :: 'Monitors acute tubulointerstitial nephritis as a labeled adverse effect of Prescribe_PPI. The label says acute TIN can occur at any point during PPI therapy and that the PPI should be stopped and the patient evaluated if it is suspected. Order: acute tubulointerstitial nephritis symptom review with triggered serum creatinine and urinalysis, symptom-triggered, at any time during pantoprazole therapy. Patient: call your clinician right away for fever, rash, joint pain, passing less urine or blood in the urine. Clinician: if acute tubulointerstitial nephritis is suspected, check serum creatinine and urinalysis, stop pantoprazole and evaluate.' ;
          metaprops :: 'ontology.coding=SCT\\:28637003 [Acute tubulointerstitial nephritis (disorder)]
' ;
          task_definition :: 'Monitor_PPI_Interstitial_Nephritis' ;
          schedule_constraint :: completed('Display_Potential_ADEs') ;
          ltwh :: 40,2940,0,0;
     component :: 'Tests_Ordering_Recommendations_PPI_Interstitial_Nephritis' ;
          caption :: 'Which tests to order for suspected acute tubulointerstitial nephritis?' ;
          description :: 'When a symptom of acute tubulointerstitial nephritis is found by Monitor_PPI_Interstitial_Nephritis, which tests to order. The monitor\'s performer instruction is to check serum creatinine and urinalysis, stop pantoprazole and evaluate.' ;
          task_definition :: 'Tests_Ordering_Recommendations_PPI_Interstitial_Nephritis' ;
          schedule_constraint :: completed('Monitor_PPI_Interstitial_Nephritis') ;
          ltwh :: 40,3040,0,0;
     component :: 'Monitor_PPI_Cutaneous_Lupus' ;
          caption :: 'Monitor for cutaneous or systemic lupus erythematosus on pantoprazole' ;
          description :: 'Monitors cutaneous or systemic lupus erythematosus as a labeled adverse effect of Prescribe_PPI. The label reports new or exacerbated CLE and SLE with PPIs and says to stop the drug and refer when signs appear. Order: cutaneous or systemic lupus erythematosus symptom review, symptom-triggered, at any time during pantoprazole therapy. Patient: report a new or worsening rash on sun-exposed skin, or new joint pain. Clinician: if cutaneous or systemic lupus is suspected, stop pantoprazole and refer the patient to the appropriate specialist.' ;
          metaprops :: 'ontology.coding=SCT\\:7119001 [Cutaneous lupus erythematosus (disorder)]
' ;
          task_definition :: 'Monitor_PPI_Cutaneous_Lupus' ;
          schedule_constraint :: completed('Display_Potential_ADEs') ;
          ltwh :: 40,3140,0,0;
     component :: 'Alert_Further_Examination_PPI_Cutaneous_Lupus' ;
          caption :: 'Alert: further examination of cutaneous or systemic lupus erythematosus' ;
          description :: 'Monitors suspected cutaneous or systemic lupus erythematosus recorded by Monitor_PPI_Cutaneous_Lupus (cutaneous or systemic lupus erythematosus as a labeled adverse effect of Prescribe_PPI). The pantoprazole label asks to discontinue the drug and refer the patient to a specialist when signs or symptoms of CLE or SLE are noted; it mentions serological testing (e.g. ANA) only as a result that may be positive and asks for no laboratory or imaging test. So, following Mor Peleg\'s know-how of 4 Nov 2026, this step alerts the clinician to examine the patient further and decide on work-up instead of ordering a test.' ;
          metaprops :: 'ontology.coding=SCT\\:7119001 [Cutaneous lupus erythematosus (disorder)]
' ;
          task_definition :: 'Alert_Further_Examination_PPI_Cutaneous_Lupus' ;
          schedule_constraint :: completed('Monitor_PPI_Cutaneous_Lupus') ;
          ltwh :: 40,3240,0,0;
     component :: 'Monitor_PPI_Severe_Cutaneous_Reactions' ;
          caption :: 'Monitor for severe cutaneous adverse reactions on pantoprazole' ;
          description :: 'Monitors severe cutaneous adverse reactions as a labeled adverse effect of Prescribe_PPI. The label reports severe cutaneous reactions (EM, SJS/TEN, DRESS, AGEP) and says to stop the drug at the first signs. Order: severe cutaneous adverse reaction symptom review (SJS, TEN, DRESS, AGEP), symptom-triggered, at any time during pantoprazole therapy. Patient: stop pantoprazole and call your clinician right away for blistering or peeling skin, mouth sores, or a rash with fever. Clinician: discontinue pantoprazole at the first signs of a severe cutaneous reaction or other hypersensitivity and consider further evaluation.' ;
          metaprops :: 'ontology.coding=SCT\\:768946000 [Stevens-Johnson syndrome, toxic epidermal necrolysis spectrum (disorder)]
' ;
          task_definition :: 'Monitor_PPI_Severe_Cutaneous_Reactions' ;
          schedule_constraint :: completed('Display_Potential_ADEs') ;
          ltwh :: 40,3340,0,0;
     component :: 'Alert_Further_Examination_PPI_Severe_Cutaneous_Reactions' ;
          caption :: 'Alert: further examination of severe cutaneous adverse reaction' ;
          description :: 'Monitors suspected severe cutaneous adverse reaction recorded by Monitor_PPI_Severe_Cutaneous_Reactions (severe cutaneous adverse reactions as a labeled adverse effect of Prescribe_PPI). The pantoprazole label asks to discontinue it at the first signs or symptoms of a severe cutaneous adverse reaction and to consider further evaluation, and names no laboratory or imaging test. The sources name no test, so, following Mor Peleg\'s know-how of 4 Nov 2026, this step alerts the clinician to examine the patient further and decide on work-up instead of ordering a test.' ;
          metaprops :: 'ontology.coding=SCT\\:768946000 [Stevens-Johnson syndrome, toxic epidermal necrolysis spectrum (disorder)]
' ;
          task_definition :: 'Alert_Further_Examination_PPI_Severe_Cutaneous_Reactions' ;
          schedule_constraint :: completed('Monitor_PPI_Severe_Cutaneous_Reactions') ;
          ltwh :: 40,3440,0,0;
end plan.

plan  :: 'Monitoring_Plan' ;
     caption :: 'Monitor antithrombotic therapy' ;
     description :: 'Monitors completion of the antithrombotic recommendations, the desired outcome and the adverse drug effects, in three parallel sub-plans.' ;
     component :: 'Monitor_Actions' ;
          caption :: 'Monitor completion of the antithrombotic recommendations' ;
          description :: 'Action Enactment monitoring: adherence, regimen duration and step-down, NSAID avoidance and the continued need for the PPI.' ;
          task_definition :: 'Monitor_Actions' ;
          ltwh :: 40,40,0,0;
     component :: 'Monitor_Desired_State' ;
          caption :: 'Monitor the desired outcome (absence of ischemic events)' ;
          description :: 'State Achievement monitoring of the shared achieve goal of the antithrombotic drugs: fewer ischemic events and MACE.' ;
          task_definition :: 'Monitor_Desired_State' ;
          ltwh :: 40,140,0,0;
     component :: 'Monitor_Undesired_State' ;
          caption :: 'Monitor adverse drug effects' ;
          description :: 'State Achievement monitoring of the adverse drug effects of the antithrombotics and of pantoprazole, from the label Boxed Warnings and Warnings and Precautions.' ;
          task_definition :: 'Monitor_Undesired_State' ;
          ltwh :: 40,240,0,0;
end plan.


data  :: 'requires_oral_anticoagulation' ;
     type :: text ;
     caption :: 'Does the patient have an indication for long-term oral anticoagulation (e.g. atrial fibrillation)?' ;
     description :: 'Indication for long-term oral anticoagulation (e.g. atrial fibrillation). Separates the regimens without an oral anticoagulant (Recs 1-10, 15) from those with a DOAC (Recs 11-14). The SNOMED CT concept records current use of an anticoagulant, not the indication. Default "no" for running and testing: with the other baseline defaults it leads Antithrombotic_Regimen_Decision to Aspirin_Monotherapy; the clinician records the actual answer.' ;
     metaprops :: 'ontology.coding=SCT\\:711150003 [Long-term current use of anticoagulant (situation)]
quote=p.e50, Rec 1\\: "In patients with CCD and no indication for oral anticoagulant therapy, low-dose aspirin 81 mg (75-100 mg) is recommended"
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 1 (p.e50)
' ;
     range ::"yes||yes","no||no";
     default_value ::"no";
end data.

data  :: 'pci_within_12_months' ;
     type :: text ;
     caption :: 'PCI within the past 12 months?' ;
     description :: 'Percutaneous coronary intervention within the past 12 months; the PCI-related DAPT and DOAC-plus-antiplatelet pathways of Figure 9 apply in this window. The 12-month window is held in the data-item logic; the SNOMED CT concept records a history of PCI. Default "no" for running and testing: with the other baseline defaults it leads Antithrombotic_Regimen_Decision to Aspirin_Monotherapy; the clinician records the actual answer.' ;
     metaprops :: 'ontology.coding=SCT\\:405741001 [History of percutaneous coronary intervention (situation)]
quote=p.e50, Rec 2\\: "In patients with CCD treated with PCI, dual antiplatelet therapy (DAPT) consisting of aspirin and clopidogrel for 6 months post PCI"
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 2 (p.e50)
' ;
     range ::"yes||yes","no||no";
     default_value ::"no";
end data.

data  :: 'des_implanted' ;
     type :: text ;
     caption :: 'Was a drug-eluting stent implanted at that PCI?' ;
     description :: 'A drug-eluting stent was implanted at the recent PCI; required for the short-DAPT then P2Y12-monotherapy option of Rec 3. Default "no" for running and testing: with the other baseline defaults it leads Antithrombotic_Regimen_Decision to Aspirin_Monotherapy; the clinician records the actual answer.' ;
     metaprops :: 'ontology.coding=SCT\\:705637003 [Drug-eluting coronary artery stent (physical object)]
quote=p.e50, Rec 3\\: "In select patients with CCD treated with PCI and a drug-eluting stent (DES) who have completed a 1- to 3-month course of DAPT"
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 3 (p.e50)
' ;
     range ::"yes||yes","no||no";
     default_value ::"no";
end data.

data  :: 'acs_within_12_months' ;
     type :: text ;
     caption :: 'Acute coronary syndrome within the past 12 months?' ;
     description :: 'Acute coronary syndrome within the past 12 months; recent ACS is an indication for DAPT (Figure 9) and an acute indication for antiplatelet therapy alongside a DOAC (Rec 14). Default "no" for running and testing: with the other baseline defaults it leads Antithrombotic_Regimen_Decision to Aspirin_Monotherapy; the clinician records the actual answer.' ;
     metaprops :: 'ontology.coding=SCT\\:394659003 [Acute coronary syndrome (disorder)]
quote=p.e50, Rec 7\\: "In patients with CCD without recent ACS or a PCI-related indication for DAPT"
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 7 (p.e50)
' ;
     range ::"yes||yes","no||no";
     default_value ::"no";
end data.

data  :: 'cabg_within_12_months' ;
     type :: text ;
     caption :: 'CABG within the past 12 months?' ;
     description :: 'Coronary artery bypass grafting within the past 12 months. Rec 6 gives no DAPT duration after CABG; the first postoperative year is used (approved open question 1). Default "no" for running and testing: with the other baseline defaults it leads Antithrombotic_Regimen_Decision to Aspirin_Monotherapy; the clinician records the actual answer.' ;
     metaprops :: 'ontology.coding=SCT\\:232717009 [Coronary artery bypass grafting (procedure)]
quote=p.e50, Rec 6\\: "the use of DAPT after CABG may be useful to reduce the incidence of saphenous vein graft occlusion"
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 6 (p.e50)
' ;
     range ::"yes||yes","no||no";
     default_value ::"no";
end data.

data  :: 'previous_mi' ;
     type :: text ;
     caption :: 'History of myocardial infarction?' ;
     description :: 'History of myocardial infarction; the population of extended DAPT (Rec 4), vorapaxar (Rec 5) and ticagrelor 60 mg (PEGASUS). Default "no" for running and testing: with the other baseline defaults it leads Antithrombotic_Regimen_Decision to Aspirin_Monotherapy; the clinician records the actual answer.' ;
     metaprops :: 'ontology.coding=SCT\\:1755008 [Old myocardial infarction (disorder)]
quote=p.e50, Rec 4\\: "In patients with CCD who have had a previous MI and are at low bleeding risk"
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 4 (p.e50)
' ;
     range ::"yes||yes","no||no";
     default_value ::"no";
end data.

data  :: 'prior_stroke_or_tia' ;
     type :: text ;
     caption :: 'History of ischemic stroke or TIA?' ;
     description :: 'History of ischemic stroke or transient ischemic attack; excludes vorapaxar (Rec 8) and prasugrel (Rec 9). The SNOMED CT concept covers cerebrovascular accident; TIA is a separate concept (161511000) not coded here. Default "no" for running and testing: with the other baseline defaults it leads Antithrombotic_Regimen_Decision to Aspirin_Monotherapy; the clinician records the actual answer.' ;
     metaprops :: 'ontology.coding=SCT\\:275526006 [History of cerebrovascular accident (situation)]
quote=p.e50, Rec 9\\: "In patients with CCD and previous stroke, TIA, or ICH, prasugrel should not be used"
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 9 (p.e50)
' ;
     range ::"yes||yes","no||no";
     default_value ::"no";
end data.

data  :: 'prior_ich' ;
     type :: text ;
     caption :: 'History of intracranial hemorrhage?' ;
     description :: 'History of intracranial hemorrhage; excludes vorapaxar (Rec 8), prasugrel (Rec 9) and ticagrelor (BRILINTA §4.1). Default "no" for running and testing: with the other baseline defaults it leads Antithrombotic_Regimen_Decision to Aspirin_Monotherapy; the clinician records the actual answer.' ;
     metaprops :: 'ontology.coding=SCT\\:16864911000119103 [History of intracranial hemorrhage (situation)]
quote=\\u00A74.1\\: "BRILINTA is contraindicated in patients with a history of intracranial hemorrhage (ICH) because of a high risk of recurrent ICH in this population"
source=BRILINTA (ticagrelor) US Prescribing Information 2026, \\u00A74.1
' ;
     range ::"yes||yes","no||no";
     default_value ::"no";
end data.

data  :: 'high_bleeding_risk' ;
     type :: text ;
     caption :: 'High bleeding risk (validated score such as PRECISE-DAPT, DAPT or PARIS, or clinical judgment)?' ;
     description :: 'High bleeding risk, assessed with a validated score (PRECISE-DAPT, DAPT or PARIS) or clinical judgment; steers the choice and duration of antiplatelet therapy (Synopsis; Recs 3, 4, 12, 15). Default "no" for running and testing: with the other baseline defaults it leads Antithrombotic_Regimen_Decision to Aspirin_Monotherapy; the clinician records the actual answer.' ;
     metaprops :: 'ontology.coding=SCT\\:711536002 [At high risk for bleeding (finding)]
quote=p.e50, Synopsis\\: "The use of validated risk scores to address bleeding risk can be useful in choice and duration of antiplatelet therapy."
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Synopsis (p.e50)
' ;
     range ::"yes||yes","no||no";
     default_value ::"no";
end data.

data  :: 'high_thrombotic_risk' ;
     type :: text ;
     caption :: 'High risk of recurrent ischemic events (e.g. multivessel CAD with diabetes, recurrent MI, PAD, HF or CKD, or complex PCI)?' ;
     description :: 'High risk of recurrent ischemic events (the COMPASS definition: multivessel CAD with diabetes requiring medication, recurrent MI, PAD, HF or CKD; or complex PCI features). The SNOMED CT concept is the nearest match (increased risk for cardiovascular event). Default "no" for running and testing: with the other baseline defaults it leads Antithrombotic_Regimen_Decision to Aspirin_Monotherapy; the clinician records the actual answer.' ;
     metaprops :: 'ontology.coding=SCT\\:395112001 [At increased risk for cardiovascular event (finding)]
quote=p.e55, text 15\\: "multivessel CAD and at least one of the following\\: diabetes requiring medication, recurrent MI, peripheral artery disease, HF, or CKD"
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 supportive text 15 (p.e55)
' ;
     range ::"yes||yes","no||no";
     default_value ::"no";
end data.

data  :: 'aspirin_intolerance' ;
     type :: text ;
     caption :: 'Aspirin allergy or intolerance (incl. NSAID hypersensitivity or the asthma-rhinitis-nasal polyps syndrome)?' ;
     description :: 'Aspirin allergy or intolerance, including NSAID hypersensitivity and the asthma-rhinitis-nasal polyps syndrome; selects clopidogrel monotherapy instead of aspirin. The SNOMED CT concept covers aspirin allergy only, not intolerance. Default "no" for running and testing: with the other baseline defaults it leads Antithrombotic_Regimen_Decision to Aspirin_Monotherapy; the clinician records the actual answer.' ;
     metaprops :: 'ontology.coding=SCT\\:293586001 [Allergy to aspirin (finding)]
quote=p.e51, text 1\\: "As an alternative to low-dose aspirin, clopidogrel may be used in individuals who cannot tolerate aspirin therapy"
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 supportive text 1 (p.e51)
' ;
     range ::"yes||yes","no||no";
     default_value ::"no";
end data.

data  :: 'active_pathological_bleeding' ;
     type :: text ;
     caption :: 'Active pathological bleeding (e.g. peptic ulcer, intracranial hemorrhage)?' ;
     description :: 'Active pathological bleeding such as a peptic ulcer or intracranial hemorrhage; every antithrombotic label contraindicates it, so it gates the whole therapy plan. Shares its SNOMED CT concept with Monitor_Bleeding. Default "no" for running and testing, so that the precondition of Antithrombotic_Therapy is met and the therapy plan is entered. This source is mandatory because it gates a plan: the clinician must confirm the value, because a default can hide an answer that was never asked.' ;
     metaprops :: 'ontology.coding=SCT\\:131148009 [Bleeding (finding)]
quote=\\u00A74.1\\: "Plavix is contraindicated in patients with active pathological bleeding such as peptic ulcer or intracranial hemorrhage."
source=PLAVIX (clopidogrel) US Prescribing Information 2025, \\u00A74.1
' ;
     range ::"yes||yes","no||no";
     default_value ::"no";
end data.

data  :: 'age_years' ;
     type :: integer ;
     caption :: 'Age' ;
     description :: 'Age in years; prasugrel is generally not recommended at 75 years or older (EFFIENT Boxed Warning). Default 65 for running and testing: a typical adult with CCD, below the prasugrel age threshold of 75 years; the clinician records the actual value.' ;
     metaprops :: 'ontology.coding=SCT\\:424144002 [Current chronological age (observable entity)]
quote=Boxed Warning\\: "In patients \\u226575 years of age, Effient is generally not recommended, because of the increased risk of fatal and intracranial bleeding and uncertain benefit"
source=EFFIENT (prasugrel) US Prescribing Information 2022, Boxed Warning
' ;
     default_value ::65;
     unit :: 'years' ;
end data.

data  :: 'on_digoxin_or_diuretic' ;
     type :: text ;
     caption :: 'Taking digoxin or a diuretic?' ;
     description :: 'Taking digoxin or a diuretic (drugs that may cause hypomagnesemia); widens magnesium monitoring on pantoprazole to the short-DAPT regimen (PROTONIX §5.8). A composite flag with no single SNOMED CT concept, so it is left uncoded. Default "no" for running and testing: with the other baseline defaults it leads Antithrombotic_Regimen_Decision to Aspirin_Monotherapy; the clinician records the actual answer.' ;
     metaprops :: 'quote=\\u00A75.8\\: "For patients expected to be on prolonged treatment or who take PPIs with medications such as digoxin or drugs that may cause hypomagnesemia (e.g., diuretics)"
source=PROTONIX (pantoprazole) US Prescribing Information 2026, \\u00A75.8
' ;
     range ::"yes||yes","no||no";
     default_value ::"no";
end data.

