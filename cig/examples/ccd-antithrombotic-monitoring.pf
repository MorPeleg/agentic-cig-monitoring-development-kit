decision  :: 'Tests_Ordering_Recommendations_Bleeding' ;
     caption :: 'Which tests to order for suspected bleeding?' ;
     description :: 'When a bleeding symptom or unexplained hypotension (systolic blood pressure below 90 mmHg or diastolic blood pressure below 60 mmHg) is found by Monitor_Bleeding, which blood counts to order to evaluate blood loss. The monitor\'s performer instruction is to promptly evaluate signs of blood loss with hemoglobin and hematocrit.' ;
     metaprops :: 'ordered_for=Monitor_Bleeding
role=test_ordering
' ;
     precondition ::unusual_bleeding_or_bruising = true or hematuria = true or blood_in_stool = true or hematemesis = true or hemoptysis = true or syncope = true or sudden_severe_headache = true or systolic_bp < 90 or diastolic_bp < 60;
     choice_mode :: multiple ;
     candidate :: 'Hemoglobin' ;
          caption :: 'Hemoglobin' ;
          metaprops :: 'ontology.coding=LOINC\\:718-7
ontology.label=Hemoglobin [Mass/volume] in Blood
' ;
          argument :: for,true() attributes
               argument_name :: 'Arg_Order_Hemoglobin' ;
               caption :: 'Hemoglobin to quantify blood loss when bleeding symptoms or hypotension are found' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'Hematocrit' ;
          caption :: 'Hematocrit' ;
          metaprops :: 'ontology.coding=LOINC\\:4544-3
ontology.label=Hematocrit [Volume Fraction] of Blood by Automated count
' ;
          argument :: for,true() attributes
               argument_name :: 'Arg_Order_Hematocrit' ;
               caption :: 'Hematocrit to quantify blood loss when bleeding symptoms or hypotension are found' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
end decision.

enquiry  :: 'Monitor_Drug_Interactions' ;
     caption :: 'Review interacting medications at initiation, each visit and each new medicine' ;
     description :: 'Monitors loss of antithrombotic effect or excess bleeding from drug interactions with Prescribe_Aspirin, Prescribe_Clopidogrel, Prescribe_Ticagrelor, Prescribe_Vorapaxar, Prescribe_Low_Dose_Rivaroxaban and Prescribe_DOAC. The guideline repeats the FDA warning against omeprazole and esomeprazole with clopidogrel, and each label names interactions to avoid (aspirin over 100 mg with ticagrelor, strong CYP3A modulators with ticagrelor and vorapaxar, combined P-gp and CYP3A modulators with rivaroxaban and apixaban, P-gp modulators with dabigatran and edoxaban) plus digoxin level monitoring with ticagrelor. Order: interacting medication review (PPI choice with clopidogrel, aspirin dose with ticagrelor, CYP3A and P-gp inhibitors or inducers, other anticoagulants, SSRIs and SNRIs), at initiation, at each follow-up visit and whenever a new medicine is started. Patient: tell every clinician and pharmacist that you take an antiplatelet or anticoagulant and check with them before starting any prescription, over-the-counter medicine or herbal product such as St. John\'s wort. Clinician: avoid omeprazole and esomeprazole with clopidogrel, keep aspirin at 100 mg or less daily with ticagrelor, avoid strong CYP3A inhibitors or inducers with ticagrelor and vorapaxar, avoid combined P-gp and strong CYP3A inhibitors or inducers with rivaroxaban and apixaban (or reduce the apixaban dose by 50 percent per its label), avoid P-gp inducers with dabigatran and rifampin with edoxaban, monitor digoxin levels when ticagrelor is started or changed, and weigh the added bleeding risk of SSRIs, SNRIs and other anticoagulants.' ;
     metaprops :: 'ServiceRequest.code=interacting medication review (PPI choice with clopidogrel, aspirin dose with ticagrelor, CYP3A and P-gp inhibitors or inducers, other anticoagulants, SSRIs and SNRIs)
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=at initiation, at each follow-up visit and whenever a new medicine is started
ServiceRequest.patientInstruction=tell every clinician and pharmacist that you take an antiplatelet or anticoagulant and check with them before starting any prescription, over-the-counter medicine or herbal product such as St. John\'s wort
ServiceRequest.performerInstruction=avoid omeprazole and esomeprazole with clopidogrel, keep aspirin at 100 mg or less daily with ticagrelor, avoid strong CYP3A inhibitors or inducers with ticagrelor and vorapaxar, avoid combined P-gp and strong CYP3A inhibitors or inducers with rivaroxaban and apixaban (or reduce the apixaban dose by 50 percent per its label), avoid P-gp inducers with dabigatran and rifampin with edoxaban, monitor digoxin levels when ticagrelor is started or changed, and weigh the added bleeding risk of SSRIs, SNRIs and other anticoagulants
applies_when=all_patients_on_therapy
assistant_invention=grouping the label interaction warnings into one medication-reconciliation task at each visit and at each new medicine
category=undesired_ade
cq=CQ6, CQ8
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= interacting medication review (PPI choice with clopidogrel, aspirin dose with ticagrelor, CYP3A and P-gp inhibitors or inducers, other anticoagulants, SSRIs and SNRIs); ServiceRequest.occurrenceTiming \\= at initiation, at each follow-up visit and whenever a new medicine is started; ServiceRequest.patientInstruction \\= tell every clinician and pharmacist that you take an antiplatelet or anticoagulant and check with them before starting any prescription, over-the-counter medicine or herbal product such as St. John\'s wort; ServiceRequest.performerInstruction \\= avoid omeprazole and esomeprazole with clopidogrel, keep aspirin at 100 mg or less daily with ticagrelor, avoid strong CYP3A inhibitors or inducers with ticagrelor and vorapaxar, avoid combined P-gp and strong CYP3A inhibitors or inducers with rivaroxaban and apixaban (or reduce the apixaban dose by 50 percent per its label), avoid P-gp inducers with dabigatran and rifampin with edoxaban, monitor digoxin levels when ticagrelor is started or changed, and weigh the added bleeding risk of SSRIs, SNRIs and other anticoagulants
goal.verb=order
guideline_status=not_specified_as_a_guideline_monitoring_task
instrument=medication reconciliation by clinician or pharmacist
knowledge_origin=guideline text 16 and the drug labels\' interaction warnings
literature_basis=the guideline repeats the FDA warning against omeprazole and esomeprazole with clopidogrel, and each label names interactions to avoid (aspirin over 100 mg with ticagrelor, strong CYP3A modulators with ticagrelor and vorapaxar, combined P-gp and CYP3A modulators with rivaroxaban and apixaban, P-gp modulators with dabigatran and edoxaban) plus digoxin level monitoring with ticagrelor
monitored_target=loss of antithrombotic effect or excess bleeding from drug interactions with Prescribe_Aspirin, Prescribe_Clopidogrel, Prescribe_Ticagrelor, Prescribe_Vorapaxar, Prescribe_Low_Dose_Rivaroxaban and Prescribe_DOAC
monitoring_frequency_basis=at initiation and whenever the medication list changes, because the risk arises from a new co-medication
monitoring_stance=recommended
