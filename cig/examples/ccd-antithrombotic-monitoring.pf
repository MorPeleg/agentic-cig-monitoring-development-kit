               caption :: 'Serum potassium for the hypokalemia that can accompany hypomagnesemia' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
end decision.

enquiry  :: 'Monitor_PPI_Bone_Fracture' ;
     caption :: 'Review fracture and osteoporosis risk during long-term pantoprazole' ;
     description :: 'Monitors osteoporosis-related fracture as a labeled adverse effect of long-term Prescribe_PPI. The label links long-term (a year or longer) and high-dose PPI use to hip, wrist and spine fractures and advises managing at-risk patients per osteoporosis guidelines. Order: fracture history and osteoporosis risk review during long-term pantoprazole, every 12 months while pantoprazole continues for 1 year or longer, and on any fracture. Patient: report any fracture, especially of the hip, wrist or spine. Clinician: when pantoprazole continues for a year or longer, assess osteoporosis and fracture risk per current osteoporosis guidelines and use the lowest PPI dose for the shortest duration.' ;
     metaprops :: 'ServiceRequest.code=fracture history and osteoporosis risk review during long-term pantoprazole
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=every 12 months while pantoprazole continues for 1 year or longer, and on any fracture
ServiceRequest.patientInstruction=report any fracture, especially of the hip, wrist or spine
ServiceRequest.performerInstruction=when pantoprazole continues for a year or longer, assess osteoporosis and fracture risk per current osteoporosis guidelines and use the lowest PPI dose for the shortest duration
applies_when=patients on pantoprazole for a year or longer (during extended DAPT after MI)
assistant_invention=the yearly review and limiting it to extended DAPT, the only regimen in this CIG where the PPI runs beyond a year
category=undesired_ade
cq=CQ3, CQ7, CQ9
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= fracture history and osteoporosis risk review during long-term pantoprazole; ServiceRequest.occurrenceTiming \\= every 12 months while pantoprazole continues for 1 year or longer, and on any fracture; ServiceRequest.patientInstruction \\= report any fracture, especially of the hip, wrist or spine; ServiceRequest.performerInstruction \\= when pantoprazole continues for a year or longer, assess osteoporosis and fracture risk per current osteoporosis guidelines and use the lowest PPI dose for the shortest duration
goal.verb=order
guideline_status=not_specified_as_a_guideline_monitoring_task
instrument=clinician review of fracture history and osteoporosis risk factors
knowledge_origin=pantoprazole \\u00A75.4
literature_basis=the label links long-term (a year or longer) and high-dose PPI use to hip, wrist and spine fractures and advises managing at-risk patients per osteoporosis guidelines
monitored_target=osteoporosis-related fracture as a labeled adverse effect of long-term Prescribe_PPI
monitoring_frequency_basis=proposed yearly review, matching the one-year threshold in the label
monitoring_stance=proposed_by_assistant
provenance_type=package_insert_specified
quote.1=\\u00A75.4\\: "The risk of fracture was increased in patients who received high-dose, defined as multiple daily doses, and long-term PPI therapy (a year or longer)."
quote.2=\\u00A717\\: "Advise patients to report any fractures, especially of the hip, wrist or spine, to their healthcare provider"
source.1=PROTONIX (pantoprazole) US Prescribing Information 2026, \\u00A75.4
source.2=PROTONIX (pantoprazole) US Prescribing Information 2026, \\u00A717
source_kind=package_insert
trigger=any new fracture
' ;
     precondition ::result_of(Antithrombotic_Regimen_Decision) = Extended_DAPT and previous_mi = "yes";
     source :: 'new_fracture' ;
          data_definition :: 'new_fracture' ;
          mandatory :: no ;
     source :: 'suspected_ppi_bone_fracture' ;
          data_definition :: 'suspected_ppi_bone_fracture' ;
          mandatory :: no ;
end enquiry.

action  :: 'Alert_Further_Examination_PPI_Bone_Fracture' ;
     caption :: 'Alert: further examination of osteoporosis-related bone fracture' ;
     description :: 'Monitors suspected osteoporosis-related bone fracture recorded by Monitor_PPI_Bone_Fracture (osteoporosis-related fracture as a labeled adverse effect of long-term Prescribe_PPI). The pantoprazole label reports an increased fracture risk with high-dose and long-term PPI therapy and asks patients to report fractures, and names no laboratory or imaging test. The sources name no test, so, following Mor Peleg\'s know-how of 4 Nov 2026, this step alerts the clinician to examine the patient further and decide on work-up instead of ordering a test.' ;
