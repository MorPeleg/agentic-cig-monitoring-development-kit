          ltwh :: 40,840,0,0;
     component :: 'Prescribe_PPI' ;
          caption :: 'Prescribe pantoprazole 40 mg once daily for gastroprotection' ;
          description :: 'Rec 16 [2a, B-R]: in CCD on DAPT a PPI can reduce gastrointestinal bleeding risk. Pantoprazole is the PPI because it has no clinically important interaction with clopidogrel; it is also given during DOAC plus antiplatelet therapy, which starts as triple therapy (approved open question 7, off-label for this indication).' ;
          metaprops :: 'ontology.coding=SCT\\:395821003 [Pantoprazole (substance)]
' ;
          task_definition :: 'Prescribe_PPI' ;
          schedule_constraint :: completed('Advise_Avoid_Chronic_NSAIDs') ;
          ltwh :: 40,940,0,0;
end plan.

action  :: 'Monitor_Antithrombotic_Adherence' ;
     caption :: 'Monitor adherence to the antithrombotic regimen (visit review with refill check)' ;
     description :: 'Monitors completion of the prescribed antithrombotic regimen (Prescribe_Aspirin, Prescribe_Clopidogrel, Prescribe_Ticagrelor, Prescribe_Prasugrel, Prescribe_Vorapaxar, Prescribe_Low_Dose_Rivaroxaban, Prescribe_DOAC). The DOAC labels warn that premature discontinuation increases thrombotic events and advise anticoagulant coverage, and the P2Y12 and vorapaxar labels tell clinicians to avoid lapses and patients not to stop without the prescriber.' ;
     metaprops :: 'ServiceRequest.code=antithrombotic adherence review (each prescribed antiplatelet or anticoagulant taken daily as prescribed, with no unplanned interruption)
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=each follow-up visit, at 1, 3, 6 and 12 months after starting or changing the regimen, then every 6 to 12 months
ServiceRequest.patientInstruction=take each antiplatelet or anticoagulant every day as prescribed and do not stop or skip it without talking to the prescribing clinician, including before dental or other procedures
ServiceRequest.performerInstruction=if a lapse or unplanned stop is found, restart as soon as medically appropriate, and if an oral anticoagulant was stopped for a reason other than bleeding or completed therapy consider coverage with another anticoagulant
applies_when=all_patients_on_therapy
assistant_invention=the visit cadence (aligned with the Figure 9 transition points at 1, 3, 6 and 12 months) and the adherence interview as the instrument
category=action_completion
cq=CQ5, CQ8
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= antithrombotic adherence review (each prescribed antiplatelet or anticoagulant taken daily as prescribed, with no unplanned interruption); ServiceRequest.occurrenceTiming \\= each follow-up visit, at 1, 3, 6 and 12 months after starting or changing the regimen, then every 6 to 12 months; ServiceRequest.patientInstruction \\= take each antiplatelet or anticoagulant every day as prescribed and do not stop or skip it without talking to the prescribing clinician, including before dental or other procedures; ServiceRequest.performerInstruction \\= if a lapse or unplanned stop is found, restart as soon as medically appropriate, and if an oral anticoagulant was stopped for a reason other than bleeding or completed therapy consider coverage with another anticoagulant
goal.verb=order
guideline_status=not_specified_as_a_guideline_monitoring_task
instrument=clinician interview with pharmacy refill check
knowledge_origin=drug label warnings on premature discontinuation, operationalized as a visit check by the assistant
literature_basis=the DOAC labels warn that premature discontinuation increases thrombotic events and advise anticoagulant coverage, and the P2Y12 and vorapaxar labels tell clinicians to avoid lapses and patients not to stop without the prescriber
monitored_target=completion of the prescribed antithrombotic regimen (Prescribe_Aspirin, Prescribe_Clopidogrel, Prescribe_Ticagrelor, Prescribe_Prasugrel, Prescribe_Vorapaxar, Prescribe_Low_Dose_Rivaroxaban, Prescribe_DOAC)
monitoring_frequency_basis=proposed, tied to the regimen transition points of Figure 9 (1, 3, 6 and 12 months) and then routine CCD follow-up; the guideline and labels give no cadence
monitoring_stance=proposed_by_assistant
provenance_type=assistant_completed_from_guidelines
quote.1=Boxed Warning (A)\\: "Premature discontinuation of any oral anticoagulant, including XARELTO, increases the risk of thrombotic events."
quote.2=\\u00A75.3\\: "Lapses in therapy should be avoided"
quote.3=\\u00A717\\: "Inform patients not to discontinue ZONTIVITY without discussing it with the prescribing physician."
source.1=XARELTO (rivaroxaban) US Prescribing Information 2026, Boxed Warning (A) and \\u00A75.1
source.2=EFFIENT (prasugrel) US Prescribing Information 2022, \\u00A75.3 Discontinuation
source.3=ZONTIVITY (vorapaxar) US Prescribing Information 2022, \\u00A717
source_kind=package_insert
trigger=an unplanned stop or missed doses of an antithrombotic
' ;
     procedure :: 'Antithrombotic adherence review (each prescribed antiplatelet or anticoagulant taken daily as prescribed, with no unplanned interruption), each follow-up visit, at 1, 3, 6 and 12 months after starting or changing the regimen, then every 6 to 12 months. Patient: take each antiplatelet or anticoagulant every day as prescribed and do not stop or skip it without talking to the prescribing clinician, including before dental or other procedures. Clinician: if a lapse or unplanned stop is found, restart as soon as medically appropriate, and if an oral anticoagulant was stopped for a reason other than bleeding or completed therapy consider coverage with another anticoagulant.' ;
end action.

action  :: 'Monitor_Regimen_Duration' ;
     caption :: 'Review regimen duration and step-down against Figure 9 (1, 3, 6, 12 months, then yearly)' ;
     description :: 'Monitors completion of the regimen durations chosen by Antithrombotic_Regimen_Decision and delivered by Prescribe_Aspirin, Prescribe_Clopidogrel, Prescribe_Ticagrelor, Prescribe_Prasugrel, Prescribe_Vorapaxar, Prescribe_Low_Dose_Rivaroxaban and Prescribe_DOAC. The guideline fixes the duration of each regimen (Figure 9, Recs 2, 3, 11 to 13) and says validated bleeding-risk scores help choose the duration, but gives no review schedule.' ;
     metaprops :: 'ServiceRequest.code=antithrombotic regimen duration and step-down review against Figure 9, with bleeding and ischemic risk reassessment by a validated score (PRECISE-DAPT, DAPT or PARIS)
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=at 1, 3, 6 and 12 months after PCI or ACS, then every 12 months
ServiceRequest.patientInstruction=do not stop or add an antiplatelet or anticoagulant on your own and bring all your medicines to each review so the clinician can confirm which ones continue
ServiceRequest.performerInstruction=step down as planned, without an anticoagulant go from DAPT to single antiplatelet therapy at 6 months after PCI (Rec 2) or stop aspirin after 1 to 3 months for high bleeding risk with a drug-eluting stent (Rec 3), with an anticoagulant stop aspirin after 1 to 4 weeks (up to 1 month if high thrombotic and low bleeding risk, Rec 11 and 12) and clopidogrel at 6 months, consider DOAC alone 1 year after PCI (Rec 13), and reassess extended DAPT, vorapaxar and low-dose rivaroxaban every year
applies_when=all_patients_on_therapy
assistant_invention=the review points (1, 3, 6, 12 months, then yearly) and the yearly reassessment of the 2b add-on options
category=action_completion
cq=CQ2, CQ5, CQ8
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= antithrombotic regimen duration and step-down review against Figure 9, with bleeding and ischemic risk reassessment by a validated score (PRECISE-DAPT, DAPT or PARIS); ServiceRequest.occurrenceTiming \\= at 1, 3, 6 and 12 months after PCI or ACS, then every 12 months; ServiceRequest.patientInstruction \\= do not stop or add an antiplatelet or anticoagulant on your own and bring all your medicines to each review so the clinician can confirm which ones continue; ServiceRequest.performerInstruction \\= step down as planned, without an anticoagulant go from DAPT to single antiplatelet therapy at 6 months after PCI (Rec 2) or stop aspirin after 1 to 3 months for high bleeding risk with a drug-eluting stent (Rec 3), with an anticoagulant stop aspirin after 1 to 4 weeks (up to 1 month if high thrombotic and low bleeding risk, Rec 11 and 12) and clopidogrel at 6 months, consider DOAC alone 1 year after PCI (Rec 13), and reassess extended DAPT, vorapaxar and low-dose rivaroxaban every year
goal.verb=order
guideline_status=not_specified_as_a_guideline_monitoring_task
instrument=clinician medication review with a validated bleeding-risk score (PRECISE-DAPT, DAPT or PARIS)
knowledge_origin=guideline durations (Recs 2, 3, 11\\u201313, Figure 9) and the Synopsis on risk scores
literature_basis=the guideline fixes the duration of each regimen (Figure 9, Recs 2, 3, 11 to 13) and says validated bleeding-risk scores help choose the duration, but gives no review schedule
monitored_target=completion of the regimen durations chosen by Antithrombotic_Regimen_Decision and delivered by Prescribe_Aspirin, Prescribe_Clopidogrel, Prescribe_Ticagrelor, Prescribe_Prasugrel, Prescribe_Vorapaxar, Prescribe_Low_Dose_Rivaroxaban and Prescribe_DOAC
monitoring_frequency_basis=the review points are the step-down times of Figure 9 (1 month, 1 to 3 months, 6 months, 12 months), then yearly
monitoring_stance=proposed_by_assistant
provenance_type=assistant_completed_from_guidelines
quote.1=p.e50, Rec 2\\: "dual antiplatelet therapy (DAPT) consisting of aspirin and clopidogrel for 6 months post PCI followed by single antiplatelet therapy (SAPT) is indicated"
quote.2=p.e50, Rec 11\\: "DAPT for 1 to 4 weeks followed by clopidogrel alone for 6 months should be administered in addition to DOAC"
quote.3=p.e50, Synopsis\\: "The use of validated risk scores to address bleeding risk can be useful in choice and duration of antiplatelet therapy."
source.1=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 2 (p.e50)
source.2=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 11 (p.e50)
source.3=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Synopsis (p.e50)
source_kind=clinical_guideline
trigger=a bleeding or new ischemic event prompts an earlier review
' ;
     procedure :: 'Antithrombotic regimen duration and step-down review against Figure 9, with bleeding and ischemic risk reassessment by a validated score (PRECISE-DAPT, DAPT or PARIS), at 1, 3, 6 and 12 months after PCI or ACS, then every 12 months. Patient: do not stop or add an antiplatelet or anticoagulant on your own and bring all your medicines to each review so the clinician can confirm which ones continue. Clinician: step down as planned, without an anticoagulant go from DAPT to single antiplatelet therapy at 6 months after PCI (Rec 2) or stop aspirin after 1 to 3 months for high bleeding risk with a drug-eluting stent (Rec 3), with an anticoagulant stop aspirin after 1 to 4 weeks (up to 1 month if high thrombotic and low bleeding risk, Rec 11 and 12) and clopidogrel at 6 months, consider DOAC alone 1 year after PCI (Rec 13), and reassess extended DAPT, vorapaxar and low-dose rivaroxaban every year.' ;
end action.

action  :: 'Monitor_NSAID_Avoidance' ;
     caption :: 'Check for chronic NSAID use at each visit' ;
     description :: 'Monitors avoidance of chronic NSAIDs (avoid goal of Advise_Avoid_Chronic_NSAIDs). The guideline says chronic NSAIDs should not be used in CCD (3: Harm), and the antithrombotic labels add the bleeding interaction, but neither says how to check.' ;
     metaprops :: 'ServiceRequest.code=chronic NSAID use check (prescription and over-the-counter, including ibuprofen, naproxen, diclofenac and coxibs)
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=each follow-up visit and whenever a new pain medicine is started
ServiceRequest.patientInstruction=do not take ibuprofen, naproxen, diclofenac, celecoxib or other NSAID pain relievers regularly and ask your clinician or pharmacist before taking any over-the-counter pain medicine
ServiceRequest.performerInstruction=if chronic NSAID use is found, advise stopping it and review the pain indication for a non-NSAID option
applies_when=all_patients_on_therapy
assistant_invention=the medication check at each visit
category=action_completion
cq=CQ6, CQ8
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= chronic NSAID use check (prescription and over-the-counter, including ibuprofen, naproxen, diclofenac and coxibs); ServiceRequest.occurrenceTiming \\= each follow-up visit and whenever a new pain medicine is started; ServiceRequest.patientInstruction \\= do not take ibuprofen, naproxen, diclofenac, celecoxib or other NSAID pain relievers regularly and ask your clinician or pharmacist before taking any over-the-counter pain medicine; ServiceRequest.performerInstruction \\= if chronic NSAID use is found, advise stopping it and review the pain indication for a non-NSAID option
goal.verb=order
guideline_status=not_specified_as_a_guideline_monitoring_task
instrument=clinician medication reconciliation
knowledge_origin=guideline Rec 10 and the clopidogrel label interaction
literature_basis=the guideline says chronic NSAIDs should not be used in CCD (3\\: Harm), and the antithrombotic labels add the bleeding interaction, but neither says how to check
monitored_target=avoidance of chronic NSAIDs (avoid goal of Advise_Avoid_Chronic_NSAIDs)
monitoring_frequency_basis=proposed, at each routine visit because NSAIDs are often bought over the counter
monitoring_stance=proposed_by_assistant
provenance_type=assistant_completed_from_guidelines
quote.1=p.e50, Rec 10\\: "chronic nonsteroidal anti-inflammatory drugs should not be used because of increased cardiovascular and bleeding complications"
quote.2=\\u00A77.4\\: "Coadministration of Plavix and NSAIDs increases the risk of gastrointestinal bleeding."
source.1=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 10 (p.e50)
source.2=PLAVIX (clopidogrel) US Prescribing Information 2025, \\u00A77.4 NSAIDs
source_kind=clinical_guideline_plus_package_insert
trigger=none
' ;
     procedure :: 'Chronic NSAID use check (prescription and over-the-counter, including ibuprofen, naproxen, diclofenac and coxibs), each follow-up visit and whenever a new pain medicine is started. Patient: do not take ibuprofen, naproxen, diclofenac, celecoxib or other NSAID pain relievers regularly and ask your clinician or pharmacist before taking any over-the-counter pain medicine. Clinician: if chronic NSAID use is found, advise stopping it and review the pain indication for a non-NSAID option.' ;
end action.

action  :: 'Monitor_PPI_Continued_Need' ;
     caption :: 'Review the continued need for pantoprazole at each visit and step-down' ;
     description :: 'Monitors delivery and timely stop of gastroprotection (avoid goal of Prescribe_PPI). The guideline supports a PPI while on DAPT, and the label asks for the shortest PPI duration appropriate to the condition.' ;
     metaprops :: 'ServiceRequest.code=review of continued pantoprazole need during combined antithrombotic therapy
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=each follow-up visit and whenever DAPT or antiplatelet plus anticoagulant therapy is stepped down
ServiceRequest.patientInstruction=keep taking pantoprazole while you take two blood thinners and ask at each visit whether you still need it
ServiceRequest.performerInstruction=continue pantoprazole while the patient is on DAPT or an antiplatelet plus an anticoagulant, and when that combination ends stop it unless another indication remains, using the shortest PPI duration appropriate to the condition
applies_when=all_patients_on_therapy
assistant_invention=tying the stop of the PPI to the end of the combined antithrombotic therapy
category=action_completion
cq=CQ7, CQ8
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= review of continued pantoprazole need during combined antithrombotic therapy; ServiceRequest.occurrenceTiming \\= each follow-up visit and whenever DAPT or antiplatelet plus anticoagulant therapy is stepped down; ServiceRequest.patientInstruction \\= keep taking pantoprazole while you take two blood thinners and ask at each visit whether you still need it; ServiceRequest.performerInstruction \\= continue pantoprazole while the patient is on DAPT or an antiplatelet plus an anticoagulant, and when that combination ends stop it unless another indication remains, using the shortest PPI duration appropriate to the condition
goal.verb=order
guideline_status=not_specified_as_a_guideline_monitoring_task
instrument=clinician medication review
knowledge_origin=guideline Rec 16 and the pantoprazole label
literature_basis=the guideline supports a PPI while on DAPT, and the label asks for the shortest PPI duration appropriate to the condition
monitored_target=delivery and timely stop of gastroprotection (avoid goal of Prescribe_PPI)
monitoring_frequency_basis=proposed, at each visit and at each step-down of Figure 9
monitoring_stance=proposed_by_assistant
provenance_type=assistant_completed_from_guidelines
quote.1=p.e50, Rec 16\\: "In patients with CCD on DAPT, the use of a PPI can be effective in reducing gastrointestinal bleeding risk"
quote.2=\\u00A75.10\\: "Use the shortest duration of PPI therapy appropriate to the condition being treated."
source.1=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 16 (p.e50)
source.2=PROTONIX (pantoprazole) US Prescribing Information 2026, \\u00A75.10 Fundic Gland Polyps
