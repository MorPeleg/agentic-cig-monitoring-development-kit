data  :: 'cyp2c19_status' ;
     type :: text ;
     caption :: 'CYP2C19 genotype result on file?' ;
     description :: 'The CYP2C19 genotype result on file: poor metabolizer, not a poor metabolizer, or unknown (no result). Asked by Monitor_CYP2C19_Poor_Metabolizer. The SNOMED CT concept names the result the clopidogrel label acts on (CYP2C19 poor metabolizer).' ;
     metaprops :: 'ontology.coding=SNOMED\\:738786005
ontology.label=Cytochrome P450 family 2 subfamily C member 19 poor metabolizer (finding)
' ;
     range ::"poor_metabolizer","not_poor_metabolizer","unknown";
end data.

data  :: 'ischemic_event_on_clopidogrel' ;
     type :: boolean ;
     caption :: 'Ischemic event (new chest pain, MI or stroke symptoms) while on clopidogrel?' ;
     description :: 'An ischemic event while on clopidogrel, which prompts CYP2C19 testing. Asked by Monitor_CYP2C19_Poor_Metabolizer. The SNOMED CT concept is broader (acute coronary syndrome) and does not cover stroke.' ;
     metaprops :: 'ontology.coding=SNOMED\\:394659003
ontology.label=Acute coronary syndrome (disorder)
' ;
end data.

