/** PROforma version 1.9 (plain text) **/

/** IMPORTANT: Keep all your comments below the engine_version line **/
engine_version :: '1.9' ;

metadata  :: 'ccd_antithrombotic_monitoring' ;
     title :: 'CCD Antithrombotic Therapy and Monitoring (2023 AHA/ACC CCD Guideline §4.3.1)' ;
     desc :: 'PROforma CIG for antiplatelet and oral anticoagulant therapy in adults with chronic coronary disease, from section 4.3.1 of the 2023 AHA/ACC chronic coronary disease guideline and the US prescribing information of its drugs. It collects the patient data the regimen choice depends on, recommends an antithrombotic regimen and a P2Y12 inhibitor, delivers the drugs with NSAID avoidance and gastroprotection, and monitors completion of the recommendations, the desired reduction of ischemic events and the adverse drug effects, with a test step or a further-examination alert after each adverse-effect enquiry. The task set is the one fixed by the approved proposal.' ;
     version :: '1.0' ;
     author :: 'Antonio Zaitoun' ;
end metadata.

metaprops :: 'goal.noun_phrase=chronic coronary disease in adults, antiplatelet and oral anticoagulant therapy to prevent cardiovascular events with monitoring of adherence, ischemic events and adverse drug effects
goal.verb=treat
' ;

plan  :: 'ccd_antithrombotic_monitoring' ;
     caption :: 'CCD Antithrombotic Therapy and Monitoring (2023 AHA/ACC CCD Guideline §4.3.1)' ;
     metaprops :: 'goal.noun_phrase=chronic coronary disease in adults, antiplatelet and oral anticoagulant therapy to prevent cardiovascular events with monitoring of adherence, ischemic events and adverse drug effects
goal.verb=treat
' ;
     component :: 'Get_Antithrombotic_Data' ;
          caption :: 'Collect the patient data for antithrombotic regimen selection' ;
          description :: 'Collects the patient data that the regimen and P2Y12-agent decisions, the therapy-plan gate and the population-scoped monitors read (§4.3.1 Recs 1-16, Figure 9 and the label contraindications). Also collected for the clinician at baseline (no condition reads them): hemoglobin, platelet count, serum creatinine and Cockcroft-Gault creatinine clearance, body weight, serum magnesium, the CYP2C19 genotype if known, and the current medication list. Body weight and creatinine clearance set the doses written in the procedures.' ;
          task_definition :: 'Get_Antithrombotic_Data' ;
          ltwh :: 40,40,0,0;
     component :: 'Antithrombotic_Regimen_Decision' ;
          caption :: 'Choose the antithrombotic regimen' ;
          description :: 'Chooses the antithrombotic regimen for a patient with CCD along the Figure 9 pathways and §4.3.1 Recs 1-16. Single choice with the default recommendation netsupport() > 0: several candidates can be recommended at once (for example the 2a/2b add-on options after MI) and the clinician commits one. Section 4.3.1 defers bare-metal stents to the 2016 AHA/ACC DAPT guideline, so no candidate is recommended for PCI with high bleeding risk and a bare-metal stent.' ;
          task_definition :: 'Antithrombotic_Regimen_Decision' ;
          schedule_constraint :: completed('Get_Antithrombotic_Data') ;
          ltwh :: 40,140,0,0;
     component :: 'Antithrombotic_Therapy' ;
          caption :: 'Antithrombotic therapy (when there is no active pathological bleeding)' ;
          description :: 'Delivers the chosen antithrombotic regimen: NSAID-avoidance advice first, then the P2Y12-agent decision and the drug actions, each gated by the regimen it belongs to. The whole plan is skipped when there is active pathological bleeding, which every antithrombotic label contraindicates.' ;
          task_definition :: 'Antithrombotic_Therapy' ;
          schedule_constraint :: completed('Antithrombotic_Regimen_Decision') ;
          ltwh :: 40,240,0,0;
     component :: 'Monitoring_Plan' ;
          caption :: 'Monitor antithrombotic therapy' ;
          description :: 'Monitors completion of the antithrombotic recommendations, the desired outcome and the adverse drug effects, in three parallel sub-plans.' ;
          task_definition :: 'Monitoring_Plan' ;
          schedule_constraint :: completed('Antithrombotic_Therapy') ;
          ltwh :: 40,340,0,0;
end plan.

