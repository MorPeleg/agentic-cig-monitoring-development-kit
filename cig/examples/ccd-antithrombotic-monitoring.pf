source.7=BRILINTA (ticagrelor) US Prescribing Information 2026, \\u00A77.5 Digoxin
source.8=Low Dose Aspirin 81 mg OTC Drug Facts label 2026, Stomach bleeding warning
source_kind=clinical_guideline_plus_package_insert
