enquiry  :: 'Monitor_PPI_Hypomagnesemia' ;
     caption :: 'Monitor serum magnesium on pantoprazole' ;
     description :: 'Monitors hypomagnesemia as a labeled adverse effect of Prescribe_PPI. The label\'s own instruction is to consider magnesium before starting and periodically in patients on prolonged treatment or on digoxin or diuretics. Order: serum magnesium, baseline before starting pantoprazole, then every 12 months while it continues, and on symptoms. Patient: report muscle cramps, tremor, spasms, palpitations, an irregular heartbeat or seizures. Clinician: if magnesium is low, check calcium and potassium, replace magnesium and reconsider the PPI.' ;
     metaprops :: 'ServiceRequest.code=serum magnesium
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=baseline before starting pantoprazole, then every 12 months while it continues, and on symptoms
ServiceRequest.patientInstruction=report muscle cramps, tremor, spasms, palpitations, an irregular heartbeat or seizures
ServiceRequest.performerInstruction=if magnesium is low, check calcium and potassium, replace magnesium and reconsider the PPI
applies_when=patients on pantoprazole expected to take it for 6 months or longer (DAPT, extended DAPT or DOAC plus antiplatelet) or taking it with digoxin or a diuretic
assistant_invention=every 12 months as the periodic interval, and treating 6 months or more as prolonged
category=undesired_ade
cq=CQ3, CQ7, CQ9
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= serum magnesium; ServiceRequest.occurrenceTiming \\= baseline before starting pantoprazole, then every 12 months while it continues, and on symptoms; ServiceRequest.patientInstruction \\= report muscle cramps, tremor, spasms, palpitations, an irregular heartbeat or seizures; ServiceRequest.performerInstruction \\= if magnesium is low, check calcium and potassium, replace magnesium and reconsider the PPI
goal.verb=order
guideline_status=not_specified_as_a_guideline_monitoring_task
instrument=serum magnesium (with calcium and potassium if low)
knowledge_origin=pantoprazole \\u00A75.8
literature_basis=the label\'s own instruction is to consider magnesium before starting and periodically in patients on prolonged treatment or on digoxin or diuretics
monitored_target=hypomagnesemia as a labeled adverse effect of Prescribe_PPI
monitoring_frequency_basis=label-specified baseline and periodic testing, with a proposed 12-month interval
monitoring_stance=recommended
provenance_type=package_insert_specified
quote.1=\\u00A75.8\\: "For patients expected to be on prolonged treatment or who take PPIs with medications such as digoxin or drugs that may cause hypomagnesemia (e.g., diuretics)"
quote.2=\\u00A75.8\\: "health care professionals may consider monitoring magnesium levels prior to initiation of PPI treatment and periodically"
source.1=PROTONIX (pantoprazole) US Prescribing Information 2026, \\u00A75.8
source.2=PROTONIX (pantoprazole) US Prescribing Information 2026, \\u00A75.8
source_kind=package_insert
trigger=cramps, tremor, arrhythmia or seizures
' ;
     precondition ::(result_of(Antithrombotic_Regimen_Decision) = DAPT or result_of(Antithrombotic_Regimen_Decision) = Extended_DAPT or result_of(Antithrombotic_Regimen_Decision) = DOAC_plus_Antiplatelet) or (result_of(Antithrombotic_Regimen_Decision) = Short_DAPT_then_P2Y12_Monotherapy and on_digoxin_or_diuretic = "yes");
     source :: 'muscle_cramps_or_spasms' ;
          data_definition :: 'muscle_cramps_or_spasms' ;
          mandatory :: no ;
     source :: 'palpitations' ;
          data_definition :: 'palpitations' ;
          mandatory :: no ;
     source :: 'seizure' ;
          data_definition :: 'seizure' ;
          mandatory :: no ;
     source :: 'tremor' ;
          data_definition :: 'tremor' ;
          mandatory :: no ;
end enquiry.

decision  :: 'Tests_Ordering_Recommendations_PPI_Hypomagnesemia' ;
     caption :: 'Which tests to order for suspected hypomagnesemia?' ;
     description :: 'When a symptom of hypomagnesemia is found by Monitor_PPI_Hypomagnesemia, which electrolytes to order. The label asks to consider magnesium before starting the PPI and periodically; that scheduled check is part of the monitor\'s ServiceRequest.occurrenceTiming (baseline before starting pantoprazole, then every 12 months while it continues), not a data item. The monitor checks calcium and potassium when magnesium is low.' ;
