          caption :: 'Aspirin 81 mg plus rivaroxaban 2.5 mg twice daily' ;
          description :: 'Rec 15: high thrombotic risk with low or moderate bleeding risk, no oral anticoagulant indication and no recent PCI or ACS.' ;
          argument :: for,requires_oral_anticoagulation = "no" and pci_within_12_months = "no" and acs_within_12_months = "no" and high_thrombotic_risk = "yes" and high_bleeding_risk = "no" attributes
               argument_name :: 'Arg_Low_Dose_Rivaroxaban' ;
               caption :: 'Rec 15 [2a, B-R]: high thrombotic risk, not at high bleeding risk, no PCI or ACS in the past 12 months' ;
               metaprops :: 'quote=p.e50, Rec 15\\: "the addition of low-dose rivaroxaban 2.5 mg twice daily to aspirin 81 mg daily is reasonable for long-term reduction of risk for MACE"
