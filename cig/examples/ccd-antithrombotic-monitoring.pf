goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= further clinical examination for suspected cutaneous or systemic lupus erythematosus; ServiceRequest.occurrenceTiming \\= event-triggered, at the monitoring visit when cutaneous or systemic lupus erythematosus is suspected; ServiceRequest.patientInstruction \\= attend the examination and report any new or worsening rash on sun-exposed skin or new joint pain; ServiceRequest.performerInstruction \\= examine the patient for cutaneous or systemic lupus erythematosus and decide on further work-up and specialist referral (the label asks for specialist referral and orders no test, and mentions ANA only as a result that may be positive, so none is ordered)
goal.verb=order
guideline_status=not_specified_as_a_guideline_monitoring_task
instrument=clinician examination
knowledge_origin=Mor Peleg\'s know-how of 4 Nov 2026 (a suspected ADE whose sources name no test alerts the clinician to examine further), applied to the label passages of Monitor_PPI_Cutaneous_Lupus
literature_basis=the pantoprazole label asks to discontinue the drug and refer the patient to a specialist when signs or symptoms of CLE or SLE are noted, and mentions serological testing (e.g. ANA) only as a result that may be positive, without asking for any laboratory or imaging test
monitored_target=suspected cutaneous or systemic lupus erythematosus recorded by Monitor_PPI_Cutaneous_Lupus (cutaneous or systemic lupus erythematosus as a labeled adverse effect of Prescribe_PPI)
monitoring_frequency_basis=event-driven, each time Monitor_PPI_Cutaneous_Lupus records a suspicion
monitoring_stance=symptom_triggered_only
provenance_type=assistant_completed_from_guidelines
quote.1=\\u00A75.6\\: "If signs or symptoms consistent with CLE or SLE are noted in patients receiving PROTONIX, discontinue the drug and refer the patient to the appropriate specialist"
role=ade_alert
source.1=PROTONIX (pantoprazole) US Prescribing Information 2026, \\u00A75.6
source_kind=package_insert
trigger=suspected_ppi_cutaneous_lupus recorded as yes by Monitor_PPI_Cutaneous_Lupus
' ;
     precondition ::(result_of(Antithrombotic_Regimen_Decision) = DAPT or result_of(Antithrombotic_Regimen_Decision) = Short_DAPT_then_P2Y12_Monotherapy or result_of(Antithrombotic_Regimen_Decision) = Extended_DAPT or result_of(Antithrombotic_Regimen_Decision) = DOAC_plus_Antiplatelet) and suspected_ppi_cutaneous_lupus = "yes";
     procedure :: 'Further clinical examination for suspected cutaneous or systemic lupus erythematosus, event-triggered, at the monitoring visit when cutaneous or systemic lupus erythematosus is suspected. Patient: attend the examination and report any new or worsening rash on sun-exposed skin or new joint pain. Clinician: examine the patient for cutaneous or systemic lupus erythematosus and decide on further work-up and specialist referral (the label asks for specialist referral and orders no test, and mentions ANA only as a result that may be positive, so none is ordered).' ;
end action.

enquiry  :: 'Monitor_PPI_Severe_Cutaneous_Reactions' ;
     caption :: 'Monitor for severe cutaneous adverse reactions on pantoprazole' ;
     description :: 'Monitors severe cutaneous adverse reactions as a labeled adverse effect of Prescribe_PPI. The label reports severe cutaneous reactions (EM, SJS/TEN, DRESS, AGEP) and says to stop the drug at the first signs. Order: severe cutaneous adverse reaction symptom review (SJS, TEN, DRESS, AGEP), symptom-triggered, at any time during pantoprazole therapy. Patient: stop pantoprazole and call your clinician right away for blistering or peeling skin, mouth sores, or a rash with fever. Clinician: discontinue pantoprazole at the first signs of a severe cutaneous reaction or other hypersensitivity and consider further evaluation.' ;
     metaprops :: 'ServiceRequest.code=severe cutaneous adverse reaction symptom review (SJS, TEN, DRESS, AGEP)
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=symptom-triggered, at any time during pantoprazole therapy
ServiceRequest.patientInstruction=stop pantoprazole and call your clinician right away for blistering or peeling skin, mouth sores, or a rash with fever
ServiceRequest.performerInstruction=discontinue pantoprazole at the first signs of a severe cutaneous reaction or other hypersensitivity and consider further evaluation
applies_when=all_patients_on_therapy
assistant_invention=the symptom wording; the SNOMED CT concept covers SJS and TEN, not DRESS or AGEP
category=undesired_ade
cq=CQ3, CQ7, CQ9
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= severe cutaneous adverse reaction symptom review (SJS, TEN, DRESS, AGEP); ServiceRequest.occurrenceTiming \\= symptom-triggered, at any time during pantoprazole therapy; ServiceRequest.patientInstruction \\= stop pantoprazole and call your clinician right away for blistering or peeling skin, mouth sores, or a rash with fever; ServiceRequest.performerInstruction \\= discontinue pantoprazole at the first signs of a severe cutaneous reaction or other hypersensitivity and consider further evaluation
goal.verb=order
guideline_status=not_specified_as_a_guideline_monitoring_task
instrument=patient symptom report with clinician examination
knowledge_origin=pantoprazole \\u00A75.5
literature_basis=the label reports severe cutaneous reactions (EM, SJS/TEN, DRESS, AGEP) and says to stop the drug at the first signs
monitored_target=severe cutaneous adverse reactions as a labeled adverse effect of Prescribe_PPI
monitoring_frequency_basis=symptom-triggered, as the label describes
monitoring_stance=symptom_triggered_only
provenance_type=package_insert_specified
quote.1=\\u00A75.5\\: "Discontinue PROTONIX at the first signs or symptoms of severe cutaneous adverse reactions or other signs of hypersensitivity and consider further evaluation."
source.1=PROTONIX (pantoprazole) US Prescribing Information 2026, \\u00A75.5
source_kind=package_insert
trigger=blistering, peeling skin, mucosal sores or rash with fever
' ;
     precondition ::result_of(Antithrombotic_Regimen_Decision) = DAPT or result_of(Antithrombotic_Regimen_Decision) = Short_DAPT_then_P2Y12_Monotherapy or result_of(Antithrombotic_Regimen_Decision) = Extended_DAPT or result_of(Antithrombotic_Regimen_Decision) = DOAC_plus_Antiplatelet;
     source :: 'blistering_or_peeling_skin' ;
          data_definition :: 'blistering_or_peeling_skin' ;
          mandatory :: no ;
     source :: 'mouth_sores' ;
          data_definition :: 'mouth_sores' ;
          mandatory :: no ;
     source :: 'rash_with_fever' ;
          data_definition :: 'rash_with_fever' ;
          mandatory :: no ;
     source :: 'suspected_ppi_severe_cutaneous_reactions' ;
          data_definition :: 'suspected_ppi_severe_cutaneous_reactions' ;
          mandatory :: no ;
end enquiry.

action  :: 'Alert_Further_Examination_PPI_Severe_Cutaneous_Reactions' ;
     caption :: 'Alert: further examination of severe cutaneous adverse reaction' ;
     description :: 'Monitors suspected severe cutaneous adverse reaction recorded by Monitor_PPI_Severe_Cutaneous_Reactions (severe cutaneous adverse reactions as a labeled adverse effect of Prescribe_PPI). The pantoprazole label asks to discontinue it at the first signs or symptoms of a severe cutaneous adverse reaction and to consider further evaluation, and names no laboratory or imaging test. The sources name no test, so, following Mor Peleg\'s know-how of 4 Nov 2026, this step alerts the clinician to examine the patient further and decide on work-up instead of ordering a test.' ;
     metaprops :: 'ServiceRequest.code=further clinical examination for suspected severe cutaneous adverse reaction
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=event-triggered, at the monitoring visit when a severe cutaneous adverse reaction is suspected
ServiceRequest.patientInstruction=stop pantoprazole and attend the examination at once if you have blistering or peeling skin, mouth sores, or a rash with fever
ServiceRequest.performerInstruction=examine the patient for a severe cutaneous adverse reaction and decide on further evaluation, discontinuing pantoprazole at the first signs (the sources name no specific test, so none is ordered)
applies_when=all_patients_on_therapy
assistant_invention=the alert step, its suspected_ppi_severe_cutaneous_reactions gate and the further-examination order, proposed from Mor Peleg\'s know-how of 4 Nov 2026 because the sources of Monitor_PPI_Severe_Cutaneous_Reactions name no laboratory or imaging test for severe cutaneous adverse reaction
category=undesired_ade
cq=CQ3, CQ5, CQ11
