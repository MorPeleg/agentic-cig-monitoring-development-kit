end plan.

enquiry  :: 'Get_Antithrombotic_Data' ;
     caption :: 'Collect the patient data for antithrombotic regimen selection' ;
     description :: 'Collects the patient data that the regimen and P2Y12-agent decisions, the therapy-plan gate and the population-scoped monitors read (§4.3.1 Recs 1-16, Figure 9 and the label contraindications). Also collected for the clinician at baseline (no condition reads them): hemoglobin, platelet count, serum creatinine and Cockcroft-Gault creatinine clearance, body weight, serum magnesium, the CYP2C19 genotype if known, and the current medication list. Body weight and creatinine clearance set the doses written in the procedures.' ;
     source :: 'acs_within_12_months' ;
          data_definition :: 'acs_within_12_months' ;
     source :: 'active_pathological_bleeding' ;
          data_definition :: 'active_pathological_bleeding' ;
     source :: 'age_years' ;
          data_definition :: 'age_years' ;
     source :: 'aspirin_intolerance' ;
          data_definition :: 'aspirin_intolerance' ;
     source :: 'cabg_within_12_months' ;
          data_definition :: 'cabg_within_12_months' ;
     source :: 'des_implanted' ;
          data_definition :: 'des_implanted' ;
     source :: 'high_bleeding_risk' ;
          data_definition :: 'high_bleeding_risk' ;
     source :: 'high_thrombotic_risk' ;
          data_definition :: 'high_thrombotic_risk' ;
     source :: 'on_digoxin_or_diuretic' ;
          data_definition :: 'on_digoxin_or_diuretic' ;
     source :: 'pci_within_12_months' ;
          data_definition :: 'pci_within_12_months' ;
     source :: 'previous_mi' ;
          data_definition :: 'previous_mi' ;
     source :: 'prior_ich' ;
          data_definition :: 'prior_ich' ;
     source :: 'prior_stroke_or_tia' ;
          data_definition :: 'prior_stroke_or_tia' ;
     source :: 'requires_oral_anticoagulation' ;
          data_definition :: 'requires_oral_anticoagulation' ;
end enquiry.

decision  :: 'Antithrombotic_Regimen_Decision' ;
     caption :: 'Choose the antithrombotic regimen' ;
     description :: 'Chooses the antithrombotic regimen for a patient with CCD along the Figure 9 pathways and §4.3.1 Recs 1-16. Single choice with the default recommendation netsupport() > 0: several candidates can be recommended at once (for example the 2a/2b add-on options after MI) and the clinician commits one. Section 4.3.1 defers bare-metal stents to the 2016 AHA/ACC DAPT guideline, so no candidate is recommended for PCI with high bleeding risk and a bare-metal stent.' ;
     candidate :: 'Aspirin_Monotherapy' ;
          caption :: 'Aspirin 81 mg monotherapy' ;
          description :: 'Rec 1 and Figure 9: no indication for oral anticoagulation and no PCI, ACS or CABG in the past 12 months, with aspirin tolerated.' ;
          argument :: for,requires_oral_anticoagulation = false and pci_within_12_months = false and acs_within_12_months = false and cabg_within_12_months = false and aspirin_intolerance = false attributes
               argument_name :: 'Arg_Aspirin_SAPT' ;
               caption :: 'Rec 1 [1, A]; Figure 9: no oral anticoagulant indication, no PCI, ACS or CABG in the past 12 months, aspirin tolerated' ;
               metaprops :: 'quote.1=p.e50, Rec 1\\: "low-dose aspirin 81 mg (75-100 mg) is recommended to reduce atherosclerotic events"
quote.2=p.e51, Figure 9 (figure labels)\\: "No PCI or >12 mo from ACS ... Aspirin"
source.1=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 1 (p.e50)
source.2=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Figure 9 (p.e51)
' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'Clopidogrel_Monotherapy' ;
          caption :: 'Clopidogrel 75 mg monotherapy' ;
          description :: 'Supportive text 1: clopidogrel as the alternative single antiplatelet when aspirin is not tolerated.' ;
          argument :: for,requires_oral_anticoagulation = false and pci_within_12_months = false and acs_within_12_months = false and aspirin_intolerance = true attributes
               argument_name :: 'Arg_Clopidogrel_SAPT' ;
               caption :: 'Supportive text 1 [no COR/LOE]: aspirin not tolerated, no oral anticoagulant indication, no PCI or ACS in the past 12 months' ;
               metaprops :: 'quote=p.e51, text 1\\: "As an alternative to low-dose aspirin, clopidogrel may be used in individuals who cannot tolerate aspirin therapy"
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 supportive text 1 (p.e51)
' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'DAPT' ;
          caption :: 'DAPT (aspirin plus a P2Y12 inhibitor)' ;
          description :: 'Rec 2 (6 months after PCI, then single antiplatelet therapy), Figure 9 (to 12 months after ACS) and Rec 6 (after CABG). Rec 7 argues against it without recent ACS, PCI or CABG.' ;
          argument :: for,requires_oral_anticoagulation = false and pci_within_12_months = true and high_bleeding_risk = false attributes
               argument_name :: 'Arg_DAPT_PCI' ;
               caption :: 'Rec 2 [1, A]: PCI in the past 12 months without high bleeding risk' ;
               metaprops :: 'quote=p.e50, Rec 2\\: "dual antiplatelet therapy (DAPT) consisting of aspirin and clopidogrel for 6 months post PCI followed by single antiplatelet therapy (SAPT) is indicated"
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 2 (p.e50)
' ;
          end attributes
          ;
          argument :: for,requires_oral_anticoagulation = false and acs_within_12_months = true attributes
               argument_name :: 'Arg_DAPT_ACS' ;
               caption :: 'Figure 9 [figure pathway, no COR/LOE for the first 12 months]: ACS in the past 12 months' ;
               metaprops :: 'quote=p.e51, Figure 9 (figure labels)\\: "Prior ACS with or without PCI ... DAPT ... DAPT for 12\\u201336 mo"
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Figure 9 (p.e51)
' ;
          end attributes
          ;
          argument :: for,requires_oral_anticoagulation = false and cabg_within_12_months = true attributes
               argument_name :: 'Arg_DAPT_CABG' ;
               caption :: 'Rec 6 [2b, B-R]: CABG in the past 12 months' ;
               metaprops :: 'quote=p.e50, Rec 6\\: "the use of DAPT after CABG may be useful to reduce the incidence of saphenous vein graft occlusion"
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 6 (p.e50)
' ;
          end attributes
          ;
          argument :: against,pci_within_12_months = false and acs_within_12_months = false and cabg_within_12_months = false attributes
               argument_name :: 'Arg_DAPT_No_Benefit' ;
               caption :: 'Rec 7 [3: No benefit, A]: no PCI, ACS or CABG in the past 12 months' ;
               metaprops :: 'quote=p.e50, Rec 7\\: "the addition of clopidogrel to aspirin therapy is not useful to reduce MACE"
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 7 (p.e50)
' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'Short_DAPT_then_P2Y12_Monotherapy' ;
          caption :: 'DAPT for 1 to 3 months, then P2Y12 inhibitor monotherapy' ;
          description :: 'Rec 3 and Figure 9: after PCI with a drug-eluting stent at high bleeding risk, 1 to 3 months of DAPT, then P2Y12 inhibitor monotherapy for at least 12 months.' ;
          argument :: for,requires_oral_anticoagulation = false and pci_within_12_months = true and des_implanted = true and high_bleeding_risk = true attributes
               argument_name :: 'Arg_Short_DAPT' ;
               caption :: 'Rec 3 [2a, A]: PCI with a drug-eluting stent at high bleeding risk' ;
               metaprops :: 'quote=p.e50, Rec 3\\: "P2Y12 inhibitor monotherapy for at least 12 months is reasonable to reduce bleeding risk"
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 3 (p.e50)
' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'Extended_DAPT' ;
          caption :: 'Extended DAPT beyond 12 months (up to 3 years)' ;
          description :: 'Rec 4: after a previous MI at low bleeding risk, DAPT beyond 12 months for up to 3 years.' ;
          argument :: for,requires_oral_anticoagulation = false and previous_mi = true and high_bleeding_risk = false attributes
               argument_name :: 'Arg_Extended_DAPT' ;
               caption :: 'Rec 4 [2b, A]: previous MI, not at high bleeding risk' ;
               metaprops :: 'quote=p.e50, Rec 4\\: "extended DAPT beyond 12 months for a period of up to 3 years may be reasonable to reduce MACE"
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 4 (p.e50)
' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'Aspirin_plus_Vorapaxar' ;
          caption :: 'Aspirin plus vorapaxar' ;
          description :: 'Rec 5: vorapaxar added to aspirin after a previous MI without stroke, TIA or ICH; Rec 8 excludes it after stroke, TIA or ICH.' ;
          argument :: for,requires_oral_anticoagulation = false and previous_mi = true and prior_stroke_or_tia = false and prior_ich = false attributes
               argument_name :: 'Arg_Vorapaxar' ;
               caption :: 'Rec 5 [2b, B-R]: previous MI without stroke, TIA or ICH' ;
               metaprops :: 'quote=p.e50, Rec 5\\: "vorapaxar may be added to aspirin therapy to reduce MACE"
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 5 (p.e50)
' ;
          end attributes
          ;
          argument :: excluding,prior_stroke_or_tia = true or prior_ich = true attributes
               argument_name :: 'Arg_Vorapaxar_Harm' ;
               caption :: 'Rec 8 [3: Harm, A]; ZONTIVITY §4.1: previous stroke, TIA or ICH' ;
               metaprops :: 'quote.1=p.e50, Rec 8\\: "vorapaxar should not be added to DAPT because of increased risk of major bleeding and ICH"
quote.2=\\u00A74.1\\: "Discontinue ZONTIVITY in patients who experience a stroke, TIA, or ICH"
source.1=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 8 (p.e50)
source.2=ZONTIVITY (vorapaxar) US Prescribing Information 2022, \\u00A74.1
' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'Aspirin_plus_Low_Dose_Rivaroxaban' ;
          caption :: 'Aspirin 81 mg plus rivaroxaban 2.5 mg twice daily' ;
          description :: 'Rec 15: high thrombotic risk with low or moderate bleeding risk, no oral anticoagulant indication and no recent PCI or ACS.' ;
          argument :: for,requires_oral_anticoagulation = false and pci_within_12_months = false and acs_within_12_months = false and high_thrombotic_risk = true and high_bleeding_risk = false attributes
               argument_name :: 'Arg_Low_Dose_Rivaroxaban' ;
               caption :: 'Rec 15 [2a, B-R]: high thrombotic risk, not at high bleeding risk, no PCI or ACS in the past 12 months' ;
               metaprops :: 'quote=p.e50, Rec 15\\: "the addition of low-dose rivaroxaban 2.5 mg twice daily to aspirin 81 mg daily is reasonable for long-term reduction of risk for MACE"
source=2023 AHA/ACC CCD Guideline (Virani et al., DOI 10.1161/CIR.0000000000001168), \\u00A74.3.1 Rec 15 (p.e50)
' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'DOAC_plus_Antiplatelet' ;
          caption :: 'DOAC plus antiplatelet therapy after PCI or ACS' ;
          description :: 'Recs 11 and 12 and Figure 9: an oral anticoagulant indication with PCI or ACS in the past 12 months; DOAC with aspirin and clopidogrel for 1 to 4 weeks (up to 1 month), then DOAC plus clopidogrel to 6 months, then DOAC alone (Rec 13). Recent ACS is an acute indication for antiplatelet therapy (Rec 14).' ;
          argument :: for,requires_oral_anticoagulation = true and (pci_within_12_months = true or acs_within_12_months = true) attributes
