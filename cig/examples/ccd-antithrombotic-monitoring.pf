source.8=PLAVIX (clopidogrel) US Prescribing Information 2025, \\u00A75.2 General Risk of Bleeding
source_kind=clinical_guideline_plus_package_insert
trigger=bleeding symptoms, unexplained hypotension or a fall in hemoglobin
' ;
