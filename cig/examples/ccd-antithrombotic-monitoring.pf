enquiry  :: 'Monitor_PPI_CDAD' ;
     caption :: 'Monitor for C. difficile-associated diarrhea on pantoprazole' ;
     description :: 'Monitors C. difficile-associated diarrhea as a labeled adverse effect of Prescribe_PPI. The label says PPI therapy may raise the risk of C. difficile-associated diarrhea and that the diagnosis should be considered for diarrhea that does not improve. Order: Clostridioides difficile-associated diarrhea symptom review with triggered stool C. difficile testing, symptom-triggered, with a bowel-habit question at each follow-up visit. Patient: call your clinician right away for diarrhea that does not improve, especially with fever or abdominal pain. Clinician: if diarrhea does not improve, test the stool for C. difficile, treat a confirmed infection and review whether the PPI is still needed.' ;
     metaprops :: 'ServiceRequest.code=Clostridioides difficile-associated diarrhea symptom review with triggered stool C. difficile testing
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=symptom-triggered, with a bowel-habit question at each follow-up visit
ServiceRequest.patientInstruction=call your clinician right away for diarrhea that does not improve, especially with fever or abdominal pain
ServiceRequest.performerInstruction=if diarrhea does not improve, test the stool for C. difficile, treat a confirmed infection and review whether the PPI is still needed
applies_when=all_patients_on_therapy
assistant_invention=stool testing as the triggered test
category=undesired_ade
cq=CQ3, CQ7, CQ9
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= Clostridioides difficile-associated diarrhea symptom review with triggered stool C. difficile testing; ServiceRequest.occurrenceTiming \\= symptom-triggered, with a bowel-habit question at each follow-up visit; ServiceRequest.patientInstruction \\= call your clinician right away for diarrhea that does not improve, especially with fever or abdominal pain; ServiceRequest.performerInstruction \\= if diarrhea does not improve, test the stool for C. difficile, treat a confirmed infection and review whether the PPI is still needed
goal.verb=order
guideline_status=not_specified_as_a_guideline_monitoring_task
instrument=patient symptom report with triggered stool C. difficile test
knowledge_origin=pantoprazole \\u00A75.3
literature_basis=the label says PPI therapy may raise the risk of C. difficile-associated diarrhea and that the diagnosis should be considered for diarrhea that does not improve
monitored_target=C. difficile-associated diarrhea as a labeled adverse effect of Prescribe_PPI
monitoring_frequency_basis=symptom-triggered, as the label describes
monitoring_stance=symptom_triggered_only
ontology.coding=SNOMED\\:186431008
ontology.label=Infection caused by Clostridioides difficile (disorder)
provenance_type=package_insert_specified
quote.1=\\u00A75.3\\: "This diagnosis should be considered for diarrhea that does not improve"
quote.2=\\u00A717\\: "Advise patients to immediately call their healthcare provider if they experience diarrhea that does not improve"
source.1=PROTONIX (pantoprazole) US Prescribing Information 2026, \\u00A75.3
source.2=PROTONIX (pantoprazole) US Prescribing Information 2026, \\u00A717
source_kind=package_insert
trigger=diarrhea that does not improve
' ;
     precondition ::result_of(Antithrombotic_Regimen_Decision) = DAPT or result_of(Antithrombotic_Regimen_Decision) = Short_DAPT_then_P2Y12_Monotherapy or result_of(Antithrombotic_Regimen_Decision) = Extended_DAPT or result_of(Antithrombotic_Regimen_Decision) = DOAC_plus_Antiplatelet;
     source :: 'abdominal_pain' ;
          data_definition :: 'abdominal_pain' ;
     source :: 'fever' ;
          data_definition :: 'fever' ;
     source :: 'persistent_diarrhea' ;
          data_definition :: 'persistent_diarrhea' ;
end enquiry.

action  :: 'Order_Stool_C_Difficile_Test' ;
     caption :: 'Order stool C. difficile toxin test' ;
     description :: 'Orders a stool C. difficile toxin test for Monitor_PPI_CDAD, because the pantoprazole label says C. difficile-associated diarrhea should be considered for diarrhea that does not improve.' ;
     metaprops :: 'goal.noun_phrase=stool C. difficile toxin test
goal.verb=order
ontology.coding=LOINC\\:34713-8
ontology.label=Clostridioides difficile toxin A+B [Presence] in Stool
ordered_for=Monitor_PPI_CDAD
role=test_order
' ;
     precondition ::persistent_diarrhea = true;
     procedure :: 'Order stool C. difficile toxin test when diarrhea does not improve.' ;
end action.

enquiry  :: 'Monitor_PPI_Hypomagnesemia' ;
     caption :: 'Monitor serum magnesium on pantoprazole' ;
     description :: 'Monitors hypomagnesemia as a labeled adverse effect of Prescribe_PPI. The label\'s own instruction is to consider magnesium before starting and periodically in patients on prolonged treatment or on digoxin or diuretics. Order: serum magnesium, baseline before starting pantoprazole, then every 12 months while it continues, and on symptoms. Patient: report muscle cramps, tremor, spasms, palpitations, an irregular heartbeat or seizures. Clinician: if magnesium is low, check calcium and potassium, replace magnesium and reconsider the PPI.' ;
     metaprops :: 'ServiceRequest.code=serum magnesium
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=baseline before starting pantoprazole, then every 12 months while it continues, and on symptoms
ServiceRequest.patientInstruction=report muscle cramps, tremor, spasms, palpitations, an irregular heartbeat or seizures
ServiceRequest.performerInstruction=if magnesium is low, check calcium and potassium, replace magnesium and reconsider the PPI
applies_when=patients on pantoprazole expected to take it for 6 months or longer (DAPT, extended DAPT or DOAC plus antiplatelet) or taking it with digoxin or a diuretic
assistant_invention=every 12 months as the periodic interval, and treating 6 months or more as prolonged
category=undesired_ade
cq=CQ3, CQ7, CQ9
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= serum magnesium; ServiceRequest.occurrenceTiming \\= baseline before starting pantoprazole, then every 12 months while it continues, and on symptoms; ServiceRequest.patientInstruction \\= report muscle cramps, tremor, spasms, palpitations, an irregular heartbeat or seizures; ServiceRequest.performerInstruction \\= if magnesium is low, check calcium and potassium, replace magnesium and reconsider the PPI
goal.verb=order
guideline_status=not_specified_as_a_guideline_monitoring_task
instrument=serum magnesium (with calcium and potassium if low)
knowledge_origin=pantoprazole \\u00A75.8
literature_basis=the label\'s own instruction is to consider magnesium before starting and periodically in patients on prolonged treatment or on digoxin or diuretics
monitored_target=hypomagnesemia as a labeled adverse effect of Prescribe_PPI
monitoring_frequency_basis=label-specified baseline and periodic testing, with a proposed 12-month interval
monitoring_stance=recommended
ontology.coding=SNOMED\\:190855004
ontology.label=Hypomagnesemia (disorder)
provenance_type=package_insert_specified
quote.1=\\u00A75.8\\: "For patients expected to be on prolonged treatment or who take PPIs with medications such as digoxin or drugs that may cause hypomagnesemia (e.g., diuretics)"
quote.2=\\u00A75.8\\: "health care professionals may consider monitoring magnesium levels prior to initiation of PPI treatment and periodically"
source.1=PROTONIX (pantoprazole) US Prescribing Information 2026, \\u00A75.8
source.2=PROTONIX (pantoprazole) US Prescribing Information 2026, \\u00A75.8
source_kind=package_insert
trigger=cramps, tremor, arrhythmia or seizures
' ;
     precondition ::(result_of(Antithrombotic_Regimen_Decision) = DAPT or result_of(Antithrombotic_Regimen_Decision) = Extended_DAPT or result_of(Antithrombotic_Regimen_Decision) = DOAC_plus_Antiplatelet) or (result_of(Antithrombotic_Regimen_Decision) = Short_DAPT_then_P2Y12_Monotherapy and on_digoxin_or_diuretic = true);
     source :: 'magnesium_check_due' ;
          data_definition :: 'magnesium_check_due' ;
     source :: 'muscle_cramps_or_spasms' ;
          data_definition :: 'muscle_cramps_or_spasms' ;
     source :: 'palpitations' ;
          data_definition :: 'palpitations' ;
     source :: 'seizure' ;
          data_definition :: 'seizure' ;
     source :: 'tremor' ;
          data_definition :: 'tremor' ;
end enquiry.

decision  :: 'Tests_Ordering_Recommendations_PPI_Hypomagnesemia' ;
     caption :: 'Which tests to order for suspected hypomagnesemia?' ;
     description :: 'When the scheduled magnesium check is due or a symptom of hypomagnesemia is found by Monitor_PPI_Hypomagnesemia, which electrolytes to order. The label asks to consider magnesium before starting the PPI and periodically, and the monitor checks calcium and potassium when magnesium is low.' ;
     metaprops :: 'ordered_for=Monitor_PPI_Hypomagnesemia
quote.1=\\u00A75.8\\: "health care professionals may consider monitoring magnesium levels prior to initiation of PPI treatment and periodically"
role=test_ordering
source.1=PROTONIX (pantoprazole) US Prescribing Information 2026, \\u00A75.8
' ;
     precondition ::magnesium_check_due = true or muscle_cramps_or_spasms = true or tremor = true or palpitations = true or seizure = true;
     choice_mode :: multiple ;
     candidate :: 'Serum_Magnesium' ;
          caption :: 'Serum magnesium' ;
          metaprops :: 'ontology.coding=LOINC\\:19123-9
ontology.label=Magnesium [Mass/volume] in Serum or Plasma
' ;
          argument :: for,true() attributes
               argument_name :: 'Arg_Order_Serum_Magnesium' ;
               caption :: 'Serum magnesium when the scheduled check is due or cramps, tremor, palpitations or seizures suggest hypomagnesemia' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'Serum_Calcium' ;
          caption :: 'Serum calcium' ;
          metaprops :: 'ontology.coding=LOINC\\:17861-6
ontology.label=Calcium [Mass/volume] in Serum or Plasma
' ;
          argument :: for,true() attributes
               argument_name :: 'Arg_Order_Serum_Calcium' ;
               caption :: 'Serum calcium for the hypocalcemia that can accompany hypomagnesemia' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'Serum_Potassium' ;
          caption :: 'Serum potassium' ;
          metaprops :: 'ontology.coding=LOINC\\:2823-3
ontology.label=Potassium [Moles/volume] in Serum or Plasma
' ;
          argument :: for,true() attributes
               argument_name :: 'Arg_Order_Serum_Potassium' ;
               caption :: 'Serum potassium for the hypokalemia that can accompany hypomagnesemia' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
end decision.

enquiry  :: 'Monitor_PPI_Bone_Fracture' ;
     caption :: 'Review fracture and osteoporosis risk during long-term pantoprazole' ;
     description :: 'Monitors osteoporosis-related fracture as a labeled adverse effect of long-term Prescribe_PPI. The label links long-term (a year or longer) and high-dose PPI use to hip, wrist and spine fractures and advises managing at-risk patients per osteoporosis guidelines. Order: fracture history and osteoporosis risk review during long-term pantoprazole, every 12 months while pantoprazole continues for 1 year or longer, and on any fracture. Patient: report any fracture, especially of the hip, wrist or spine. Clinician: when pantoprazole continues for a year or longer, assess osteoporosis and fracture risk per current osteoporosis guidelines and use the lowest PPI dose for the shortest duration.' ;
     metaprops :: 'ServiceRequest.code=fracture history and osteoporosis risk review during long-term pantoprazole
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=every 12 months while pantoprazole continues for 1 year or longer, and on any fracture
ServiceRequest.patientInstruction=report any fracture, especially of the hip, wrist or spine
ServiceRequest.performerInstruction=when pantoprazole continues for a year or longer, assess osteoporosis and fracture risk per current osteoporosis guidelines and use the lowest PPI dose for the shortest duration
applies_when=patients on pantoprazole for a year or longer (during extended DAPT after MI)
assistant_invention=the yearly review and limiting it to extended DAPT, the only regimen in this CIG where the PPI runs beyond a year
category=undesired_ade
cq=CQ3, CQ7, CQ9
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= fracture history and osteoporosis risk review during long-term pantoprazole; ServiceRequest.occurrenceTiming \\= every 12 months while pantoprazole continues for 1 year or longer, and on any fracture; ServiceRequest.patientInstruction \\= report any fracture, especially of the hip, wrist or spine; ServiceRequest.performerInstruction \\= when pantoprazole continues for a year or longer, assess osteoporosis and fracture risk per current osteoporosis guidelines and use the lowest PPI dose for the shortest duration
goal.verb=order
guideline_status=not_specified_as_a_guideline_monitoring_task
instrument=clinician review of fracture history and osteoporosis risk factors
knowledge_origin=pantoprazole \\u00A75.4
literature_basis=the label links long-term (a year or longer) and high-dose PPI use to hip, wrist and spine fractures and advises managing at-risk patients per osteoporosis guidelines
monitored_target=osteoporosis-related fracture as a labeled adverse effect of long-term Prescribe_PPI
monitoring_frequency_basis=proposed yearly review, matching the one-year threshold in the label
monitoring_stance=proposed_by_assistant
ontology.coding=SNOMED\\:443165006
ontology.label=Osteoporotic fracture of bone (disorder)
provenance_type=package_insert_specified
quote.1=\\u00A75.4\\: "The risk of fracture was increased in patients who received high-dose, defined as multiple daily doses, and long-term PPI therapy (a year or longer)."
quote.2=\\u00A717\\: "Advise patients to report any fractures, especially of the hip, wrist or spine, to their healthcare provider"
source.1=PROTONIX (pantoprazole) US Prescribing Information 2026, \\u00A75.4
source.2=PROTONIX (pantoprazole) US Prescribing Information 2026, \\u00A717
source_kind=package_insert
trigger=any new fracture
' ;
     precondition ::result_of(Antithrombotic_Regimen_Decision) = Extended_DAPT and previous_mi = true;
     source :: 'new_fracture' ;
          data_definition :: 'new_fracture' ;
end enquiry.

enquiry  :: 'Monitor_PPI_Interstitial_Nephritis' ;
     caption :: 'Monitor for acute tubulointerstitial nephritis on pantoprazole' ;
     description :: 'Monitors acute tubulointerstitial nephritis as a labeled adverse effect of Prescribe_PPI. The label says acute TIN can occur at any point during PPI therapy and that the PPI should be stopped and the patient evaluated if it is suspected. Order: acute tubulointerstitial nephritis symptom review with triggered serum creatinine and urinalysis, symptom-triggered, at any time during pantoprazole therapy. Patient: call your clinician right away for fever, rash, joint pain, passing less urine or blood in the urine. Clinician: if acute tubulointerstitial nephritis is suspected, check serum creatinine and urinalysis, stop pantoprazole and evaluate.' ;
