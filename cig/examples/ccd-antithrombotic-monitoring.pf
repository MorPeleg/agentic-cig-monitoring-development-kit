enquiry  :: 'Monitor_Ticagrelor_Bradyarrhythmia' ;
     caption :: 'Check the pulse for bradyarrhythmia on ticagrelor (ECG on symptoms)' ;
     description :: 'Monitors bradyarrhythmia (ventricular pauses, AV block) as a labeled adverse effect of Prescribe_Ticagrelor. The label warns that ticagrelor can cause ventricular pauses and that patients with conduction disease without a pacemaker were not studied, but states no monitoring instruction. Order: pulse check with ECG on symptoms of bradyarrhythmia on ticagrelor, each follow-up visit, with an ECG on dizziness, syncope or a slow pulse. Patient: report fainting, dizziness, light-headedness or a very slow pulse. Clinician: if bradycardia or syncope is found, obtain an ECG for ventricular pauses or AV block and reconsider ticagrelor in patients with sick sinus syndrome, second or third degree AV block or bradycardia-related syncope without a pacemaker.' ;
     metaprops :: 'ServiceRequest.code=pulse check with ECG on symptoms of bradyarrhythmia on ticagrelor
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=each follow-up visit, with an ECG on dizziness, syncope or a slow pulse
ServiceRequest.patientInstruction=report fainting, dizziness, light-headedness or a very slow pulse
ServiceRequest.performerInstruction=if bradycardia or syncope is found, obtain an ECG for ventricular pauses or AV block and reconsider ticagrelor in patients with sick sinus syndrome, second or third degree AV block or bradycardia-related syncope without a pacemaker
applies_when=all_patients_on_therapy
assistant_invention=the pulse check at each visit and the triggered ECG
category=undesired_ade
cq=CQ3, CQ9
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= pulse check with ECG on symptoms of bradyarrhythmia on ticagrelor; ServiceRequest.occurrenceTiming \\= each follow-up visit, with an ECG on dizziness, syncope or a slow pulse; ServiceRequest.patientInstruction \\= report fainting, dizziness, light-headedness or a very slow pulse; ServiceRequest.performerInstruction \\= if bradycardia or syncope is found, obtain an ECG for ventricular pauses or AV block and reconsider ticagrelor in patients with sick sinus syndrome, second or third degree AV block or bradycardia-related syncope without a pacemaker
goal.verb=order
guideline_status=not_specified_as_a_guideline_monitoring_task
instrument=pulse rate at the visit with ECG on symptoms
knowledge_origin=ticagrelor \\u00A75.4
literature_basis=the label warns that ticagrelor can cause ventricular pauses and that patients with conduction disease without a pacemaker were not studied, but states no monitoring instruction
monitored_target=bradyarrhythmia (ventricular pauses, AV block) as a labeled adverse effect of Prescribe_Ticagrelor
monitoring_frequency_basis=proposed, a pulse check at each routine visit is cheap and catches symptomatic bradycardia
monitoring_stance=proposed_by_assistant
provenance_type=package_insert_specified
quote.1=\\u00A75.4\\: "BRILINTA can cause ventricular pauses"
quote.2=\\u00A75.4\\: "Patients with a history of sick sinus syndrome, 2 nd or 3 rd degree AV block or bradycardia-related syncope not protected by a pacemaker were excluded from clinical studies"
source.1=BRILINTA (ticagrelor) US Prescribing Information 2026, \\u00A75.4
source.2=BRILINTA (ticagrelor) US Prescribing Information 2026, \\u00A75.4
source_kind=package_insert
trigger=syncope, dizziness or a slow pulse
' ;
     precondition ::result_of(P2Y12_Agent_Decision) = Ticagrelor;
     source :: 'dizziness' ;
          data_definition :: 'dizziness' ;
          mandatory :: no ;
     source :: 'pulse_rate' ;
          data_definition :: 'pulse_rate' ;
          mandatory :: no ;
     source :: 'syncope' ;
          data_definition :: 'syncope' ;
          mandatory :: no ;
end enquiry.

action  :: 'Order_ECG' ;
     caption :: 'Order 12-lead ECG' ;
     description :: 'Orders a 12-lead ECG for Monitor_Ticagrelor_Bradyarrhythmia, to look for ventricular pauses or AV block when syncope, dizziness or a slow pulse is found on ticagrelor.' ;
     metaprops :: 'goal.noun_phrase=12-lead ECG
goal.verb=order
ordered_for=Monitor_Ticagrelor_Bradyarrhythmia
role=test_order
' ;
     precondition ::syncope = "yes" or dizziness = "yes" or pulse_rate < 50;
     procedure :: 'Order 12-lead ECG when the patient reports fainting or dizziness or the pulse rate is below 50/min.' ;
end action.

enquiry  :: 'Monitor_Ticagrelor_Central_Sleep_Apnea' ;
