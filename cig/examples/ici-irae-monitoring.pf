/** PROforma version 1.9 (plain text) **/

/** IMPORTANT: Keep all your comments below the engine_version line **/
engine_version :: '1.9' ;

metadata  :: 'ici_irae_monitoring' ;
     title :: 'ICI immune-related adverse event monitoring (ESMO 2017)' ;
     desc :: 'PROforma CIG for monitoring immune checkpoint inhibitor therapy in adults with cancer: baseline risk assessment, a pre-treatment decision, the ICI therapy plan, and surveillance for immune-related adverse events and for completion of the pre-infusion blood tests, from the ESMO 2017 toxicity guideline.' ;
     version :: '1.0' ;
     author :: 'agentic-cig-monitoring kit' ;
end metadata.

metaprops :: 'goal.noun_phrase=adult cancer treated with immune checkpoint inhibitors, with monitoring for immune-related adverse events
goal.verb=treat
' ;

plan  :: 'ici_irae_monitoring' ;
     caption :: 'ICI immune-related adverse event monitoring (ESMO 2017)' ;
     metaprops :: 'goal.noun_phrase=adult cancer treated with immune checkpoint inhibitors, with monitoring for immune-related adverse events
goal.verb=treat
' ;
     component :: 'Get_Baseline_Data' ;
          task_definition :: 'Get_Baseline_Data' ;
          ltwh :: 40,40,0,0;
     component :: 'Pretreatment_Decision' ;
          task_definition :: 'Pretreatment_Decision' ;
          schedule_constraint :: completed('Get_Baseline_Data') ;
          ltwh :: 40,140,0,0;
     component :: 'ICI_Therapy' ;
          task_definition :: 'ICI_Therapy' ;
          schedule_constraint :: completed('Pretreatment_Decision') ;
          ltwh :: 40,240,0,0;
     component :: 'Monitoring_Plan' ;
          task_definition :: 'Monitoring_Plan' ;
          schedule_constraint :: completed('ICI_Therapy') ;
          ltwh :: 40,340,0,0;
end plan.

enquiry  :: 'Get_Baseline_Data' ;
     caption :: 'Assess susceptibility to immune-related adverse events and collect baseline data before ICI therapy' ;
     description :: 'Baseline assessment before ICI therapy (ESMO 2017 iv121). Asked as data items: pre-existing autoimmune disease, prior irAE on a previous ICI course, solid-organ allograft, and the planned ICI regimen. Also collected for the clinician (no condition reads them): baseline TSH and FT4 (T3 when indicated) (Fig 5); ALT, AST and bilirubin (iv126); sodium, potassium, creatinine and urea, with baseline creatinine as the reference for nephritis grading (iv133, Fig 14); blood glucose (iv126); patient and family history and general physical condition (iv121); baseline CT chest/abdomen/pelvis with or without brain MRI (iv121). Supplementary Table S1 (detailed baseline list) was not available.' ;
     source :: 'ici_regimen' ;
          data_definition :: 'ici_regimen' ;
     source :: 'organ_allograft' ;
          data_definition :: 'organ_allograft' ;
     source :: 'pre_existing_autoimmune_disease' ;
          data_definition :: 'pre_existing_autoimmune_disease' ;
     source :: 'prior_irAE_on_ICI' ;
          data_definition :: 'prior_irAE_on_ICI' ;
end enquiry.

decision  :: 'Pretreatment_Decision' ;
     caption :: 'Decide whether ICI can start with standard monitoring or needs specialist review first' ;
     description :: 'Assistant-proposed rule: the guideline names the irAE risk groups (pre-existing autoimmune disease, prior irAE on ICI, solid-organ allograft) but gives no executable criterion. Abnormal baseline TFTs are deliberately not an argument: Baseline abnormal values do not preclude treatment (Fig 5).' ;
     candidate :: 'Start_ICI' ;
          caption :: 'Start ICI' ;
          description :: 'start the ICI therapy plan with standard irAE monitoring' ;
          argument :: for,pre_existing_autoimmune_disease = false and prior_irAE_on_ICI = false and organ_allograft = false attributes
               argument_name :: 'Arg_Start_ICI' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'Specialist_Review_Before_ICI' ;
          caption :: 'Specialist review before ICI' ;
          description :: 'a risk factor for irAEs is present; discuss risk and benefit with the relevant specialist before starting' ;
          argument :: for,pre_existing_autoimmune_disease = true or prior_irAE_on_ICI = true or organ_allograft = true attributes
               argument_name :: 'Arg_Specialist_Review_Before_ICI' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
end decision.

action  :: 'Inform_Patient_irAE_Risk' ;
     caption :: 'Inform the patient of potential irAEs and ask them to report symptoms directly to the treating team' ;
     metaprops :: 'goal.noun_phrase=delayed detection and aggravation of immune-related adverse events (patient informed of potential irAEs and told to report symptoms directly to the treating team)
goal.verb=avoid
' ;
end action.

action  :: 'Obtain_Specialist_Review' ;
     caption :: 'Discuss irAE risk and benefit with the relevant specialist before starting ICI' ;
     metaprops :: 'goal.noun_phrase=unassessed risk of autoimmune-disease worsening, recurrent irAEs or allograft rejection on ICI
goal.verb=avoid
' ;
     precondition ::result_of(Pretreatment_Decision) = Specialist_Review_Before_ICI;
end action.

action  :: 'Administer_ICI' ;
     caption :: 'Administer immune checkpoint inhibitor therapy (anti-CTLA4, anti-PD-1/PD-L1 or combination)' ;
     metaprops :: 'goal.noun_phrase=ICI therapy (anti-CTLA4, anti-PD-1/PD-L1 or combination) delivered for an approved indication (ESMO Table 1)
goal.verb=achieve
' ;
end action.

plan  :: 'ICI_Therapy' ;
     caption :: 'Inform the patient, obtain specialist review when indicated, and administer ICI therapy' ;
     precondition ::result_of(Pretreatment_Decision) = Start_ICI or result_of(Pretreatment_Decision) = Specialist_Review_Before_ICI;
     component :: 'Inform_Patient_irAE_Risk' ;
          task_definition :: 'Inform_Patient_irAE_Risk' ;
          ltwh :: 40,40,0,0;
     component :: 'Obtain_Specialist_Review' ;
          task_definition :: 'Obtain_Specialist_Review' ;
          schedule_constraint :: completed('Inform_Patient_irAE_Risk') ;
          ltwh :: 40,140,0,0;
     component :: 'Administer_ICI' ;
          task_definition :: 'Administer_ICI' ;
          schedule_constraint :: completed('Inform_Patient_irAE_Risk') ;
          schedule_constraint :: completed('Obtain_Specialist_Review') ;
          ltwh :: 40,240,0,0;
end plan.

action  :: 'Monitor_PreInfusion_Surveillance' ;
     caption :: 'Monitor completion of the pre-infusion blood panel before each ICI infusion' ;
     metaprops :: 'ServiceRequest.code=completion check of the pre-infusion blood tests due at each infusion\\: ALT, AST and bilirubin, sodium, potassium, creatinine and urea, and blood glucose at every infusion, plus TSH and FT4 when due per the regimen-specific TFT schedule of Monitor_Thyroid
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=before every ICI infusion (each cycle), for the duration of ICI therapy
ServiceRequest.patientInstruction=attend for blood tests before each scheduled infusion
ServiceRequest.performerInstruction=if any test due at this infusion is missing, obtain it and review the results before administering the ICI
applies_when=all_patients_on_therapy
assistant_invention=framing the tests due at each infusion as one completion audit, adding glucose to the same draw, and the obtain-before-administering rule
category=action_completion
cq=CQ6, CQ7
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= completion check of the pre-infusion blood tests due at each infusion\\: ALT, AST and bilirubin, sodium, potassium, creatinine and urea, and blood glucose at every infusion, plus TSH and FT4 when due per the regimen-specific TFT schedule of Monitor_Thyroid; ServiceRequest.occurrenceTiming \\= before every ICI infusion (each cycle), for the duration of ICI therapy; ServiceRequest.patientInstruction \\= attend for blood tests before each scheduled infusion; ServiceRequest.performerInstruction \\= if any test due at this infusion is missing, obtain it and review the results before administering the ICI
goal.verb=order
guideline_status=specified_as_a_guideline_monitoring_task
instrument=order/result audit of the named lab tests
knowledge_origin=ESMO 2017 guideline + assistant operationalization
literature_basis=TFTs "before every infusion or at least once a month (in the case of 2-weekly infusions)", with the regimen schedule in Fig 5; transaminases and bilirubin "before every cycle"; sodium, potassium, creatinine and urea "before every infusion"
monitored_target=completion of the planned pre-infusion surveillance bloods before each infusion of Administer_ICI
monitoring_frequency_basis=the guideline sets transaminases and bilirubin "before every cycle" and sodium, potassium, creatinine and urea "before every infusion". TFTs follow the Fig 5 regimen schedule\\: every cycle for anti-CTLA4-containing regimens; for anti-PD-1/PD-L1, every cycle for 3 months, then every second cycle. Glucose is aligned to the same draw (assistant-proposed)
monitoring_stance=recommended
provenance_type=assistant_completed_from_guidelines
source.1=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Thyroid gland disorders iv124
source.2=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Hepatotoxicity Diagnosis iv126
source.3=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Renal toxicity iv133
source.4=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Figure 5 (ICPi monitoring and management\\: thyroid function) iv125
source_kind=clinical_guideline
trigger=a test due at this infusion is missing at the time of a scheduled infusion
' ;
end action.

plan  :: 'Monitor_Actions' ;
     caption :: 'Monitor completion of the planned pre-infusion surveillance' ;
     component :: 'Monitor_PreInfusion_Surveillance' ;
          task_definition :: 'Monitor_PreInfusion_Surveillance' ;
          ltwh :: 40,40,0,0;
end plan.

action  :: 'Monitor_Thyroid' ;
     caption :: 'Monitor thyroid function (TSH, FT4)' ;
     metaprops :: 'ServiceRequest.code=thyroid function tests (TSH, FT4, T3 when indicated)
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=baseline, then for anti-CTLA4-containing regimens every cycle plus 4-6 weeks after cycle 4. For anti-PD-1/PD-L1, every cycle for the first 3 months, then every second cycle on a 2-weekly schedule (at least monthly)
ServiceRequest.patientInstruction=report fatigue, weight change, palpitations, heat or cold intolerance, or feeling unwell
ServiceRequest.performerInstruction=interpret TSH/FT4 per the ESMO thyroid algorithm. If symptomatic hyperthyroidism and unwell, withhold ICI and start a beta-blocker. If hypothyroid with symptoms, start thyroxine and continue ICI. If TSH falls across two measurements with normal or low FT4, or TSH is low with low FT4, check 9 am cortisol. Note that CT iodine may affect TFTs
applies_when=all_patients_on_therapy
assistant_invention=patient symptom wording (generic thyroid symptoms)
category=undesired_ade
cq=CQ3, CQ5, CQ7
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= thyroid function tests (TSH, FT4, T3 when indicated); ServiceRequest.occurrenceTiming \\= baseline, then for anti-CTLA4-containing regimens every cycle plus 4-6 weeks after cycle 4. For anti-PD-1/PD-L1, every cycle for the first 3 months, then every second cycle on a 2-weekly schedule (at least monthly); ServiceRequest.patientInstruction \\= report fatigue, weight change, palpitations, heat or cold intolerance, or feeling unwell; ServiceRequest.performerInstruction \\= interpret TSH/FT4 per the ESMO thyroid algorithm. If symptomatic hyperthyroidism and unwell, withhold ICI and start a beta-blocker. If hypothyroid with symptoms, start thyroxine and continue ICI. If TSH falls across two measurements with normal or low FT4, or TSH is low with low FT4, check 9 am cortisol. Note that CT iodine may affect TFTs
goal.verb=order
guideline_status=specified_as_a_guideline_monitoring_task
instrument=serum TSH and FT4 (T3 when indicated)
knowledge_origin=ESMO 2017 guideline + assistant operationalization
literature_basis=thyroid dysfunction is mostly detected by routine TSH/FT4, which "should be carried out before every infusion or at least once a month". Fig 5 gives the regimen-specific schedule and the management algorithm
monitored_target=thyroid dysfunction (hypothyroidism or hyperthyroidism) as an immune-related adverse event of immune checkpoint inhibitor therapy, tracing to the ICI therapy action (Administer_ICI)
monitoring_frequency_basis=guideline-stated (iv124 text; Fig 5). "Late endocrine dysfunction can occur"
monitoring_stance=recommended
provenance_type=guideline_specified
source.1=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Thyroid gland disorders iv124
source.2=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Figure 5 (ICPi monitoring and management\\: thyroid function) iv125
source_kind=clinical_guideline
trigger=symptomatic hyperthyroidism with patient unwell; falling or low TSH with low FT4 (possible hypopituitarism)
' ;
end action.

action  :: 'Monitor_Hypophysitis' ;
     caption :: 'Monitor for hypophysitis (pituitary symptoms, triggered 9 am cortisol)' ;
     metaprops :: 'ServiceRequest.code=pituitary symptom screen with triggered 9 am cortisol (and pituitary axis bloods)
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=each visit (symptom review), 9 am cortisol when indicated by symptoms or by a falling TSH, weekly while TSH is falling across two measurements with normal or low FT4
ServiceRequest.patientInstruction=report headache, visual disturbance, marked fatigue, mood change, dizziness or feeling faint, and seek urgent review if unwell
ServiceRequest.performerInstruction=if severe mass-effect symptoms (severe headache, any visual disturbance) or severe hypoadrenalism (hypotension, severe electrolyte disturbance), send pituitary axis bloods (9 am cortisol, ACTH, TSH and FT4, LH, FSH, sex hormones, IGF-1, prolactin), start i.v. methylprednisolone 1 mg/kg, withhold ICI, arrange pituitary MRI and consult endocrinology. If moderate symptoms (headache without visual disturbance, or fatigue or mood change while haemodynamically stable with no electrolyte disturbance), start oral prednisolone 0.5-1 mg/kg once daily after sending the pituitary axis bloods, withhold ICI, arrange pituitary MRI and visual field assessment, and treat as severe if there is no improvement in 48 h
applies_when=all_patients_on_therapy
assistant_invention=each-visit symptom review cadence; patient symptom wording beyond headache and visual disturbance (from Fig 6 tiers)
category=undesired_ade
cq=CQ3, CQ5, CQ7
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= pituitary symptom screen with triggered 9 am cortisol (and pituitary axis bloods); ServiceRequest.occurrenceTiming \\= each visit (symptom review), 9 am cortisol when indicated by symptoms or by a falling TSH, weekly while TSH is falling across two measurements with normal or low FT4; ServiceRequest.patientInstruction \\= report headache, visual disturbance, marked fatigue, mood change, dizziness or feeling faint, and seek urgent review if unwell; ServiceRequest.performerInstruction \\= if severe mass-effect symptoms (severe headache, any visual disturbance) or severe hypoadrenalism (hypotension, severe electrolyte disturbance), send pituitary axis bloods (9 am cortisol, ACTH, TSH and FT4, LH, FSH, sex hormones, IGF-1, prolactin), start i.v. methylprednisolone 1 mg/kg, withhold ICI, arrange pituitary MRI and consult endocrinology. If moderate symptoms (headache without visual disturbance, or fatigue or mood change while haemodynamically stable with no electrolyte disturbance), start oral prednisolone 0.5-1 mg/kg once daily after sending the pituitary axis bloods, withhold ICI, arrange pituitary MRI and visual field assessment, and treat as severe if there is no improvement in 48 h
goal.verb=order
guideline_status=specified_as_a_guideline_monitoring_task
instrument=patient symptom report; 9 am serum cortisol; pituitary axis panel; pituitary MRI when indicated
knowledge_origin=ESMO 2017 guideline + assistant operationalization
literature_basis="Headache and visual disturbances require immediate evaluation". Weekly cortisol when TSH falls with normal or low T4. Fig 6 gives severity tiers and the pituitary bloods. Hypophysitis is mainly seen with anti-CTLA4 and is very rare with anti-PD-1 and anti-PD-L1 (iv126). Fig 6 gives the severe and moderate management tiers.
monitored_target=hypophysitis (pituitary dysfunction, hypoadrenalism) as an immune-related adverse event of immune checkpoint inhibitor therapy, tracing to the ICI therapy action (Administer_ICI)
monitoring_frequency_basis=guideline-stated triggers (Fig 5, Fig 6). The each-visit symptom review is assistant-proposed to give the "immediate evaluation" instruction a place in the schedule
monitoring_stance=recommended
provenance_type=guideline_specified
source.1=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Hypophysitis iv126
source.2=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Figure 5 iv125
source.3=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Figure 6 (management of hypophysitis) iv127
source_kind=clinical_guideline
trigger=headache or visual disturbance (immediate evaluation); severe hypoadrenalism; falling TSH with normal or low FT4
' ;
end action.

action  :: 'Monitor_Hepatitis' ;
     caption :: 'Monitor liver function for immune-related hepatitis (ALT, AST, bilirubin)' ;
     metaprops :: 'ServiceRequest.code=serum transaminases (ALT, AST) and total bilirubin
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=baseline and before every cycle of ICI
ServiceRequest.patientInstruction=report jaundice, dark urine, or right-upper-abdominal pain (hepatitis is usually asymptomatic)
ServiceRequest.performerInstruction=if ALT/AST is >ULN to 3\\u00D7ULN, repeat in 1 week. If 3-5\\u00D7ULN (G2), withhold ICI, recheck LFTs/INR/albumin every 3 days, review medications and alcohol, and do a liver screen. If 5-20\\u00D7ULN (G3), stop ICI and start steroids. If >20\\u00D7ULN (G4), permanently discontinue ICI, start i.v. methylprednisolone 2 mg/kg, and get a hepatology consult
applies_when=all_patients_on_therapy
assistant_invention=patient symptom wording (the guideline says hepatitis is usually asymptomatic)
category=undesired_ade
cq=CQ3, CQ5, CQ7
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= serum transaminases (ALT, AST) and total bilirubin; ServiceRequest.occurrenceTiming \\= baseline and before every cycle of ICI; ServiceRequest.patientInstruction \\= report jaundice, dark urine, or right-upper-abdominal pain (hepatitis is usually asymptomatic); ServiceRequest.performerInstruction \\= if ALT/AST is >ULN to 3\\u00D7ULN, repeat in 1 week. If 3-5\\u00D7ULN (G2), withhold ICI, recheck LFTs/INR/albumin every 3 days, review medications and alcohol, and do a liver screen. If 5-20\\u00D7ULN (G3), stop ICI and start steroids. If >20\\u00D7ULN (G4), permanently discontinue ICI, start i.v. methylprednisolone 2 mg/kg, and get a hepatology consult
goal.verb=order
guideline_status=specified_as_a_guideline_monitoring_task
instrument=serum ALT, AST, total bilirubin (INR and albumin when abnormal)
knowledge_origin=ESMO 2017 guideline + assistant operationalization
literature_basis="All patients undergoing ICPi therapy should be assessed ... with serum transaminases and bilirubin measured before every cycle". Hepatitis is usually asymptomatic and detected on routine blood monitoring
monitored_target=immune-related hepatitis (hepatotoxicity) as an immune-related adverse event of immune checkpoint inhibitor therapy, tracing to the ICI therapy action (Administer_ICI)
monitoring_frequency_basis=guideline-stated "before every cycle"
monitoring_stance=recommended
provenance_type=guideline_specified
source.1=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Hepatotoxicity Diagnosis iv126
source.2=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Figure 7 (management of hepatitis) iv128
source_kind=clinical_guideline
trigger=ALT/AST >3\\u00D7ULN or rising bilirubin
' ;
end action.

action  :: 'Monitor_Diabetes' ;
     caption :: 'Monitor blood glucose for immune-related type 1 diabetes' ;
     metaprops :: 'ServiceRequest.code=blood glucose (with triggered ketone/acid-base assessment)
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=baseline and before every ICI infusion with the pre-infusion bloods (assistant-proposed), plus on symptoms
ServiceRequest.patientInstruction=report excessive thirst, frequent urination, weight loss, nausea or vomiting, abdominal pain, or drowsiness
ServiceRequest.performerInstruction=if new hyperglycaemia, measure C-peptide and GAD and islet-cell antibodies to distinguish type 1 from type 2 DM. If ketoacidosis (G3-4), admit immediately and treat per local guidelines, corticosteroids are not recommended
applies_when=all_patients_on_therapy
assistant_invention=cadence (before every infusion); patient DKA symptom wording
category=undesired_ade
cq=CQ3, CQ5, CQ7
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= blood glucose (with triggered ketone/acid-base assessment); ServiceRequest.occurrenceTiming \\= baseline and before every ICI infusion with the pre-infusion bloods (assistant-proposed), plus on symptoms; ServiceRequest.patientInstruction \\= report excessive thirst, frequent urination, weight loss, nausea or vomiting, abdominal pain, or drowsiness; ServiceRequest.performerInstruction \\= if new hyperglycaemia, measure C-peptide and GAD and islet-cell antibodies to distinguish type 1 from type 2 DM. If ketoacidosis (G3-4), admit immediately and treat per local guidelines, corticosteroids are not recommended
goal.verb=order
guideline_status=specified_as_a_guideline_monitoring_task
instrument=blood glucose; triggered C-peptide, GAD/ICA antibodies, ketones
knowledge_origin=ESMO 2017 guideline + assistant operationalization
literature_basis="It is recommended that blood glucose levels are regularly monitored in patients treated with ICPis". Ketoacidosis is life-threatening. Type 1 DM G3-4 requires immediate admission [I, A]
monitored_target=immune-related type 1 diabetes mellitus and diabetic ketoacidosis as an immune-related adverse event of immune checkpoint inhibitor therapy, tracing to the ICI therapy action (Administer_ICI)
monitoring_frequency_basis=the guideline says "regularly monitored" without a cadence. Same-draw-as-pre-infusion bloods is proposed so glucose is checked whenever the drug is given (MonitoringFrequency rule 1). DKA is acute, hence the symptom trigger (rule 2)
monitoring_stance=recommended
provenance_type=assistant_completed_from_guidelines
source.1=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Type 1 diabetes mellitus iv126
source.2=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Table 2 (Immune-related endocrinopathies) iv139
source_kind=clinical_guideline
trigger=new hyperglycaemia or ketoacidosis symptoms
' ;
end action.

action  :: 'Monitor_Nephritis' ;
     caption :: 'Monitor renal function for immune-related nephritis (Na, K, creatinine, urea)' ;
     metaprops :: 'ServiceRequest.code=serum sodium, potassium, creatinine and urea
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=baseline and before every ICI infusion
ServiceRequest.patientInstruction=report reduced urine output, blood in urine, or swelling
ServiceRequest.performerInstruction=grade creatinine against the patient\'s baseline. G1 (1.5\\u00D7baseline or >ULN to 1.5\\u00D7ULN)\\: continue ICI and repeat creatinine weekly. G2 (>1.5-3\\u00D7 baseline)\\: withhold ICI, hydrate, review in 48-72 h, and discuss with a nephrologist if not improving. G3 (>3\\u00D7 baseline or >3-6\\u00D7ULN)\\: withhold ICI, admit, and repeat creatinine every 24 h. Oliguria means inpatient admission. Stop nephrotoxic drugs and rule out infection or obstruction
applies_when=all_patients_on_therapy
assistant_invention=patient symptom wording (only oliguria is source-stated\\: "Advise patient to notify if oliguric")
category=undesired_ade
cq=CQ3, CQ5, CQ7
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= serum sodium, potassium, creatinine and urea; ServiceRequest.occurrenceTiming \\= baseline and before every ICI infusion; ServiceRequest.patientInstruction \\= report reduced urine output, blood in urine, or swelling; ServiceRequest.performerInstruction \\= grade creatinine against the patient\'s baseline. G1 (1.5\\u00D7baseline or >ULN to 1.5\\u00D7ULN)\\: continue ICI and repeat creatinine weekly. G2 (>1.5-3\\u00D7 baseline)\\: withhold ICI, hydrate, review in 48-72 h, and discuss with a nephrologist if not improving. G3 (>3\\u00D7 baseline or >3-6\\u00D7ULN)\\: withhold ICI, admit, and repeat creatinine every 24 h. Oliguria means inpatient admission. Stop nephrotoxic drugs and rule out infection or obstruction
goal.verb=order
guideline_status=specified_as_a_guideline_monitoring_task
instrument=serum Na, K, creatinine, urea; triggered urinalysis/UPCR, renal ultrasound
knowledge_origin=ESMO 2017 guideline + assistant operationalization
literature_basis="Serum sodium, potassium, creatinine and urea should be measured before every infusion". Fig 14 grades against baseline creatinine
monitored_target=immune-related nephritis (renal toxicity) as an immune-related adverse event of immune checkpoint inhibitor therapy, tracing to the ICI therapy action (Administer_ICI)
monitoring_frequency_basis=guideline-stated "before every infusion"
monitoring_stance=recommended
provenance_type=guideline_specified
source.1=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Renal toxicity iv133
source.2=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Figure 14 (management of nephritis) iv138
source_kind=clinical_guideline
trigger=creatinine >1.5\\u00D7 baseline; oliguria
' ;
end action.

action  :: 'Monitor_Skin' ;
     caption :: 'Monitor for immune-related skin toxicity' ;
     metaprops :: 'ServiceRequest.code=skin and mucosa symptom screen with triggered physical examination and CTCAE grading
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=each visit (symptom review), with full skin exam on any skin symptom
ServiceRequest.patientInstruction=report any new rash, itching, blistering, skin peeling, mouth or genital sores, or rash with fever
ServiceRequest.performerInstruction=exclude other causes. Examine all skin including mucosa, grade by BSA (CTCAE), and check FBC, liver and kidney tests if needed. G2\\: continue and recheck weekly. G3\\: withhold ICI and refer to dermatology. G4, SJS/TEN/DRESS\\: permanently discontinue ICI, hospitalise and get urgent dermatology care
applies_when=all_patients_on_therapy
assistant_invention=each-visit symptom review cadence; patient symptom wording
category=undesired_ade
cq=CQ3, CQ5, CQ7
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= skin and mucosa symptom screen with triggered physical examination and CTCAE grading; ServiceRequest.occurrenceTiming \\= each visit (symptom review), with full skin exam on any skin symptom; ServiceRequest.patientInstruction \\= report any new rash, itching, blistering, skin peeling, mouth or genital sores, or rash with fever; ServiceRequest.performerInstruction \\= exclude other causes. Examine all skin including mucosa, grade by BSA (CTCAE), and check FBC, liver and kidney tests if needed. G2\\: continue and recheck weekly. G3\\: withhold ICI and refer to dermatology. G4, SJS/TEN/DRESS\\: permanently discontinue ICI, hospitalise and get urgent dermatology care
goal.verb=order
guideline_status=specified_as_a_guideline_monitoring_task
instrument=patient symptom report; physical examination with BSA/CTCAE grading
knowledge_origin=ESMO 2017 guideline + assistant operationalization
literature_basis=when a patient presents with a skin AE, rule out other causes, then do "a careful and thorough physical examination of the skin including the mucosal areas". Life-threatening reactions mean permanent discontinuation and hospitalisation
monitored_target=immune-related skin toxicity including SJS/TEN/DRESS as an immune-related adverse event of immune checkpoint inhibitor therapy, tracing to the ICI therapy action (Administer_ICI)
monitoring_frequency_basis=skin AEs develop "within the first few weeks". The guideline specifies assessment on presentation only. The each-visit symptom review is assistant-proposed. The guideline makes no recommendation for routine full-body skin examination
monitoring_stance=symptom_triggered_only
provenance_type=guideline_specified
source.1=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Immune-related skin toxicity iv122-iv123
source.2=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Figure 3 (management of skin rash) iv123
source_kind=clinical_guideline
trigger=skin sloughing or epidermal detachment, mucosal involvement, rash with fever (possible SJS/TEN/DRESS)
' ;
end action.

action  :: 'Monitor_Colitis' ;
     caption :: 'Monitor for immune-related diarrhoea and colitis' ;
     metaprops :: 'ServiceRequest.code=diarrhoea and colitis symptom screen with triggered blood and stool work-up
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=each visit (symptom review) and on any diarrhoea, continuing after the last dose (enterocolitis may occur months after ipilimumab)
ServiceRequest.patientInstruction=report any increase in stool frequency over baseline, blood or mucus in stool, abdominal pain, nocturnal stools, fever, or signs of dehydration
ServiceRequest.performerInstruction=on diarrhoea, test FBC, UEC, LFTs, CRP and TFTs, plus stool microscopy and culture, viral PCR and C. difficile toxin (mandatory for significant diarrhoea on anti-CTLA4). G2 (4-6 stools/day over baseline)\\: withhold ICI, contact the patient every 72 h, and book sigmoidoscopy/colonoscopy. Severe (\\u22657 stools/day, or G1-2 with dehydration, fever, tachycardia or haematochezia)\\: hospitalise, give i.v. methylprednisolone 1-2 mg/kg, and do endoscopy
applies_when=all_patients_on_therapy
assistant_invention=each-visit review cadence; patient symptom wording
category=undesired_ade
cq=CQ3, CQ5, CQ7
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= diarrhoea and colitis symptom screen with triggered blood and stool work-up; ServiceRequest.occurrenceTiming \\= each visit (symptom review) and on any diarrhoea, continuing after the last dose (enterocolitis may occur months after ipilimumab); ServiceRequest.patientInstruction \\= report any increase in stool frequency over baseline, blood or mucus in stool, abdominal pain, nocturnal stools, fever, or signs of dehydration; ServiceRequest.performerInstruction \\= on diarrhoea, test FBC, UEC, LFTs, CRP and TFTs, plus stool microscopy and culture, viral PCR and C. difficile toxin (mandatory for significant diarrhoea on anti-CTLA4). G2 (4-6 stools/day over baseline)\\: withhold ICI, contact the patient every 72 h, and book sigmoidoscopy/colonoscopy. Severe (\\u22657 stools/day, or G1-2 with dehydration, fever, tachycardia or haematochezia)\\: hospitalise, give i.v. methylprednisolone 1-2 mg/kg, and do endoscopy
goal.verb=order
guideline_status=specified_as_a_guideline_monitoring_task
instrument=patient symptom report (stool count vs baseline); triggered FBC, UEC, LFT, CRP, TFT, stool tests, endoscopy
knowledge_origin=ESMO 2017 guideline + assistant operationalization
literature_basis=severe diarrhoea definition (iv129). Diarrhoea on anti-CTLA4 needs work-up with CBC, electrolytes and stool analyses. No routine predictive biomarker; prophylactic budesonide is ineffective
monitored_target=immune-related diarrhoea and colitis as an immune-related adverse event of immune checkpoint inhibitor therapy, tracing to the ICI therapy action (Administer_ICI)
monitoring_frequency_basis=symptom-triggered. The guideline gives a triggered work-up and states "No routine biomarker" predicts colitis. Each-visit review is assistant-proposed
monitoring_stance=symptom_triggered_only
provenance_type=guideline_specified
source.1=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Gastrointestinal toxicity iv128-iv130
source.2=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Figure 8 (management of diarrhoea and colitis) iv129
source_kind=clinical_guideline
trigger=severe diarrhoea as defined, or G2 persisting >3 days; peritonism/perforation
' ;
end action.

action  :: 'Monitor_Pneumonitis' ;
     caption :: 'Monitor for immune-related pneumonitis' ;
     metaprops :: 'ServiceRequest.code=respiratory symptom screen with triggered chest CT
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=each visit (symptom review) and on any new respiratory symptom, throughout therapy (pneumonitis tends to occur months after initiation)
ServiceRequest.patientInstruction=report new or worsening cough, shortness of breath, chest pain, or fever
ServiceRequest.performerInstruction=on any new respiratory symptom, do a dedicated evaluation with CT. Order chest X-ray and bloods (FBC/UEC/LFTs/TFTs/Ca/ESR/CRP), and consider sputum and infection screen. G2\\: withhold ICI and monitor symptoms daily. G3-4 (severe symptoms, new or worsening hypoxia)\\: discontinue ICI, admit, give i.v. methylprednisolone 2-4 mg/kg/day, and arrange respiratory review and HRCT \\u00B1 bronchoscopy/BAL
applies_when=all_patients_on_therapy
assistant_invention=each-visit review cadence
category=undesired_ade
cq=CQ3, CQ5, CQ7
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= respiratory symptom screen with triggered chest CT; ServiceRequest.occurrenceTiming \\= each visit (symptom review) and on any new respiratory symptom, throughout therapy (pneumonitis tends to occur months after initiation); ServiceRequest.patientInstruction \\= report new or worsening cough, shortness of breath, chest pain, or fever; ServiceRequest.performerInstruction \\= on any new respiratory symptom, do a dedicated evaluation with CT. Order chest X-ray and bloods (FBC/UEC/LFTs/TFTs/Ca/ESR/CRP), and consider sputum and infection screen. G2\\: withhold ICI and monitor symptoms daily. G3-4 (severe symptoms, new or worsening hypoxia)\\: discontinue ICI, admit, give i.v. methylprednisolone 2-4 mg/kg/day, and arrange respiratory review and HRCT \\u00B1 bronchoscopy/BAL
goal.verb=order
guideline_status=specified_as_a_guideline_monitoring_task
instrument=patient symptom report; triggered chest CT, chest X-ray, oxygen saturation, bloods
knowledge_origin=ESMO 2017 guideline + assistant operationalization
literature_basis="any new respiratory symptom should prompt a dedicated evaluation". Patients with new cough, shortness of breath or hypoxia "should be assessed by CT"
monitored_target=immune-related pneumonitis as an immune-related adverse event of immune checkpoint inhibitor therapy, tracing to the ICI therapy action (Administer_ICI)
monitoring_frequency_basis=guideline says "Any respiratory symptom or sign must be carefully monitored" and every new symptom gets CT. Each-visit review is assistant-proposed
monitoring_stance=symptom_triggered_only
provenance_type=guideline_specified
source.1=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Immune-related pneumonitis iv131-iv133
source.2=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Figure 9 (management of pneumonitis) iv132
source_kind=clinical_guideline
trigger=new/worsening hypoxia, severe dyspnoea, difficulty breathing
' ;
end action.

action  :: 'Monitor_Neurological' ;
     caption :: 'Monitor for immune-related neurological toxicity' ;
     metaprops :: 'ServiceRequest.code=neurological symptom screen with triggered neurological examination and work-up
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=each visit (symptom review) and on any new neurological symptom
ServiceRequest.patientInstruction=report new weakness, numbness or tingling, double vision or drooping eyelids, facial weakness, difficulty swallowing or breathing, confusion, severe headache, or neck stiffness
ServiceRequest.performerInstruction=exclude progression, seizures, infection and metabolic causes. For any symptom beyond mild (or any cranial nerve problem), withhold ICI. Get an early neurology consult and MRI, NCS/EMG, lumbar puncture as indicated. If severe (limits self-care, respiratory involvement), admit, give i.v. methylprednisolone 2 mg/kg, and arrange daily neurological review \\u00B1 vital capacity
applies_when=all_patients_on_therapy
assistant_invention=each-visit review cadence; patient symptom wording drawn from the syndromes in Fig 10-12
category=undesired_ade
cq=CQ3, CQ5, CQ7
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= neurological symptom screen with triggered neurological examination and work-up; ServiceRequest.occurrenceTiming \\= each visit (symptom review) and on any new neurological symptom; ServiceRequest.patientInstruction \\= report new weakness, numbness or tingling, double vision or drooping eyelids, facial weakness, difficulty swallowing or breathing, confusion, severe headache, or neck stiffness; ServiceRequest.performerInstruction \\= exclude progression, seizures, infection and metabolic causes. For any symptom beyond mild (or any cranial nerve problem), withhold ICI. Get an early neurology consult and MRI, NCS/EMG, lumbar puncture as indicated. If severe (limits self-care, respiratory involvement), admit, give i.v. methylprednisolone 2 mg/kg, and arrange daily neurological review \\u00B1 vital capacity
goal.verb=order
guideline_status=specified_as_a_guideline_monitoring_task
instrument=patient symptom report; triggered neurological exam, MRI, NCS/EMG, lumbar puncture, vital capacity
knowledge_origin=ESMO 2017 guideline + assistant operationalization
literature_basis=rule out other causes. "Early consultation with a neurologist is advised". Withhold ICI for all but grade 1 until the AE is defined [V, B]
monitored_target=immune-related neurological toxicity as an immune-related adverse event of immune checkpoint inhibitor therapy, tracing to the ICI therapy action (Administer_ICI)
monitoring_frequency_basis=onset 6-13 weeks (iv133). The guideline specifies triggered work-up only. Each-visit review is assistant-proposed
monitoring_stance=symptom_triggered_only
provenance_type=guideline_specified
source.1=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Neurological toxicity iv133
source.2=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Figures 10-12 iv134-iv136
source_kind=clinical_guideline
trigger=respiratory or bulbar weakness, rapidly progressive weakness, altered consciousness
' ;
end action.

action  :: 'Monitor_Myocarditis' ;
     caption :: 'Monitor for immune-related myocarditis and cardiac toxicity' ;
     metaprops :: 'ServiceRequest.code=cardiac symptom screen with triggered cardiology assessment
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=each visit (symptom review) and on any new cardiac symptom
ServiceRequest.patientInstruction=report chest pain, breathlessness, palpitations, fainting, or leg swelling
ServiceRequest.performerInstruction=if a checkpoint-inhibitor cardiac AE (myocarditis) is suspected, admit, start high-dose methylprednisolone 1-2 mg/kg immediately, and consult cardiology early. Escalate to MMF or tacrolimus if deteriorating
applies_when=all_patients_on_therapy
assistant_invention=symptom list and each-visit screen (the guideline gives no symptoms, tests or surveillance for cardiac AEs)
category=undesired_ade
cq=CQ3, CQ5, CQ7
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= cardiac symptom screen with triggered cardiology assessment; ServiceRequest.occurrenceTiming \\= each visit (symptom review) and on any new cardiac symptom; ServiceRequest.patientInstruction \\= report chest pain, breathlessness, palpitations, fainting, or leg swelling; ServiceRequest.performerInstruction \\= if a checkpoint-inhibitor cardiac AE (myocarditis) is suspected, admit, start high-dose methylprednisolone 1-2 mg/kg immediately, and consult cardiology early. Escalate to MMF or tacrolimus if deteriorating
goal.verb=order
guideline_status=not_specified_as_a_guideline_monitoring_task
instrument=patient symptom report; clinician cardiology assessment (the guideline names no test)
knowledge_origin=ESMO 2017 guideline + assistant operationalization
literature_basis=myocarditis, pericarditis, arrhythmias, cardiomyopathy and impaired ventricular function are reported. "Early consultation with a cardiologist is recommended". Give steroids rapidly if suspected
monitored_target=immune-related cardiac toxicity (myocarditis) as an immune-related adverse event of immune checkpoint inhibitor therapy, tracing to the ICI therapy action (Administer_ICI)
monitoring_frequency_basis=cardiac AEs are rare (<1%) but serious, so event-driven. Each-visit review is assistant-proposed
monitoring_stance=symptom_triggered_only
provenance_type=assistant_completed_from_guidelines
source.1=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Cardiac toxicity iv133
source.2=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Table 2 (Cardiac toxicity) iv139
source_kind=clinical_guideline
trigger=suspected myocarditis
' ;
end action.

action  :: 'Monitor_Arthralgia' ;
     caption :: 'Monitor for immune-related arthralgia and myalgia' ;
     metaprops :: 'ServiceRequest.code=joint and muscle symptom screen with triggered rheumatological assessment
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=each visit (symptom review) and on joint or muscle symptoms
ServiceRequest.patientInstruction=report joint pain, swelling or stiffness, or muscle pain or weakness
ServiceRequest.performerInstruction=take a rheumatological history, examine all joints and skin, and order an autoimmune blood panel. G2\\: consider withholding ICI and refer to rheumatology early. G3 (severe, limits self-care)\\: withhold ICI, start prednisolone 0.5-1 mg/kg, and get rheumatology advice
applies_when=all_patients_on_therapy
assistant_invention=each-visit review cadence; patient symptom wording
category=undesired_ade
cq=CQ3, CQ5, CQ7
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= joint and muscle symptom screen with triggered rheumatological assessment; ServiceRequest.occurrenceTiming \\= each visit (symptom review) and on joint or muscle symptoms; ServiceRequest.patientInstruction \\= report joint pain, swelling or stiffness, or muscle pain or weakness; ServiceRequest.performerInstruction \\= take a rheumatological history, examine all joints and skin, and order an autoimmune blood panel. G2\\: consider withholding ICI and refer to rheumatology early. G3 (severe, limits self-care)\\: withhold ICI, start prednisolone 0.5-1 mg/kg, and get rheumatology advice
goal.verb=order
guideline_status=specified_as_a_guideline_monitoring_task
instrument=patient symptom report; joint examination; autoimmune blood panel; US/MRI of affected joints
knowledge_origin=ESMO 2017 guideline + assistant operationalization
literature_basis=myalgias and arthralgias in 2%-12%. Severe symptoms "should prompt consultation with a rheumatologist" [V, B]. Fig 13 gives grade-based assessment
monitored_target=immune-related arthralgia, arthritis and myalgia as an immune-related adverse event of immune checkpoint inhibitor therapy, tracing to the ICI therapy action (Administer_ICI)
monitoring_frequency_basis=symptom-triggered per Fig 13. Each-visit review is assistant-proposed
monitoring_stance=symptom_triggered_only
provenance_type=guideline_specified
source.1=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Rheumatological toxicity iv133
source.2=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Figure 13 (management of arthralgia) iv137
source_kind=clinical_guideline
trigger=severe polyarthritis or symptoms limiting self-care
' ;
end action.

action  :: 'Monitor_Autoimmune_Flare' ;
     caption :: 'Monitor pre-existing autoimmune disease for flare during ICI therapy' ;
     metaprops :: 'ServiceRequest.code=pre-existing autoimmune disease activity review
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=baseline and each visit during ICI therapy
ServiceRequest.patientInstruction=report any flare or worsening of your known autoimmune condition
ServiceRequest.performerInstruction=if the pre-existing autoimmune disease worsens, assess severity and involve the specialist managing that disease, manage organ-specific features per the relevant irAE algorithm
applies_when=patients with a history of autoimmune disease, or who are being actively treated for an autoimmune disease (iv121)
assistant_invention=the entire monitoring action (cadence, instrument, performer step); only the sub-population and risk are sourced
category=undesired_ade
cq=CQ3, CQ4, CQ5, CQ7
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= pre-existing autoimmune disease activity review; ServiceRequest.occurrenceTiming \\= baseline and each visit during ICI therapy; ServiceRequest.patientInstruction \\= report any flare or worsening of your known autoimmune condition; ServiceRequest.performerInstruction \\= if the pre-existing autoimmune disease worsens, assess severity and involve the specialist managing that disease, manage organ-specific features per the relevant irAE algorithm
goal.verb=order
guideline_status=not_specified_as_a_guideline_monitoring_task
instrument=patient symptom report; clinician review of disease activity
knowledge_origin=ESMO 2017 guideline + assistant operationalization
literature_basis=such patients "are at risk for worsening of their autoimmune disease while on immune checkpoint blockade". The guideline gives no monitoring instruction
monitored_target=worsening of pre-existing autoimmune disease as an immune-related adverse event of immune checkpoint inhibitor therapy, tracing to the ICI therapy action (Administer_ICI)
monitoring_frequency_basis=tied to the infusion-visit cadence (MonitoringFrequency rule 1). The guideline gives no cadence
monitoring_stance=proposed_by_assistant
provenance_type=assistant_completed_from_guidelines
source.1=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Patient selection and baseline assessments iv121
source_kind=clinical_guideline
trigger=worsening of the pre-existing autoimmune disease
' ;
     precondition ::pre_existing_autoimmune_disease = true;
end action.

action  :: 'Monitor_Allograft_Rejection' ;
     caption :: 'Monitor allograft function for rejection during anti-PD-1 therapy' ;
     metaprops :: 'ServiceRequest.code=allograft function review (graft-specific function tests per transplant team)
ServiceRequest.intent=order
ServiceRequest.occurrenceTiming=baseline and each visit during anti-PD-1 therapy
ServiceRequest.patientInstruction=report symptoms of graft dysfunction as instructed by your transplant team
ServiceRequest.performerInstruction=if graft dysfunction is suspected, contact the transplant team urgently
applies_when=patients with allografted organs receiving anti-PD-1 therapy (iv134). The guideline says single-agent ipilimumab "may be administered without necessarily causing rejection"
assistant_invention=the entire monitoring action; only the sub-population and risk are sourced (the guideline\'s own evidence here is case reports it cites)
category=undesired_ade
cq=CQ3, CQ4, CQ5, CQ7
goal.noun_phrase=ServiceRequest.intent \\= order; ServiceRequest.code \\= allograft function review (graft-specific function tests per transplant team); ServiceRequest.occurrenceTiming \\= baseline and each visit during anti-PD-1 therapy; ServiceRequest.patientInstruction \\= report symptoms of graft dysfunction as instructed by your transplant team; ServiceRequest.performerInstruction \\= if graft dysfunction is suspected, contact the transplant team urgently
goal.verb=order
guideline_status=not_specified_as_a_guideline_monitoring_task
instrument=clinician review with graft-specific function tests (assistant-proposed)
knowledge_origin=ESMO 2017 guideline + assistant operationalization
literature_basis=several case reports document acute allograft rejection after anti-PD-1. "This very significant risk must be considered in discussing systemic therapy options"
monitored_target=acute solid-organ allograft rejection as an immune-related adverse event of immune checkpoint inhibitor therapy, tracing to the ICI therapy action (Administer_ICI)
monitoring_frequency_basis=tied to the infusion-visit cadence. The guideline gives no cadence
monitoring_stance=proposed_by_assistant
provenance_type=assistant_completed_from_guidelines
source.1=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Allograft rejection iv134
source_kind=clinical_guideline
trigger=suspected acute graft rejection
' ;
     precondition ::organ_allograft = true and (ici_regimen = anti_PD1 or ici_regimen = anti_CTLA4_plus_anti_PD1);
end action.

