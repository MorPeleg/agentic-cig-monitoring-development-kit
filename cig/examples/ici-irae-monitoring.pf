data  :: 'pre_existing_autoimmune_disease' ;
     type :: boolean ;
     caption :: 'Pre-existing autoimmune disease?' ;
     description :: 'History of autoimmune disease, or active treatment for an autoimmune disease; risk factor for worsening on ICI (ESMO 2017 iv121). Read by the Decision arguments and the precondition of Monitor_Autoimmune_Flare' ;
     metaprops :: 'ontology.coding=SNOMED\\:85828009
ontology.label=Autoimmune disease (disorder)
quote=iv121\\: "Patients with a history of autoimmune disease ... are at risk for worsening of their autoimmune disease while on immune checkpoint blockade"
source=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Patient selection and baseline assessments iv121
' ;
end data.

data  :: 'prior_irAE_on_ICI' ;
     type :: boolean ;
     caption :: 'Prior irAE on a previous ICI course?' ;
     description :: 'Immune-related adverse event on a previous ICI course, either class (ESMO 2017 iv121). Read by the Decision arguments Ontology coding: Adverse reaction caused by drug (disorder), broader than an irAE on a previous ICI course (SNOMED CT has no closer concept).' ;
     metaprops :: 'ontology.coding=SNOMED\\:62014003
ontology.label=Adverse reaction caused by drug (disorder)
quote=iv121\\: "patients that have had irAEs on ipilimumab are at risk of developing irAEs following anti-PD-1 treatment and vice versa"
source=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Patient selection and baseline assessments iv121
' ;
end data.

data  :: 'organ_allograft' ;
     type :: boolean ;
     caption :: 'Solid-organ allograft recipient?' ;
     description :: 'Solid-organ allograft recipient; risk of acute rejection on anti-PD-1 (ESMO 2017 iv134). Read by the Decision arguments and the precondition of Monitor_Allograft_Rejection' ;
     metaprops :: 'ontology.coding=SNOMED\\:737294004
ontology.label=Transplant present (finding)
quote=iv134\\: "several recent case reports have documented the risk of acute allograft rejection after anti-PD-1 therapy"
source=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Allograft rejection iv134
' ;
end data.

data  :: 'ici_regimen' ;
     type :: text ;
     caption :: 'Planned ICI regimen' ;
     description :: 'Class of the planned ICI regimen (ESMO 2017 Table 1): anti_CTLA4, anti_PD1, anti_PDL1 or anti_CTLA4_plus_anti_PD1. Read by the precondition of Monitor_Allograft_Rejection; also selects the Fig 5 TFT schedule (not executable)' ;
     metaprops :: 'ontology.coding=SNOMED\\:870400009
ontology.label=Immune checkpoint inhibitor
quote=Fig 5, iv125\\: "Monitoring during treatment\\: Anti-CTLA4 (including combination with anti-PD-1) ... Anti-PD-1/Anti-PD-L1"
source=ESMO 2017 Haanen et al., Ann Oncol 28(Suppl 4) iv119, Figure 5 (ICPi monitoring and management\\: thyroid function) iv125
' ;
     range ::"anti_CTLA4","anti_PD1","anti_PDL1","anti_CTLA4_plus_anti_PD1";
end data.
