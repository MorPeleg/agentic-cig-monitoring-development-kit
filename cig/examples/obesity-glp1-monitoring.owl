    DataPropertyAssertion(pf:caption Eligibility_Decision "Decide whether the patient is eligible for GLP-1 obesity therapy")
    DataPropertyAssertion(pf:caption Get_Eligibility_Data "Retrieve baseline data needed to judge GLP-1 eligibility and to set monitoring baselines")
    DataPropertyAssertion(pf:caption Monitor_Actions "Monitor enactment of the therapy recommendations")
    DataPropertyAssertion(pf:caption Monitor_Anhedonia "Monitor mood, anhedonia, and suicidality")
    DataPropertyAssertion(pf:caption Monitor_Body_Composition "Monitor body composition (lean vs fat mass)")
    DataPropertyAssertion(pf:caption Monitor_Body_Weight "Monitor body weight and percent weight change")
    DataPropertyAssertion(pf:caption Monitor_Cardiometabolic "Monitor cardiometabolic risk markers (HbA1c, lipids, blood pressure)")
    DataPropertyAssertion(pf:caption Monitor_Desired_State "Monitor whether desired outcome states are achieved")
    DataPropertyAssertion(pf:caption Monitor_GI_ADE "Monitor gastrointestinal adverse effects (nausea, vomiting, diarrhea, constipation)")
    DataPropertyAssertion(pf:caption Monitor_GLP1_Adherence "Monitor GLP-1 prescription fill and dose-escalation adherence")
    DataPropertyAssertion(pf:caption Monitor_Hypoglycemia "Monitor for hypoglycemia in patients on concomitant insulin or an insulin secretagogue")
    DataPropertyAssertion(pf:caption Monitor_Lifestyle_Adherence "Monitor adherence to diet and physical-activity prescription")
    DataPropertyAssertion(pf:caption Monitor_Pancreatitis "Monitor for acute pancreatitis")
    DataPropertyAssertion(pf:caption Monitor_QoL "Monitor obesity-related quality of life")
    DataPropertyAssertion(pf:caption Monitor_Undesired_State "Monitor undesired states and adverse drug effects")
    DataPropertyAssertion(pf:caption Monitoring_Plan "Monitor therapy enactment, desired outcomes, and undesired effects in parallel")
    DataPropertyAssertion(pf:caption Obesity_GLP1_Plan "Manage obesity with GLP-1 therapy and monitor enactment, desired outcomes, and undesired effects")
    DataPropertyAssertion(pf:caption Obesity_Therapy "GLP-1 pharmacotherapy plus lifestyle and lean-mass-preserving therapy")
    DataPropertyAssertion(pf:caption Prescribe_GLP1 "Prescribe GLP-1 receptor agonist (semaglutide) with dose escalation")
    DataPropertyAssertion(pf:caption Prescribe_Lifestyle "Prescribe reduced-calorie diet and increased physical activity")
    DataPropertyAssertion(pf:caption Prescribe_Resistance_Exercise "Prescribe resistance training and adequate protein intake to preserve lean mass")
    DataPropertyAssertion(pf:choice_mode Eligibility_Decision "single")
    DataPropertyAssertion(pf:description Data_BMI "Body mass index; primary eligibility threshold")
    DataPropertyAssertion(pf:description Data_Baseline_Body_Composition "Baseline lean vs fat mass (BIA); reference for muscle-loss avoidance monitoring")
    DataPropertyAssertion(pf:description Data_Baseline_Cardiometabolic_Labs "HbA1c, fasting glucose, lipid panel, and blood pressure; reference for cardiometabolic-risk desired-outcome monitoring")
    DataPropertyAssertion(pf:description Data_Baseline_Weight "Baseline body weight; reference for percent weight change desired-outcome monitoring")
    DataPropertyAssertion(pf:description Data_Contraindications "Personal/family history of medullary thyroid carcinoma or MEN2, prior pancreatitis, pregnancy/planned pregnancy")
    DataPropertyAssertion(pf:description Data_Weight_Related_Comorbidity "Presence of type 2 diabetes, hypertension, dyslipidemia, OSA, or NAFLD; lowers BMI threshold to 27")
    DataPropertyAssertion(pf:description Get_Eligibility_Data "Eligibility and baseline data items: BMI; weight-related comorbidity (type 2 diabetes, hypertension, dyslipidemia, OSA, NAFLD); contraindications (personal/family history of medullary thyroid carcinoma or MEN2, prior pancreatitis, pregnancy/planned pregnancy); current medications; renal function (eGFR); thyroid history; mood/psychiatric history including prior depression or suicidality; baseline weight; baseline body composition (lean vs fat mass); baseline cardiometabolic labs (HbA1c, fasting glucose, lipid panel, blood pressure); baseline quality of life. Six are wired below as Source->Data; the rest are enumerated here.")
    DataPropertyAssertion(pf:metaprops Monitor_Anhedonia "ServiceRequest.intent=order; ServiceRequest.code=mood and anhedonia screen (PHQ-9) with suicidality screen (C-SSRS); ServiceRequest.occurrenceTiming=baseline then each visit (monthly x3, then q3mo); ServiceRequest.patientInstruction=report loss of interest or pleasure, low mood, reduced motivation, or thoughts of self-harm; ServiceRequest.performerInstruction=if PHQ-9 elevated or any suicidality, administer C-SSRS and refer per protocol; category=undesired_ade; monitored_target=reduced enjoyment of life / anhedonia and possible mood change as a mechanism-of-action harm of GLP-1 reward-pathway modulation (Prescribe_GLP1); applies_when=all_patients_on_therapy; provenance_type=mechanism_prompted_then_assistant_independent_literature_search_and_operationalized; source_kind=safety_source_plus_screening_instrument; source=FDA Wegovy label Warnings and Precautions on monitoring for depression, mood changes, and suicidal ideation; source=PHQ-9 Patient Health Questionnaire-9 (Kroenke K, J Gen Intern Med 2001;16:606); source=Columbia-Suicide Severity Rating Scale (C-SSRS, Posner K, Am J Psychiatry 2011;168:1266); knowledge_origin=skill prompted the mechanism (reward-pathway modulation reducing enjoyment) then assistant selected validated instruments independently; guideline_status=not_specified_as_a_guideline_monitoring_task; monitoring_stance=recommended; literature_basis=GLP-1 acts on central reward pathways and labels advise monitoring for depression and suicidal ideation; PHQ-9 and C-SSRS are validated mood/suicidality screens; assistant_invention=operationalization as PHQ-9 plus C-SSRS at the GLP-1 follow-up cadence; instrument=PHQ-9 and C-SSRS questionnaires; monitoring_frequency_basis=mirrors GLP-1 follow-up visits so mood is screened whenever the drug is reviewed; trigger=positive depression screen or any suicidal ideation prompts same-day C-SSRS and referral; cq=CQ7")
    DataPropertyAssertion(pf:metaprops Monitor_Body_Composition "ServiceRequest.intent=order; ServiceRequest.code=body composition (bioelectrical impedance analysis) lean and fat mass; ServiceRequest.occurrenceTiming=baseline then q3mo; ServiceRequest.patientInstruction=use home BIA scale under standardized conditions (fasting, hydrated, same time of day); category=desired_outcome; monitored_target=preservation of lean mass / avoidance of sarcopenia during weight loss (Goal_avoid_muscle_loss on Prescribe_Resistance_Exercise); applies_when=all_patients_on_therapy; provenance_type=assistant_completed_from_guidelines; source_kind=clinical_guideline_plus_mechanism_reasoning; source=Endocrine Society Pharmacological Management of Obesity Clinical Practice Guideline (J Clin Endocrinol Metab 2015;100:342); knowledge_origin=mechanism (rapid weight loss causes lean-mass loss) plus guideline emphasis on preserving function; guideline_status=not_specified_as_a_guideline_monitoring_task; monitoring_stance=proposed_by_assistant; literature_basis=rapid weight loss reduces lean mass; resistance training and protein preserve it; assistant_invention=quarterly BIA cadence chosen to match clinic follow-up; instrument=bioelectrical impedance analysis (BIA); monitoring_frequency_basis=quarterly to track lean-mass trend without over-testing; trigger=disproportionate lean-mass loss prompts intensified resistance/protein plan; cq=CQ6")
    DataPropertyAssertion(pf:metaprops Monitor_Body_Weight "ServiceRequest.intent=order; ServiceRequest.code=body weight measurement and percent change from baseline; ServiceRequest.occurrenceTiming=baseline, monthly x3, then q3mo; ServiceRequest.patientInstruction=weigh under standardized conditions (morning, after voiding, light clothing); category=desired_outcome; monitored_target=desired outcome of 5-10 percent body-weight reduction (Goal_achieve_bw_reduction on Prescribe_GLP1); applies_when=all_patients_on_therapy; provenance_type=guideline_specified; source_kind=clinical_guideline; source=Endocrine Society Pharmacological Management of Obesity Clinical Practice Guideline (J Clin Endocrinol Metab 2015;100:342); knowledge_origin=guideline-specified efficacy assessment; guideline_status=specified_as_a_guideline_monitoring_task; monitoring_stance=recommended; literature_basis=guidelines assess percent weight loss at intervals and reconsider therapy if less than 5 percent at 3 months; assistant_invention=none; instrument=calibrated clinic scale and home scale; monitoring_frequency_basis=guideline 3-month efficacy checkpoint then quarterly; trigger=weight regain or less than 5 percent loss at 3 months prompts therapy review; cq=CQ5")
    DataPropertyAssertion(pf:metaprops Monitor_Cardiometabolic "ServiceRequest.intent=order; ServiceRequest.code=HbA1c, fasting lipid panel, fasting glucose, blood pressure; ServiceRequest.occurrenceTiming=baseline then q3-6mo; ServiceRequest.patientInstruction=fast 9-12 hours before the lipid and glucose draw; category=desired_outcome; monitored_target=reduced cardiometabolic risk abstraction computed from HbA1c, lipids, glucose, blood pressure (Goal_achieve_cardiometabolic on Prescribe_Lifestyle); applies_when=all_patients_on_therapy; provenance_type=guideline_specified; source_kind=clinical_guideline; source=Endocrine Society Pharmacological Management of Obesity Clinical Practice Guideline (J Clin Endocrinol Metab 2015;100:342); knowledge_origin=guideline-specified comorbidity monitoring; guideline_status=specified_as_a_guideline_monitoring_task; monitoring_stance=recommended; literature_basis=guidelines monitor glycemic, lipid, and blood-pressure response to weight-loss therapy; assistant_invention=composition of the four markers into a single cardiometabolic-risk abstraction; instrument=laboratory panel plus office blood-pressure measurement; monitoring_frequency_basis=quarterly-to-semiannual labs typical for metabolic follow-up; trigger=worsening glycemia or blood pressure prompts comorbidity management; cq=CQ5")
    DataPropertyAssertion(pf:metaprops Monitor_GI_ADE "ServiceRequest.intent=order; ServiceRequest.code=gastrointestinal symptom screen (nausea, vomiting, diarrhea, constipation, dehydration); ServiceRequest.occurrenceTiming=each visit and around dose escalation; ServiceRequest.patientInstruction=report persistent vomiting, inability to keep fluids down, or signs of dehydration; ServiceRequest.performerInstruction=if persistent vomiting or dehydration, assess volume status and renal function and consider dose reduction; category=undesired_ade; monitored_target=GLP-1 gastrointestinal adverse effects from the GLP-1 prescription (Prescribe_GLP1); applies_when=all_patients_on_therapy; provenance_type=package_insert_specified; source_kind=package_insert; source=Wegovy (semaglutide) US Prescribing Information, Adverse Reactions (nausea, vomiting, diarrhea, constipation); knowledge_origin=drug label; guideline_status=not_specified_as_a_guideline_monitoring_task; monitoring_stance=recommended; literature_basis=label lists GI effects as the most common adverse reactions, most frequent during dose escalation; assistant_invention=none; instrument=patient symptom report and clinician interview; monitoring_frequency_basis=GI effects cluster around titration so screen each visit and at escalation; trigger=persistent vomiting or dehydration prompts same-visit assessment; cq=CQ7")
    DataPropertyAssertion(pf:metaprops Monitor_GLP1_Adherence "ServiceRequest.intent=order; ServiceRequest.code=GLP-1 prescription fill and dose-escalation adherence; ServiceRequest.occurrenceTiming=each visit (baseline, monthly x3, then q3mo); ServiceRequest.patientInstruction=report missed doses, injection technique problems, and reasons for non-adherence; category=action_completion; monitored_target=enactment of the GLP-1 prescription therapy recommendation (Prescribe_GLP1); applies_when=all_patients_on_therapy; provenance_type=assistant_completed_from_guidelines; source_kind=clinical_guideline; source=Endocrine Society Pharmacological Management of Obesity Clinical Practice Guideline (J Clin Endocrinol Metab 2015;100:342); knowledge_origin=guideline-based follow-up cadence; guideline_status=specified_as_a_guideline_monitoring_task; monitoring_stance=recommended; literature_basis=obesity pharmacotherapy guidelines recommend regular follow-up to assess adherence and response and to titrate dose; assistant_invention=none; instrument=pharmacy refill records plus patient self-report; monitoring_frequency_basis=aligns with monthly x3 then q3mo obesity-pharmacotherapy follow-up; trigger=none; cq=CQ4")
    DataPropertyAssertion(pf:metaprops Monitor_Hypoglycemia "ServiceRequest.intent=order; ServiceRequest.code=hypoglycemia symptom screen with self-monitored blood glucose (SMBG) in at-risk patients; ServiceRequest.occurrenceTiming=each visit and on dose change of concomitant insulin or insulin secretagogue; ServiceRequest.patientInstruction=report shakiness, sweating, confusion, palpitations, or hunger and check SMBG when symptomatic; ServiceRequest.performerInstruction=if hypoglycemia is confirmed, reduce or stop the concomitant insulin or insulin secretagogue per protocol; category=undesired_ade; monitored_target=hypoglycemia as a labeled adverse effect when GLP-1 is combined with insulin or an insulin secretagogue, tracing to the GLP-1 prescription therapy recommendation (Prescribe_GLP1); applies_when=concomitant insulin or insulin secretagogue therapy (not patients on GLP-1 monotherapy); provenance_type=package_insert_specified; source_kind=package_insert; source=Wegovy (semaglutide) US Prescribing Information, Warnings and Precautions: Hypoglycemia (5.4); knowledge_origin=drug label warning, which scopes the risk to concomitant insulin/secretagogue use; guideline_status=not_specified_as_a_guideline_monitoring_task; monitoring_stance=recommended; literature_basis=label states concomitant use with insulin or an insulin secretagogue may increase the risk of hypoglycemia and that reducing the insulin/secretagogue dose may be necessary; assistant_invention=SMBG operationalization and visit-based screening cadence for the at-risk subgroup; instrument=patient symptom report plus self-monitored blood glucose (SMBG); monitoring_frequency_basis=tied to follow-up visits and to insulin/secretagogue dose changes when the interaction risk is highest; trigger=symptomatic hypoglycemia (shakiness, sweating, confusion, palpitations) or low SMBG; cq=CQ7")
    DataPropertyAssertion(pf:metaprops Monitor_Lifestyle_Adherence "ServiceRequest.intent=order; ServiceRequest.code=diet and physical-activity adherence; ServiceRequest.occurrenceTiming=each visit (monthly x3, then q3mo); ServiceRequest.patientInstruction=keep a food and activity log and report typical weekly activity minutes; category=action_completion; monitored_target=enactment of the lifestyle therapy recommendation (Prescribe_Lifestyle); applies_when=all_patients_on_therapy; provenance_type=assistant_completed_from_guidelines; source_kind=clinical_guideline; source=Endocrine Society Pharmacological Management of Obesity Clinical Practice Guideline (J Clin Endocrinol Metab 2015;100:342); knowledge_origin=guideline-based lifestyle co-therapy follow-up; guideline_status=specified_as_a_guideline_monitoring_task; monitoring_stance=recommended; literature_basis=guidelines advise lifestyle intervention alongside pharmacotherapy with ongoing reinforcement; assistant_invention=none; instrument=patient food/activity log plus self-report; monitoring_frequency_basis=tied to obesity-pharmacotherapy follow-up visits; trigger=none; cq=CQ4")
    DataPropertyAssertion(pf:metaprops Monitor_Pancreatitis "ServiceRequest.intent=order; ServiceRequest.code=acute pancreatitis symptom screen with triggered lipase; ServiceRequest.occurrenceTiming=each visit, with testing on symptoms; ServiceRequest.patientInstruction=report severe, persistent abdominal pain that may radiate to the back, with or without vomiting; ServiceRequest.performerInstruction=if suspected, discontinue GLP-1, measure serum lipase, and evaluate for pancreatitis; category=undesired_ade; monitored_target=acute pancreatitis as a labeled adverse effect of the GLP-1 prescription (Prescribe_GLP1); applies_when=all_patients_on_therapy; provenance_type=package_insert_specified; source_kind=package_insert; source=Wegovy (semaglutide) US Prescribing Information, Warnings and Precautions: Acute Pancreatitis; knowledge_origin=drug label warning; guideline_status=not_specified_as_a_guideline_monitoring_task; monitoring_stance=symptom_triggered_only; literature_basis=label warns of acute pancreatitis and advises discontinuation and evaluation if suspected; the label does not call for routine pancreatic-enzyme surveillance; assistant_invention=none; instrument=patient symptom report with triggered serum lipase; monitoring_frequency_basis=symptom-triggered because pancreatitis presents acutely; trigger=severe persistent abdominal pain prompts drug hold and lipase testing; cq=CQ7")
    DataPropertyAssertion(pf:metaprops Monitor_QoL "ServiceRequest.intent=order; ServiceRequest.code=obesity-related quality-of-life questionnaire (IWQOL-Lite); ServiceRequest.occurrenceTiming=baseline then q6mo; ServiceRequest.patientInstruction=complete the IWQOL-Lite questionnaire before the visit; category=desired_outcome; monitored_target=improved quality of life as a desired benefit of weight reduction (supports Goal_achieve_bw_reduction); applies_when=all_patients_on_therapy; provenance_type=assistant_independent_literature_search_and_operationalized; source_kind=screening_instrument; source=IWQOL-Lite Impact of Weight on Quality of Life-Lite validated instrument (Kolotkin RL, Obes Res 2001;9:102); knowledge_origin=assistant selected a validated QoL instrument independently; guideline_status=not_specified_as_a_guideline_monitoring_task; monitoring_stance=proposed_by_assistant; literature_basis=IWQOL-Lite is a validated obesity-specific QoL measure responsive to weight change; assistant_invention=semiannual QoL cadence and choice of IWQOL-Lite; instrument=IWQOL-Lite questionnaire (SF-36 acceptable alternative); monitoring_frequency_basis=QoL changes slowly so semiannual is sufficient; trigger=marked QoL decline prompts psychosocial review; cq=CQ5")
