    DataPropertyAssertion(pf:name Monitoring_Plan "Monitoring_Plan")
    DataPropertyAssertion(pf:name Not_Eligible "Not_Eligible")
    DataPropertyAssertion(pf:name Obesity_GLP1_Plan "Obesity_GLP1_Plan")
    DataPropertyAssertion(pf:name Obesity_Therapy "Obesity_Therapy")
    DataPropertyAssertion(pf:name Prescribe_GLP1 "Prescribe_GLP1")
    DataPropertyAssertion(pf:name Prescribe_Lifestyle "Prescribe_Lifestyle")
    DataPropertyAssertion(pf:name Prescribe_Resistance_Exercise "Prescribe_Resistance_Exercise")
    DataPropertyAssertion(pf:noun_phrase Goal_achieve_bw_reduction "body-weight reduction of 5-10 percent within 6-12 months")
    DataPropertyAssertion(pf:noun_phrase Goal_achieve_cardiometabolic "reduced cardiometabolic risk (improved HbA1c, lipids, blood pressure)")
    DataPropertyAssertion(pf:noun_phrase Goal_avoid_muscle_loss "muscle / lean-mass loss (sarcopenia) during rapid weight loss")
    DataPropertyAssertion(pf:noun_phrase Goal_order_anhedonia "ServiceRequest.intent = order; ServiceRequest.code = mood and anhedonia screen (PHQ-9) with suicidality screen (C-SSRS); ServiceRequest.occurrenceTiming = baseline then each visit (monthly x3, then q3mo); ServiceRequest.patientInstruction = report loss of interest or pleasure, low mood, reduced motivation, or thoughts of self-harm; ServiceRequest.performerInstruction = if PHQ-9 elevated or any suicidality, administer C-SSRS and refer per protocol")
    DataPropertyAssertion(pf:noun_phrase Goal_order_body_composition "ServiceRequest.intent = order; ServiceRequest.code = body composition (bioelectrical impedance analysis) lean and fat mass; ServiceRequest.occurrenceTiming = baseline then q3mo; ServiceRequest.patientInstruction = use home BIA scale under standardized conditions (fasting, hydrated, same time of day)")
    DataPropertyAssertion(pf:noun_phrase Goal_order_body_weight "ServiceRequest.intent = order; ServiceRequest.code = body weight measurement and percent change from baseline; ServiceRequest.occurrenceTiming = baseline, monthly x3, then q3mo; ServiceRequest.patientInstruction = weigh under standardized conditions (morning, after voiding, light clothing)")
    DataPropertyAssertion(pf:noun_phrase Goal_order_cardiometabolic "ServiceRequest.intent = order; ServiceRequest.code = HbA1c, fasting lipid panel, fasting glucose, blood pressure; ServiceRequest.occurrenceTiming = baseline then q3-6mo; ServiceRequest.patientInstruction = fast 9-12 hours before the lipid and glucose draw")
    DataPropertyAssertion(pf:noun_phrase Goal_order_gi_ade "ServiceRequest.intent = order; ServiceRequest.code = gastrointestinal symptom screen (nausea, vomiting, diarrhea, constipation, dehydration); ServiceRequest.occurrenceTiming = each visit and around dose escalation; ServiceRequest.patientInstruction = report persistent vomiting, inability to keep fluids down, or signs of dehydration")
    DataPropertyAssertion(pf:noun_phrase Goal_order_glp1_adherence "ServiceRequest.intent = order; ServiceRequest.code = GLP-1 prescription fill and dose-escalation adherence; ServiceRequest.occurrenceTiming = each visit (baseline, monthly x3, then q3mo); ServiceRequest.patientInstruction = report missed doses, injection technique problems, and reasons for non-adherence")
    DataPropertyAssertion(pf:noun_phrase Goal_order_hypoglycemia "ServiceRequest.intent = order; ServiceRequest.code = hypoglycemia symptom screen with self-monitored blood glucose (SMBG) in at-risk patients; ServiceRequest.occurrenceTiming = each visit and on dose change of concomitant insulin or insulin secretagogue; ServiceRequest.patientInstruction = report shakiness, sweating, confusion, palpitations, or hunger and check SMBG when symptomatic; ServiceRequest.performerInstruction = if hypoglycemia is confirmed, reduce or stop the concomitant insulin or insulin secretagogue per protocol")
    DataPropertyAssertion(pf:noun_phrase Goal_order_lifestyle_adherence "ServiceRequest.intent = order; ServiceRequest.code = diet and physical-activity adherence; ServiceRequest.occurrenceTiming = each visit (monthly x3, then q3mo); ServiceRequest.patientInstruction = keep a food and activity log and report typical weekly activity minutes")
    DataPropertyAssertion(pf:noun_phrase Goal_order_pancreatitis "ServiceRequest.intent = order; ServiceRequest.code = acute pancreatitis symptom screen with triggered lipase; ServiceRequest.occurrenceTiming = each visit, with testing on symptoms; ServiceRequest.patientInstruction = report severe, persistent abdominal pain that may radiate to the back, with or without vomiting; ServiceRequest.performerInstruction = if suspected, discontinue GLP-1, measure serum lipase, and evaluate for pancreatitis")
    DataPropertyAssertion(pf:noun_phrase Goal_order_qol "ServiceRequest.intent = order; ServiceRequest.code = obesity-related quality-of-life questionnaire (IWQOL-Lite); ServiceRequest.occurrenceTiming = baseline then q6mo; ServiceRequest.patientInstruction = complete the IWQOL-Lite questionnaire before the visit")
    DataPropertyAssertion(pf:noun_phrase Goal_treat_obesity "obesity in adults with BMI >= 30, or BMI >= 27 with a weight-related comorbidity")
    DataPropertyAssertion(pf:string_representation Cond_Eligible "(BMI >= 30 OR (BMI >= 27 AND weight_related_comorbidity = true)) AND contraindications = none")
    DataPropertyAssertion(pf:string_representation Cond_Not_Eligible "BMI < 27 OR (BMI < 30 AND weight_related_comorbidity = false) OR contraindications != none")
