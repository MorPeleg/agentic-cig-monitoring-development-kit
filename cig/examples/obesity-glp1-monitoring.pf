end action.

action  :: 'Monitor_Pancreatitis' ;
     caption :: 'Monitor for acute pancreatitis' ;
     description :: 'Monitors acute pancreatitis as a labeled adverse effect of the GLP-1 prescription (Prescribe_GLP1). Label warns of acute pancreatitis and advises discontinuation and evaluation if suspected; the label does not call for routine pancreatic-enzyme surveillance.' ;
     metaprops :: 'applies_when=all_patients_on_therapy
assistant_invention=none
category=undesired_ade
cq=CQ7
goal.noun_phrase=acute pancreatitis symptom screen with triggered lipase, each visit, with testing on symptoms
goal.verb=order
guideline_status=not_specified_as_a_guideline_monitoring_task
