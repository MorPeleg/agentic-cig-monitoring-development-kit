ontology.coding=SNOMED\\:197456007
ontology.label=Acute pancreatitis (disorder)
order.code=acute pancreatitis symptom screen with triggered lipase
order.patient_instruction=report severe, persistent abdominal pain that may radiate to the back, with or without vomiting
order.performer_instruction=if suspected, discontinue GLP-1, measure serum lipase, and evaluate for pancreatitis
order.timing=each visit, with testing on symptoms
provenance_type=package_insert_specified
quote=\\u00A75.2\\: "After initiation of WEGOVY, observe patients carefully for signs and symptoms of acute pancreatitis ... If pancreatitis is suspected, discontinue WEGOVY and initiate appropriate management."
source=Wegovy (semaglutide) US Prescribing Information (revised 02/2026), Warnings and Precautions\\: Acute Pancreatitis (5.2)
source_kind=package_insert
trigger=severe persistent abdominal pain prompts drug hold and lipase testing
' ;
     procedure :: 'Acute pancreatitis symptom screen with triggered lipase, each visit, with testing on symptoms. Patient: report severe, persistent abdominal pain that may radiate to the back, with or without vomiting. Clinician: if suspected, discontinue GLP-1, measure serum lipase, and evaluate for pancreatitis.' ;
end action.

