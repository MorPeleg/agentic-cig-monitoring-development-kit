action  :: 'Monitor_Body_Composition' ;
     caption :: 'Monitor body composition (lean vs fat mass)' ;
     description :: 'Monitors preservation of lean mass / avoidance of sarcopenia during weight loss (avoid goal of Prescribe_Resistance_Exercise). Rapid weight loss reduces lean mass; resistance training and protein preserve it.' ;
     metaprops :: 'applies_when=all_patients_on_therapy
