action  :: 'Prescribe_GLP1' ;
     caption :: 'Prescribe GLP-1 receptor agonist (semaglutide) with dose escalation' ;
     description :: 'Prescribes semaglutide (Wegovy), a GLP-1 receptor agonist, once weekly by subcutaneous injection with the label\'s dose escalation, as an adjunct to a reduced-calorie diet and increased physical activity, for adults who pass the eligibility decision (BMI >= 30, or BMI >= 27 with a weight-related comorbidity). Modelled from the Wegovy US Prescribing Information (revised 02/2026), §1 Indications and Usage and §2.2 Recommended Dosage (Table 1). Its achieve goal (5-10 percent body-weight reduction) is checked by Monitor_Body_Weight, and enactment by Monitor_GLP1_Adherence.' ;
     metaprops :: 'goal.noun_phrase=body-weight reduction of 5-10 percent within 6-12 months
goal.verb=achieve
ontology.coding=SNOMED\\:764283003
ontology.label=Semaglutide (substance)
quote.1=Highlights, Dosage and Administration (2.2)\\: "Initiate at 0.25 mg once weekly for 4 weeks. Then follow the dosage escalation schedule in Table 1, titrating every 4 weeks ..."
quote.2=\\u00A71\\: "WEGOVY injection is indicated in combination with a reduced calorie diet and increased physical activity ... To reduce excess body weight and maintain weight reduction"
source.1=Wegovy (semaglutide) US Prescribing Information (revised 02/2026), \\u00A72.2 Recommended Dosage for WEGOVY Injection (Table 1)
source.2=Wegovy (semaglutide) US Prescribing Information (revised 02/2026), \\u00A71 Indications and Usage
' ;
     procedure :: 'Semaglutide (Wegovy) injection 0.25 mg subcutaneously once weekly for weeks 1-4, then escalate every 4 weeks: 0.5 mg (weeks 5-8), 1 mg (weeks 9-12), 1.7 mg (weeks 13-16), and from week 17 a maintenance dosage of 2.4 mg once weekly (recommended) or 1.7 mg once weekly. Inject on the same day each week in the abdomen, thigh or upper arm. If a dose is not tolerated during escalation, consider delaying escalation for 4 weeks. Give in combination with a reduced-calorie diet and increased physical activity.' ;
end action.

action  :: 'Prescribe_Lifestyle' ;
     caption :: 'Prescribe reduced-calorie diet and increased physical activity' ;
     description :: 'Prescribes a reduced-calorie diet, increased physical activity and behavior modification, the foundation of obesity care to which pharmacotherapy is an adjunct (Endocrine Society Pharmacological Management of Obesity CPG, Apovian CM et al., J Clin Endocrinol Metab 2015;100:342) and the regimen the Wegovy label (revised 02/2026, §2.1) requires semaglutide to be combined with. Its achieve goal (reduced cardiometabolic risk) is checked by Monitor_Cardiometabolic, and enactment by Monitor_Lifestyle_Adherence.' ;
     metaprops :: 'goal.noun_phrase=reduced cardiometabolic risk (improved HbA1c, lipids, blood pressure)
goal.verb=achieve
ontology.coding=SNOMED\\:388976009
ontology.label=Weight reduction regimen (regime/therapy)
quote.1=Summary\\: "Diet, exercise and behavior modification is the foundation of any weight management plan"
quote.2=Treat Weight First, Overweight/Obesity table\\: "150 minutes of moderate-intensity aerobic activity/wk"
quote.3=\\u00A72.1\\: "Administer WEGOVY in combination with a reduced-calorie diet and increased physical activity."
source.1=Endocrine Society Pharmacological Management of Obesity Clinical Practice Guideline (Apovian CM et al., J Clin Endocrinol Metab 2015;100\\:342), overview slides, slide Summary
source.2=Endocrine Society Pharmacological Management of Obesity Clinical Practice Guideline (Apovian CM et al., J Clin Endocrinol Metab 2015;100\\:342), overview slides, slide Treat Weight First, Overweight/Obesity exercise prescription
source.3=Wegovy (semaglutide) US Prescribing Information (revised 02/2026), \\u00A72.1 Important Monitoring and Administration Instructions
' ;
     procedure :: 'Prescribe an energy-deficient (reduced-calorie) diet the patient will adhere to, at least 150 minutes per week of moderate-intensity aerobic activity, and behavior modification, continued alongside semaglutide.' ;
end action.

action  :: 'Prescribe_Resistance_Exercise' ;
     caption :: 'Prescribe resistance training and adequate protein intake to preserve lean mass' ;
     description :: 'Prescribes resistance (muscle-strengthening) training and adequate protein intake to limit the lean-mass loss that accompanies weight reduction on obesity medication. Modelled from ADA 2026 Standards of Care in Overweight and Obesity Rec 2.20 (counsel on adequate protein intake and muscle-strengthening activities to minimize muscle loss) and the protein guidance on p.19, and from the Endocrine Society CPG exercise prescription (muscle-strengthening activities). Its avoid goal (lean-mass loss) is checked by Monitor_Body_Composition. SNOMED coded as strength-training promotion; the protein component is not separately coded.' ;
     metaprops :: 'goal.noun_phrase=muscle / lean-mass loss (sarcopenia) during rapid weight loss
goal.verb=avoid
ontology.coding=SNOMED\\:386291006
ontology.label=Exercise promotion\\: strength training (procedure)
quote.1=p.19, Rec 2.20\\: "Counsel individuals treated with obesity medications on the need for adequate protein intake A and muscle-strengthening activities A to minimize muscle loss"
quote.2=p.19\\: "A minimum of 60 g of protein daily should be recommended"
quote.3=Treat Weight First, Overweight/Obesity table\\: "muscle-strengthening activities on > 2 days/wk"
source.1=ADA 2026 Standards of Care in Overweight and Obesity, Pharmacologic Treatment of Obesity in Adults, Rec 2.20 (p.19) protein intake and muscle-strengthening activities with obesity medications
source.2=ADA 2026 Standards of Care in Overweight and Obesity, Pharmacologic Treatment of Obesity in Adults, p.19 nutritional counseling (daily protein intake)
source.3=Endocrine Society Pharmacological Management of Obesity Clinical Practice Guideline (Apovian CM et al., J Clin Endocrinol Metab 2015;100\\:342), overview slides, slide Treat Weight First, Overweight/Obesity exercise prescription
' ;
     procedure :: 'Muscle-strengthening (resistance) activities on more than 2 days per week, plus at least 60 g of protein daily (higher intake, 1.2-1.6 g/kg per day, is often advised during weight reduction; modify for chronic kidney disease or heart failure).' ;
end action.

plan  :: 'Obesity_Therapy' ;
     caption :: 'GLP-1 pharmacotherapy plus lifestyle and lean-mass-preserving therapy' ;
     precondition ::result_of(Eligibility_Decision) = Eligible;
     component :: 'Prescribe_GLP1' ;
          task_definition :: 'Prescribe_GLP1' ;
          ltwh :: 40,40,0,0;
     component :: 'Prescribe_Lifestyle' ;
          task_definition :: 'Prescribe_Lifestyle' ;
          ltwh :: 240,40,0,0;
     component :: 'Prescribe_Resistance_Exercise' ;
          task_definition :: 'Prescribe_Resistance_Exercise' ;
          ltwh :: 440,40,0,0;
end plan.


