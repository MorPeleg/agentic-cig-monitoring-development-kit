data  :: 'BMI' ;
     type :: real ;
     description :: 'Body mass index; primary eligibility threshold' ;
     metaprops :: 'owl.iri=Data_BMI
' ;
     unit :: 'kg/m2' ;
end data.

data  :: 'baseline_body_composition' ;
     type :: text ;
     description :: 'Baseline lean vs fat mass (BIA); reference for muscle-loss avoidance monitoring' ;
     metaprops :: 'owl.iri=Data_Baseline_Body_Composition
' ;
end data.

data  :: 'baseline_cardiometabolic_labs' ;
     type :: text ;
     description :: 'HbA1c, fasting glucose, lipid panel, and blood pressure; reference for cardiometabolic-risk desired-outcome monitoring' ;
     metaprops :: 'owl.iri=Data_Baseline_Cardiometabolic_Labs
' ;
end data.

data  :: 'baseline_weight' ;
     type :: text ;
     description :: 'Baseline body weight; reference for percent weight change desired-outcome monitoring' ;
     metaprops :: 'owl.iri=Data_Baseline_Weight
' ;
     unit :: 'kg' ;
end data.

data  :: 'contraindications' ;
     type :: text ;
     description :: 'Personal/family history of medullary thyroid carcinoma or MEN2, prior pancreatitis, pregnancy/planned pregnancy' ;
     metaprops :: 'owl.iri=Data_Contraindications
' ;
end data.

data  :: 'weight_related_comorbidity' ;
     type :: boolean ;
     description :: 'Presence of type 2 diabetes, hypertension, dyslipidemia, OSA, or NAFLD; lowers BMI threshold to 27' ;
     metaprops :: 'owl.iri=Data_Weight_Related_Comorbidity
' ;
end data.
