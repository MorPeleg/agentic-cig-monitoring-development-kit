engine_version :: '1.9' ;

metadata  :: 'Obesity_GLP1_Plan' ;
     title :: 'Obesity GLP-1 Therapy and Monitoring CIG (authoritative example)' ;
     desc :: 'Authoritative worked PROforma instantiation for the cig-monitoring skill. Demonstrates a populated Enquiry and Decision, State Achievement goals on therapy actions, and monitoring Actions that carry BOTH a ServiceRequest order on the Goal noun_phrase AND a full pf:metaprops string per references/MetapropsSyntax.md. Reuses PROforma classes/properties by IRI.' ;
end metadata.

metaprops :: 'goal.iri=Goal_treat_obesity
goal.noun_phrase=obesity in adults with BMI >\\= 30, or BMI >\\= 27 with a weight-related comorbidity
goal.verb=treat
owl.iri=Obesity_GLP1_Plan
owl.ontology=https\\://w3id.org/agentic-cig-monitoring/obesity-glp1-monitoring
' ;

plan  :: 'Obesity_GLP1_Plan' ;
     caption :: 'Manage obesity with GLP-1 therapy and monitor enactment, desired outcomes, and undesired effects' ;
     metaprops :: 'goal.iri=Goal_treat_obesity
goal.noun_phrase=obesity in adults with BMI >\\= 30, or BMI >\\= 27 with a weight-related comorbidity
goal.verb=treat
owl.iri=Obesity_GLP1_Plan
owl.ontology=https\\://w3id.org/agentic-cig-monitoring/obesity-glp1-monitoring
' ;
     component :: 'Get_Eligibility_Data' ;
          task_definition :: 'Get_Eligibility_Data' ;
          ltwh :: 40,40,0,0;
     component :: 'Eligibility_Decision' ;
          task_definition :: 'Eligibility_Decision' ;
          schedule_constraint :: completed('Get_Eligibility_Data') ;
          ltwh :: 40,140,0,0;
     component :: 'Monitoring_Plan' ;
          task_definition :: 'Monitoring_Plan' ;
          schedule_constraint :: completed('Obesity_Therapy') ;
          ltwh :: 40,340,0,0;
     component :: 'Obesity_Therapy' ;
          task_definition :: 'Obesity_Therapy' ;
          schedule_constraint :: completed('Eligibility_Decision') ;
          ltwh :: 40,240,0,0;
end plan.

enquiry  :: 'Get_Eligibility_Data' ;
     caption :: 'Retrieve baseline data needed to judge GLP-1 eligibility and to set monitoring baselines' ;
     description :: 'Eligibility and baseline data items: BMI; weight-related comorbidity (type 2 diabetes, hypertension, dyslipidemia, OSA, NAFLD); contraindications (personal/family history of medullary thyroid carcinoma or MEN2, prior pancreatitis, pregnancy/planned pregnancy); current medications; renal function (eGFR); thyroid history; mood/psychiatric history including prior depression or suicidality; baseline weight; baseline body composition (lean vs fat mass); baseline cardiometabolic labs (HbA1c, fasting glucose, lipid panel, blood pressure); baseline quality of life. Six are wired below as Source->Data; the rest are enumerated here.' ;
     metaprops :: 'owl.iri=Get_Eligibility_Data
' ;
     source :: 'baseline_body_composition' ;
          data_definition :: 'baseline_body_composition' ;
     source :: 'baseline_cardiometabolic_labs' ;
          data_definition :: 'baseline_cardiometabolic_labs' ;
     source :: 'baseline_weight' ;
          data_definition :: 'baseline_weight' ;
     source :: 'BMI' ;
          data_definition :: 'BMI' ;
     source :: 'contraindications' ;
          data_definition :: 'contraindications' ;
     source :: 'weight_related_comorbidity' ;
          data_definition :: 'weight_related_comorbidity' ;
end enquiry.

decision  :: 'Eligibility_Decision' ;
     caption :: 'Decide whether the patient is eligible for GLP-1 obesity therapy' ;
     metaprops :: 'owl.iri=Eligibility_Decision
' ;
     candidate :: 'Eligible' ;
          metaprops :: 'owl.iri=Eligible
owl.recommendation=start GLP-1 obesity therapy plan and enroll in monitoring
' ;
          argument :: for,(BMI >= 30 or (BMI >= 27 and weight_related_comorbidity = true)) and contraindications = none attributes
               argument_name :: 'Arg_Eligible' ;
               metaprops :: 'owl.iri=Arg_Eligible
' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'Not_Eligible' ;
          metaprops :: 'owl.iri=Not_Eligible
owl.recommendation=do not start GLP-1 therapy; consider alternatives and re-evaluate
' ;
          argument :: against,BMI < 27 or (BMI < 30 and weight_related_comorbidity = false) or contraindications <> none attributes
               argument_name :: 'Arg_Not_Eligible' ;
               metaprops :: 'owl.iri=Arg_Not_Eligible
' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
end decision.

