data  :: 'contraindications' ;
     type :: text ;
     description :: 'Personal/family history of medullary thyroid carcinoma or MEN2, prior pancreatitis, pregnancy/planned pregnancy' ;
     metaprops :: 'quote=\\u00A74\\: "A personal or family history of MTC or in patients with MEN 2"
source=Wegovy (semaglutide) US Prescribing Information (revised 02/2026), \\u00A74 Contraindications
' ;
end data.

data  :: 'on_insulin_or_secretagogue' ;
     type :: boolean ;
     description :: 'Concomitant insulin or insulin secretagogue (sulfonylurea, meglitinide) therapy; scopes hypoglycemia monitoring per the semaglutide label (Warnings and Precautions 5.4). SNOMED coded as long-term current use of insulin, the closest single concept (narrower: it does not cover insulin secretagogues).' ;
     metaprops :: 'ontology.coding=SNOMED\\:710815001
ontology.label=Long-term current use of insulin (situation)
quote=\\u00A77.1\\: "The risk of hypoglycemia is increased when WEGOVY is used concomitantly with insulin or insulin secretagogues (e.g., sulfonylureas)."
source=Wegovy (semaglutide) US Prescribing Information (revised 02/2026), Drug Interactions (7.1) Concomitant Use with Insulin or an Insulin Secretagogue
' ;
end data.

data  :: 'weight_related_comorbidity' ;
     type :: boolean ;
     description :: 'Presence of type 2 diabetes, hypertension, dyslipidemia, OSA, or NAFLD; lowers BMI threshold to 27' ;
     metaprops :: 'quote=Criteria for Using Approved Medications\\: "BMI of >27 kg/m2 with \\u22651 comorbidity"
source=Endocrine Society Pharmacological Management of Obesity Clinical Practice Guideline (Apovian CM et al., J Clin Endocrinol Metab 2015;100\\:342), overview slides, slide Criteria for Using Approved Medications
' ;
end data.
