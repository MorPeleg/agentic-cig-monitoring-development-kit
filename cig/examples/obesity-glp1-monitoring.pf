engine_version :: '1.9' ;

metadata  :: 'Obesity_GLP1_Plan' ;
     title :: 'Obesity GLP-1 Therapy and Monitoring CIG (authoritative example)' ;
     desc :: 'Worked PROforma CIG for the cig-monitoring skill: a populated eligibility Enquiry and Decision, a therapy plan whose actions carry State Achievement goals with a native description, procedure and quoted sources, and a monitoring plan whose actions carry an Action Enactment goal with the order in order.*, goal.noun_phrase and the native procedure, verbatim source quotes and SNOMED CT Ontology coding (skills/cig-monitoring/references/MetapropsSyntax.md).' ;
end metadata.

metaprops :: 'goal.noun_phrase=obesity in adults with BMI >\\= 30, or BMI >\\= 27 with a weight-related comorbidity
goal.verb=treat
' ;

plan  :: 'Obesity_GLP1_Plan' ;
     caption :: 'Manage obesity with GLP-1 therapy and monitor enactment, desired outcomes, and undesired effects' ;
     metaprops :: 'goal.noun_phrase=obesity in adults with BMI >\\= 30, or BMI >\\= 27 with a weight-related comorbidity
goal.verb=treat
' ;
     component :: 'Get_Eligibility_Data' ;
          task_definition :: 'Get_Eligibility_Data' ;
          ltwh :: 40,40,0,0;
     component :: 'Eligibility_Decision' ;
          task_definition :: 'Eligibility_Decision' ;
          schedule_constraint :: completed('Get_Eligibility_Data') ;
          ltwh :: 40,140,0,0;
     component :: 'Monitoring_Plan' ;
          task_definition :: 'Monitoring_Plan' ;
          schedule_constraint :: completed('Obesity_Therapy') ;
          ltwh :: 40,340,0,0;
     component :: 'Obesity_Therapy' ;
          task_definition :: 'Obesity_Therapy' ;
          schedule_constraint :: completed('Eligibility_Decision') ;
          ltwh :: 40,240,0,0;
end plan.

enquiry  :: 'Get_Eligibility_Data' ;
     caption :: 'Retrieve baseline data needed to judge GLP-1 eligibility and to set monitoring baselines' ;
     description :: 'Eligibility and baseline data items: BMI; weight-related comorbidity (type 2 diabetes, hypertension, dyslipidemia, OSA, NAFLD); contraindications (personal/family history of medullary thyroid carcinoma or MEN2, prior pancreatitis, pregnancy/planned pregnancy); current medications; renal function (eGFR); thyroid history; mood/psychiatric history including prior depression or suicidality; baseline weight; baseline body composition (lean vs fat mass); baseline cardiometabolic labs (HbA1c, fasting glucose, lipid panel, blood pressure); baseline quality of life. The items the conditions use are asked as sources; the others are listed here for the clinician.' ;
     source :: 'baseline_body_composition' ;
          data_definition :: 'baseline_body_composition' ;
     source :: 'baseline_cardiometabolic_labs' ;
          data_definition :: 'baseline_cardiometabolic_labs' ;
     source :: 'baseline_weight' ;
          data_definition :: 'baseline_weight' ;
     source :: 'BMI' ;
          data_definition :: 'BMI' ;
     source :: 'contraindications' ;
          data_definition :: 'contraindications' ;
     source :: 'on_insulin_or_secretagogue' ;
          data_definition :: 'on_insulin_or_secretagogue' ;
     source :: 'weight_related_comorbidity' ;
          data_definition :: 'weight_related_comorbidity' ;
end enquiry.

decision  :: 'Eligibility_Decision' ;
     caption :: 'Decide whether the patient is eligible for GLP-1 obesity therapy' ;
     candidate :: 'Eligible' ;
          description :: 'start GLP-1 obesity therapy plan and enroll in monitoring' ;
          argument :: for,(BMI >= 30 or (BMI >= 27 and weight_related_comorbidity = true)) and contraindications = none attributes
               argument_name :: 'Arg_Eligible' ;
               metaprops :: 'quote.1=Criteria for Using Approved Medications\\: "BMI of >27 kg/m2 with \\u22651 comorbidity ... BMI of >30 kg/m2 with no comorbidities"
quote.2=\\u00A74\\: "A personal or family history of MTC or in patients with MEN 2"
source.1=Endocrine Society Pharmacological Management of Obesity Clinical Practice Guideline (Apovian CM et al., J Clin Endocrinol Metab 2015;100\\:342), overview slides, slide Criteria for Using Approved Medications
source.2=Wegovy (semaglutide) US Prescribing Information (revised 02/2026), \\u00A74 Contraindications
' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
     candidate :: 'Not_Eligible' ;
          description :: 'do not start GLP-1 therapy; consider alternatives and re-evaluate' ;
          argument :: for,BMI < 27 or (BMI < 30 and weight_related_comorbidity = false) or contraindications <> none attributes
               argument_name :: 'Arg_Not_Eligible' ;
               metaprops :: 'quote.1=Criteria for Using Approved Medications\\: "BMI of >27 kg/m2 with \\u22651 comorbidity ... BMI of >30 kg/m2 with no comorbidities"
quote.2=\\u00A74\\: "A personal or family history of MTC or in patients with MEN 2"
source.1=Endocrine Society Pharmacological Management of Obesity Clinical Practice Guideline (Apovian CM et al., J Clin Endocrinol Metab 2015;100\\:342), overview slides, slide Criteria for Using Approved Medications
source.2=Wegovy (semaglutide) US Prescribing Information (revised 02/2026), \\u00A74 Contraindications
' ;
          end attributes
          ;
          recommendation ::netsupport() > 0;
end decision.

