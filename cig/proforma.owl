    <rdfs:range rdf:resource="#PROforma_Condition"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:ID="sref">
    <rdfs:domain rdf:resource="#Source"/>
    <rdfs:range rdf:resource="#Data"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:ID="recommendation">
